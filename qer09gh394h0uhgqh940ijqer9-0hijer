                Size = UDim2.new(0, 0, 1, 0),
                ZIndex = 7,
                Parent = S2Inner,
            })

            Library:AddToRegistry(S2Fill, {
                BackgroundColor3 = 'AccentColor',
                BorderColor3 = 'AccentColorDark',
            })
            Library:StyleSlider(S2Outer, S2Inner, S2Fill)

            local S2Hide = Library:Create('Frame', {
                BackgroundColor3 = Library.AccentColor,
                BackgroundTransparency = 1,
                BorderSizePixel = 0,
                Position = UDim2.new(1, 0, 0, 0),
                Size = UDim2.new(0, 1, 1, 0),
                ZIndex = 8,
                Parent = S2Fill,
            })

            Library:AddToRegistry(S2Hide, {
                BackgroundColor3 = 'AccentColor',
            })

            local S2Label = Library:CreateLabel({
                Size = UDim2.new(1, 0, 1, 0),
                TextSize = 14,
                Text = 'infinite',
                ZIndex = 9,
                Parent = S2Inner,
            })

            Library:OnHighlight(S2Outer, S2Outer, { BorderColor3 = 'AccentColor' }, { BorderColor3 = 'Black' })

            if type(Info.Tooltip) == 'string' then
                Library:AddToolTip(Info.Tooltip, S2Outer)
            end

            function Slider2:UpdateColors()
                S2Fill.BackgroundColor3 = Library.AccentColor
                S2Fill.BorderColor3 = Library.AccentColorDark
            end

            function Slider2:Display()
                local Suffix = Info.Suffix or ''

                if Info.Compact then
                    S2Label.Text = Info.Text .. ': ' .. Slider2.Value .. Suffix
                elseif Info.HideMax then
                    S2Label.Text = string.format('%s', Slider2.Value .. Suffix)
                else
                    S2Label.Text = string.format('%s/%s', Slider2.Value .. Suffix, Slider2.Max .. Suffix)
                end

                local Ratio = math.clamp(Library:MapValue(Slider2.Value, Slider2.Min, Slider2.Max, 0, 1), 0, 1)
                S2Fill.Size = UDim2.fromScale(Ratio, 1)

                S2Hide.Visible = Ratio > 0 and Ratio < 1
            end

            function Slider2:OnChanged(Func)
                Slider2.Changed = Func
                Func(Slider2.Value)
            end

            local function Round2(Value)
                if Slider2.Rounding == 0 then
                    return math.floor(Value)
                end

                return tonumber(string.format('%.' .. Slider2.Rounding .. 'f', Value))
            end

            function Slider2:GetValueFromXOffset(X)
                return Round2(Library:MapValue(X, 0, GetTrackWidth2(), Slider2.Min, Slider2.Max))
            end

            function Slider2:SetValue(Str)
                local Num = tonumber(Str)

                if not Num or Num ~= Num or math.abs(Num) == math.huge then
                    return
                end

                Num = math.clamp(Num, Slider2.Min, Slider2.Max)
                Num = math.clamp(
                    tonumber(string.format('%.' .. math.clamp(Slider2.Rounding or 0, 0, 10) .. 'f', Num)) or Num,
                    Slider2.Min,
                    Slider2.Max
                )

                Slider2.Value = Num
                Slider2:Display()

                Library:SafeCallback(Slider2.Callback, Slider2.Value)
                Library:SafeCallback(Slider2.Changed, Slider2.Value)
            end

            Slider2.Outer = S2Outer
            Library:BindSliderInput(Slider2, S2Inner)

            Slider2.Outer = S2Outer
            Slider2.Container = PairContainer
            Slider2.Groupbox = PairGroupbox

            Slider2:Display()
            PairGroupbox:AddBlank(4)
            PairGroupbox:Resize()

            Options[Idx] = Slider2
            Library:RegisterControl(Idx, Slider2, PairGroupbox, Info.Text, S2Outer)

            return Slider2
        end

        Slider:Display()
        Groupbox:AddBlank(Info.BlankSize or 2)
        Groupbox:Resize()

        Options[Idx] = Slider
        Library:RegisterControl(Idx, Slider, Groupbox, Info.Text, Slider.Label or Slider.Outer)

        return Slider
    end

