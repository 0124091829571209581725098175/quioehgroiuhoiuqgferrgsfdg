                local SelectionMarker = Library:CreateSelectionMarker(Button);

                local Selected;

                if Info.Multi then
                    Selected = Dropdown.Value[Value];
                else
                    Selected = Dropdown.Value == Value;
                end;

                local DangerousMap = Info.DangerousOptions or Info.DangerousMap or {}
                local IsDangerousOption = Info.Dangerous and true or DangerousMap[Value] == true
                if Info.DangerousValues and Info.DangerousValues[Value] then IsDangerousOption = true end
                function Table:UpdateButton()
                    if Info.Multi then
                        Selected = Dropdown.Value[Value];
                    else
                        Selected = Dropdown.Value == Value;
                    end;
                    SelectionMarker.Visible = not Library.ClassicEnabled and not not Selected;
                    Button.BackgroundColor3 = Selected and Library.BackgroundColor or Library.MainColor;
                    Library.RegistryMap[Button].Properties.BackgroundColor3 = Selected and 'BackgroundColor' or 'MainColor';
                    if IsDangerousOption then
                        ButtonLabel.TextColor3 = Library.RiskColor
                        Library.RegistryMap[ButtonLabel].Properties.TextColor3 = 'RiskColor'
                    else
                        ButtonLabel.TextColor3 = Selected and Library.AccentColor or Library.FontColor;
                        Library.RegistryMap[ButtonLabel].Properties.TextColor3 = Selected and 'AccentColor' or 'FontColor';
                    end
                end;

                Button.Activated:Connect(function()
                        local Try = not Selected;

                        if Dropdown:GetActiveValues() == 1 and (not Try) and (not Info.AllowNull) then
                        else
                            if Info.Multi then
                                Selected = Try;

                                if Selected then
                                    Dropdown.Value[Value] = true;
                                else
                                    Dropdown.Value[Value] = nil;
                                end;
                            else
                                Selected = Try;

                                if Selected then
                                    Dropdown.Value = Value;
                                else
                                    Dropdown.Value = nil;
