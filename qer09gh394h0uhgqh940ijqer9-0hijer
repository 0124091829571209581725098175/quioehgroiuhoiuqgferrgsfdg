                    UpdateRgbBtn()
                end

                if ColorPicker.GradientEnabled then
                    ColorPicker.GradientEnabled = false
                    StopGrad()
                    UpdateGradBtn()
                end

                local GetTouch, StopTouch = Library:TrackTouch(Input)

                while InputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) or GetTouch() ~= nil do
                    local Active = GetTouch()
                    local PY = Active and Active.Position.Y or Mouse.Y
                    local MinY = HueSelectorInner.AbsolutePosition.Y
                    local MaxY = MinY + HueSelectorInner.AbsoluteSize.Y
                    local MouseY = math.clamp(PY, MinY, MaxY)

                    ColorPicker.Hue = ((MouseY - MinY) / (MaxY - MinY))
                    ColorPicker:Display()

                    RenderStepped:Wait()
                end

                StopTouch()
                Library:AttemptSave(Idx, ColorPicker)
            end
        end)

        DisplayFrame.InputBegan:Connect(function(Input)
            if Library:IsClickInput(Input) and not Library:MouseIsOverOpenedFrame(DisplayFrame) then
                if PickerFrameOuter.Visible then
                    ColorPicker:Hide()
                else
                    ContextMenu:Hide()
                    ColorPicker:Show()
                end
            elseif
                Input.UserInputType == Enum.UserInputType.MouseButton2
                and not Library:MouseIsOverOpenedFrame(DisplayFrame)
            then
                ContextMenu:Show()
                ColorPicker:Hide()
            end
        end)

        if TransparencyBoxInner then
            TransparencyBoxInner.InputBegan:Connect(function(Input)
                if Library:IsClickInput(Input) then
                    if ColorPicker.RgbEnabled then
                        ColorPicker.RgbEnabled = false
                        StopRgb()
                        UpdateRgbBtn()
                    end

                    if ColorPicker.GradientEnabled then
                        ColorPicker.GradientEnabled = false
                        StopGrad()
                        UpdateGradBtn()
                    end

                    local GetTouch, StopTouch = Library:TrackTouch(Input)

                    while InputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) or GetTouch() ~= nil do
                        local Active = GetTouch()
                        local PX = Active and Active.Position.X or Mouse.X
                        local MinX = TransparencyBoxInner.AbsolutePosition.X
                        local MaxX = MinX + TransparencyBoxInner.AbsoluteSize.X
                        local MouseX = math.clamp(PX, MinX, MaxX)

                        ColorPicker.Transparency = 1 - ((MouseX - MinX) / (MaxX - MinX))

                        ColorPicker:Display()

                        RenderStepped:Wait()
                    end

                    StopTouch()
                    Library:AttemptSave(Idx, ColorPicker)
                end
            end)
        end

        Library:GiveSignal(InputService.InputBegan:Connect(function(Input)
            if PickerFrameOuter.Visible and Library:IsClickInput(Input) then
                local AbsPos, AbsSize = PickerFrameOuter.AbsolutePosition, PickerFrameOuter.AbsoluteSize
                local P = Input.Position

                if
                    P.X < AbsPos.X
                    or P.X > AbsPos.X + AbsSize.X
                    or P.Y < (AbsPos.Y - 20 - 1)
                    or P.Y > AbsPos.Y + AbsSize.Y
                then
                    ColorPicker:Hide()
                end
            end

            if
                ContextMenu.Container.Visible
                and (Library:IsClickInput(Input) or Input.UserInputType == Enum.UserInputType.MouseButton2)
            then
                if
                    not Library:IsMouseOverFrame(ContextMenu.Container) and not Library:IsMouseOverFrame(DisplayFrame)
                then
                    ContextMenu:Hide()
                end
            end
        end))

        ColorPicker:Display()
        ColorPicker.DisplayFrame = DisplayFrame

        Options[Idx] = ColorPicker
        Library:RegisterControl(Idx, ColorPicker, self, Info.Text, self.TextLabel)

        return self
    end

    function Funcs:AddKeyPicker(Idx, Info)
        local ParentObj = self
        local ToggleLabel = self.TextLabel
        local _Container = self.Container

        assert(Info.Default, 'AddKeyPicker: Missing default value.')

        local KeyPicker: { [string]: any } = {
            Value = Info.Default,
            Toggled = false,
            Mode = Info.Mode or 'Toggle', -- Always, Toggle, Hold
            Type = 'KeyPicker',
            Callback = Info.Callback or function(Value) end,
            ChangedCallback = Info.ChangedCallback or function(New) end,

            SyncToggleState = Info.SyncToggleState or false,
            AllowWhileTyping = Info.AllowWhileTyping or false,
        }

        if KeyPicker.SyncToggleState then
            Info.Modes = { 'Toggle' }
            Info.Mode = 'Toggle'
        end

        local PickOuter = Library:Create('Frame', {
            BackgroundColor3 = Color3.new(0, 0, 0),
            BorderColor3 = Color3.new(0, 0, 0),
            Size = UDim2.new(0, 28, 0, 15),
            ZIndex = 6,
            Parent = ToggleLabel,
        })

        local PickInner = Library:Create('Frame', {
            BackgroundColor3 = Library.BackgroundColor,
            BorderColor3 = Library.OutlineColor,
            BorderMode = Enum.BorderMode.Inset,
            Size = UDim2.new(1, 0, 1, 0),
            ZIndex = 7,
            Parent = PickOuter,
        })
        Library:StyleControl(PickOuter, PickInner, 4)

        Library:AddToRegistry(PickInner, {
            BackgroundColor3 = 'BackgroundColor',
            BorderColor3 = 'OutlineColor',
        })

        local DisplayLabel = Library:CreateLabel({
            Size = UDim2.new(1, 0, 1, 0),
            TextSize = 13,
            Text = Info.Default,
            TextWrapped = true,
            ZIndex = 8,
            Parent = PickInner,
        })

        local ModeSelectOuter = Library:Create('Frame', {
            BorderColor3 = Color3.new(0, 0, 0),
            Position = UDim2.fromOffset(
                ToggleLabel.AbsolutePosition.X + ToggleLabel.AbsoluteSize.X + 4,
                ToggleLabel.AbsolutePosition.Y + 1
            ),
            Size = UDim2.new(0, 60, 0, 45 + 2),
            Visible = false,
            ZIndex = 14,
            PopupAnchor = PickOuter,
            Parent = ScreenGui,
        })

        Library:BindPopupPosition(ToggleLabel, ModeSelectOuter, function()
            ModeSelectOuter.Position = UDim2.fromOffset(
                ToggleLabel.AbsolutePosition.X + ToggleLabel.AbsoluteSize.X + 4,
                ToggleLabel.AbsolutePosition.Y + 1
            )
        end)

        local ModeSelectInner = Library:Create('Frame', {
            BackgroundColor3 = Library.BackgroundColor,
            BorderColor3 = Library.OutlineColor,
            BorderMode = Enum.BorderMode.Inset,
            Size = UDim2.new(1, 0, 1, 0),
            ZIndex = 15,
            Parent = ModeSelectOuter,
        })
        Library:StyleControl(ModeSelectOuter, ModeSelectInner, 4)

        Library:AddToRegistry(ModeSelectInner, {
            BackgroundColor3 = 'BackgroundColor',
            BorderColor3 = 'OutlineColor',
        })

        Library:Create('UIListLayout', {
            FillDirection = Enum.FillDirection.Vertical,
            SortOrder = Enum.SortOrder.LayoutOrder,
            Parent = ModeSelectInner,
        })

        local KeyRow = Library:Create('Frame', {
            BackgroundTransparency = 1,
            BorderSizePixel = 0,
            Size = UDim2.new(1, 0, 0, 18),
            Visible = false,
            ZIndex = 110,
            Parent = Library.KeybindContainer,
        })
        local KeyName = Library:CreateLabel({
            Name = 'Name',
            BackgroundTransparency = 1,
            BorderSizePixel = 0,
            Position = UDim2.new(0, 0, 0, 0),
            Size = UDim2.new(1, 0, 1, 0),
            TextColor3 = Color3.fromRGB(255, 255, 255),
            TextSize = 12,
            TextXAlignment = Enum.TextXAlignment.Left,
            TextTruncate = Enum.TextTruncate.AtEnd,
            ZIndex = 111,
            Parent = KeyRow,
        }, true)
        Library:RemoveFromRegistry(KeyName)
        KeyName.Font = Library.Font
        if Library.UIFontName == 'JetBrains Mono Nerd' and Library.NerdFontFace then
            pcall(function()
                KeyName.FontFace = Library.NerdFontFace
            end)
        end
        KeyName.TextColor3 = Color3.fromRGB(225, 225, 230)
        KeyPicker.Row = KeyRow
        KeyPicker.NameLabel = KeyName

        local Modes = Info.Modes or { 'Always', 'Toggle', 'Hold' }
        local ModeButtons = {}

        for Idx, Mode in next, Modes do
            local ModeButton = {}

            local Label = Library:CreateLabel({
                Active = false,
                Size = UDim2.new(1, 0, 0, 15),
                TextSize = 13,
                Text = Mode,
                ZIndex = 16,
                Parent = ModeSelectInner,
            })

            function ModeButton:Select()
                for _, Button in next, ModeButtons do
                    Button:Deselect()
                end

                KeyPicker.Mode = Mode

                Label.TextColor3 = Library.AccentColor
                Library.RegistryMap[Label].Properties.TextColor3 = 'AccentColor'

                ModeSelectOuter.Visible = false
                if KeyPicker.Update then
                    KeyPicker:Update()
                end
            end

            function ModeButton:Deselect()
                KeyPicker.Mode = nil

                Label.TextColor3 = Library.FontColor
                Library.RegistryMap[Label].Properties.TextColor3 = 'FontColor'
            end

            Label.InputBegan:Connect(function(Input)
                if Library:IsClickInput(Input) then
                    Library:ConsumeInput(Input)
                    ModeButton:Select()
                    Library:AttemptSave(Idx, KeyPicker)
                end
            end)

            if Mode == KeyPicker.Mode then
                ModeButton:Select()
            end

            ModeButtons[Mode] = ModeButton
        end

        function KeyPicker:Update()
            if Info.NoUI then
                return
            end
            local State = KeyPicker:GetState()
            local RawName = tostring(Info.Text or 'bind')
            local Key = tostring(KeyPicker.Value or 'None')
            if
                KeyPicker.DisplayState == State
                and KeyPicker.DisplayMode == KeyPicker.Mode
                and KeyPicker.DisplayName == RawName
                and KeyPicker.DisplayKey == Key
                and KeyPicker.DisplayInactive == Library.KeybindShowInactive
            then
                return
            end
            KeyPicker.DisplayInactive = Library.KeybindShowInactive
            KeyPicker.DisplayState, KeyPicker.DisplayMode, KeyPicker.DisplayName, KeyPicker.DisplayKey =
                State, KeyPicker.Mode, RawName, Key
            KeyName.Text = '('
                .. KeyPicker.Mode
                .. ') '
                .. string.upper(RawName:sub(1, 1))
                .. RawName:sub(2)
                .. ' - '
                .. Key
            KeyRow.Visible = (State == true or Library.KeybindShowInactive == true) and Key ~= 'None' and Key ~= ''
            KeyName.TextTransparency = State and 0 or 0.5
            Library:QueueKeybindLayout()
        end

        function KeyPicker:GetState()
            if ParentObj and ParentObj.Type == 'Toggle' and not ParentObj.Value then
                return false
            end

            if KeyPicker.Mode == 'Always' then
                return true
            end

            if not KeyPicker.AllowWhileTyping and InputService:GetFocusedTextBox() then
                return false
            end

            if KeyPicker.Mode == 'Hold' then
                if KeyPicker.Value == 'None' then
                    return false
                end

                local Key = KeyPicker.Value

                if Key == 'MB1' or Key == 'MB2' then
                    return Key == 'MB1' and InputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1)
                        or Key == 'MB2' and InputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2)
                else
                    return InputService:IsKeyDown(Enum.KeyCode[KeyPicker.Value])
                end
            else
                return KeyPicker.Toggled
            end
        end

        function KeyPicker:SetValue(Data)
            if type(Data) ~= 'table' then
                return
            end
            local Key, Mode = Data[1], Data[2]
            if type(Key) ~= 'string' or Key == '' then
                Key = 'None'
            end
            DisplayLabel.Text = Key
            KeyPicker.Value = Key
            if Mode ~= nil and ModeButtons[Mode] ~= nil then
                ModeButtons[Mode]:Select()
            end
            KeyPicker:Update()
        end

        function KeyPicker:OnClick(Callback)
            KeyPicker.Clicked = Callback
        end

        function KeyPicker:OnChanged(Callback)
            KeyPicker.Changed = Callback
            Callback(KeyPicker.Value)
        end

        if ParentObj.Addons then
            table.insert(ParentObj.Addons, KeyPicker)
        end

        function KeyPicker:DoClick()
            if ParentObj.Type == 'Toggle' and KeyPicker.SyncToggleState then
                ParentObj:SetValue(not ParentObj.Value)
            end

            Library:SafeCallback(KeyPicker.Callback, KeyPicker.Toggled)
            Library:SafeCallback(KeyPicker.Clicked, KeyPicker.Toggled)
        end

        local Picking = false

        PickOuter.InputBegan:Connect(function(Input)
            if Library:IsClickInput(Input) and not Library:MouseIsOverOpenedFrame(PickOuter) then
                Picking = true

                DisplayLabel.Text = ''

                local Break
                local Text = ''

                task.spawn(function()
                    while not Break do
                        if Text == '...' then
                            Text = ''
                        end

                        Text = Text .. '.'
                        DisplayLabel.Text = Text

                        task.wait(0.4)
                    end
                end)

                task.wait(0.2)

                local Event
                Event = InputService.InputBegan:Connect(function(Input)
                    local Key

                    if Input.UserInputType == Enum.UserInputType.Keyboard then
                        Key = Input.KeyCode.Name
                    elseif Input.UserInputType == Enum.UserInputType.MouseButton1 then
                        Key = 'MB1'
                    elseif Input.UserInputType == Enum.UserInputType.MouseButton2 then
                        Key = 'MB2'
                    end

                    Break = true
                    Picking = false

                    DisplayLabel.Text = Key
                    KeyPicker.Value = Key

                    Library:SafeCallback(KeyPicker.ChangedCallback, Input.KeyCode or Input.UserInputType)
                    Library:SafeCallback(KeyPicker.Changed, Input.KeyCode or Input.UserInputType)

                    Library:AttemptSave(Idx, KeyPicker)

                    Event:Disconnect()
                end)
            elseif
                Input.UserInputType == Enum.UserInputType.MouseButton2 and not Library:MouseIsOverOpenedFrame(PickOuter)
            then
                Library:ClosePopups(Library:GetSettingsBox(PickOuter))
                ModeSelectOuter.Visible = true
            end
        end)

        Library:GiveSignal(InputService.InputBegan:Connect(function(Input, Processed)
            local BindInput = Input.UserInputType == Enum.UserInputType.Keyboard
                or Input.UserInputType == Enum.UserInputType.MouseButton1
                or Input.UserInputType == Enum.UserInputType.MouseButton2
            if not Picking and BindInput then
                local Typing = Processed or InputService:GetFocusedTextBox() ~= nil

                if (not Typing) or KeyPicker.AllowWhileTyping then
                    if KeyPicker.Mode == 'Toggle' then
                        local ParentOff = ParentObj
                            and ParentObj.Type == 'Toggle'
                            and not ParentObj.Value
                            and not KeyPicker.SyncToggleState
                        if not ParentOff then
                            local Key = KeyPicker.Value

                            if Key == 'MB1' or Key == 'MB2' then
                                if
                                    Key == 'MB1' and Input.UserInputType == Enum.UserInputType.MouseButton1
                                    or Key == 'MB2' and Input.UserInputType == Enum.UserInputType.MouseButton2
                                then
                                    KeyPicker.Toggled = not KeyPicker.Toggled
                                    KeyPicker:DoClick()
                                end
                            elseif Input.UserInputType == Enum.UserInputType.Keyboard then
                                if Input.KeyCode.Name == Key then
                                    KeyPicker.Toggled = not KeyPicker.Toggled
                                    KeyPicker:DoClick()
                                end
                            end
                        end
                    end
                end

                KeyPicker:Update()
            end

            if ModeSelectOuter.Visible and Library:IsClickInput(Input) then
                local AbsPos, AbsSize = ModeSelectOuter.AbsolutePosition, ModeSelectOuter.AbsoluteSize
                local P = Input.Position

                if
                    P.X < AbsPos.X
                    or P.X > AbsPos.X + AbsSize.X
                    or P.Y < (AbsPos.Y - 20 - 1)
                    or P.Y > AbsPos.Y + AbsSize.Y
                then
                    ModeSelectOuter.Visible = false
                end
            end
        end))

        Library:GiveSignal(InputService.InputEnded:Connect(function(Input)
            if
                not Picking
                and (
                    Input.UserInputType == Enum.UserInputType.Keyboard
                    or Input.UserInputType == Enum.UserInputType.MouseButton1
                    or Input.UserInputType == Enum.UserInputType.MouseButton2
                )
            then
                KeyPicker:Update()
            end
        end))

        KeyPicker:Update()

        Options[Idx] = KeyPicker
        Library:RegisterControl(Idx, KeyPicker, self, Info.Text, self.TextLabel)

        return self
    end

    function Funcs:AddButton(Idx, Info)
        local ParentObj = self
        local ToggleLabel = self.TextLabel

        local Text
        local Func
        local Tooltip

        if type(Idx) == 'table' then
            Text = Idx.Text
            Func = Idx.Func
            Tooltip = Idx.Tooltip
        elseif type(Idx) == 'string' and type(Info) == 'function' then
            Text = Idx
            Func = Info
        elseif type(Idx) == 'string' and type(Info) == 'table' then
            Text = Idx
            Func = Info.Func
            Tooltip = Info.Tooltip
        end

        assert(type(Text) == 'string', 'AddButton: Missing `Text` string.')
        Text = Text:lower()
        assert(type(Func) == 'function', 'AddButton: `Func` callback is missing.')

        local XSize = select(1, Library:GetTextBounds(Text, Library.Font, 13)) + 12

        if XSize < 28 then
            XSize = 28
        end

        local ButtonOuter = Library:Create('Frame', {
            BackgroundColor3 = Color3.new(0, 0, 0),
            BorderColor3 = Color3.new(0, 0, 0),
            Size = UDim2.new(0, XSize, 0, 15),
            ZIndex = 6,
            Parent = ToggleLabel,
        })

        local ButtonInner = Library:Create('Frame', {
            BackgroundColor3 = Library.MainColor,
            BorderColor3 = Library.OutlineColor,
            BorderMode = Enum.BorderMode.Inset,
            Size = UDim2.new(1, 0, 1, 0),
            ZIndex = 7,
            Parent = ButtonOuter,
        })
        Library:StyleControl(ButtonOuter, ButtonInner, 4)

        Library:AddToRegistry(ButtonInner, {
            BackgroundColor3 = 'MainColor',
            BorderColor3 = 'OutlineColor',
        })

        local ButtonLabel = Library:CreateLabel({
            Size = UDim2.new(1, 0, 1, 0),
            TextSize = 13,
            Text = Text,
            ZIndex = 8,
            Parent = ButtonInner,
        })

        Library:Create('UIGradient', {
            Color = ColorSequence.new({
                ColorSequenceKeypoint.new(0, Color3.new(1, 1, 1)),
                ColorSequenceKeypoint.new(1, Color3.fromRGB(212, 212, 212)),
            }),
            Rotation = 90,
            Parent = ButtonInner,
        })

        Library:OnHighlight(ButtonOuter, ButtonOuter, { BorderColor3 = 'AccentColor' }, { BorderColor3 = 'Black' })

        if type(Tooltip) == 'string' then
            Library:AddToolTip(Tooltip, ButtonOuter)
        end

        ButtonOuter.InputBegan:Connect(function(Input)
            if Library:IsClickInput(Input) and not Library:MouseIsOverOpenedFrame(ButtonOuter) then
                Library:SafeCallback(Func)
            end
        end)

        local Button: { [string]: any } = {
            Type = 'Button',
            Outer = ButtonOuter,
            Inner = ButtonInner,
            Label = ButtonLabel,
            Func = Func,
        }

        if ParentObj.Addons then
            table.insert(ParentObj.Addons, Button)
        end

        return ParentObj
    end

    function Funcs:AddSettings(info)
        return self.Owner:AddSettingsBox(self, info)
    end

    BaseAddons.__index = Funcs
end

