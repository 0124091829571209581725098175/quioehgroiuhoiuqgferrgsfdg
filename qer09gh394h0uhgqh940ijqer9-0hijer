        end
        function tab:AddGroupbox(info)
            local item = group(info.Name, info.Side == 2 and right or left)
            self.Groupboxes[info.Name] = item
            local lower = tostring(self.Name):lower()
            if (lower == 'ui settings' or lower == 'ui' or lower == 'settings') and not self.ClassicDefaults then
                self.ClassicDefaults = true
                item:AddDropdown('NotificationStyle', {
                    Text = 'notification style',
                    Values = { 'Default', 'Gamesense', 'Simple', 'Gamesensical', 'Progress' },
                    Default = Library.NotificationStyle or 'Default',
                    Callback = function(value)
                        Library:SetNotificationStyle(value)
                    end,
                })
                item:AddDropdown('NotificationPosition', {
                    Text = 'notification position',
                    Values = { 'Bottom', 'Top', 'Bottom Left', 'Bottom Right', 'Top Left', 'Top Right' },
                    Default = Library.NotificationPosition or 'Bottom',
                    Callback = function(value)
                        Library:SetNotificationPosition(value)
                    end,
                })
                item:AddSlider('UIScale', {
                    Text = 'ui scale',
                    Default = 100,
                    Min = 75,
                    Max = 150,
                    Rounding = 0,
                    Suffix = '%',
                    Callback = function(value)
                        Library:SetUIScale(value / 100)
                    end,
                })
                item:AddToggle('ReducedMotion', {
                    Text = 'reduced motion',
                    Default = false,
                    Callback = function(value)
                        Library:SetReducedMotion(value)
                    end,
                })
            end
            item:Resize()
            return item
        end
        function tab:AddLeftGroupbox(name)
            return self:AddGroupbox({ Name = name, Side = 1 })
        end
        function tab:AddRightGroupbox(name)
            return self:AddGroupbox({ Name = name, Side = 2 })
        end
        function tab:AddTabbox(info)
            local root = self
            local box: { [string]: any } = {
                Tabs = {},
                RootTab = root,
                TabSequence = 0,
                Flat = true,
                Pages = {},
                PageOrder = {},
                Groups = {},
            }
            box.Holder, box.Container = info.Side == 2 and right or left, info.Side == 2 and right or left
            function box:Resize()
                if self.Header then
                    for _, pageName in ipairs(self.PageOrder) do
                        local button = self.Pages[pageName].Button
                        local width = select(1, Library:GetTextBounds(pageName, Library.Font, Library.UIFontSize))
                        button.Size = UDim2.fromOffset(math.max(64, width + 20), 26)
                    end
                    updateCanvas(self.Header, self.HeaderLayout)
                end
                root:Resize()
            end
            function box:EnsurePage(name)
                local existing = self.Pages[name]
                if existing then
                    return existing
                end
                local entry: { [string]: any } = { Name = name, Groups = {} }
                self.Pages[name] = entry
                self.PageOrder[#self.PageOrder + 1] = name
                local width = select(1, Library:GetTextBounds(name, Library.Font, Library.UIFontSize))
                local selector = frame('TextButton', {
                    Parent = self.Header,
                    Text = name,
                    Font = Library.Font,
                    TextSize = Library.UIFontSize,
                    TextColor3 = Library.FontColor,
                    BackgroundColor3 = Library.MainColor,
                    BackgroundTransparency = 1,
                    BorderSizePixel = 0,
                    AutoButtonColor = false,
                    Size = UDim2.fromOffset(math.max(64, width + 20), 26),
                    LayoutOrder = #self.PageOrder,
                    ZIndex = 6,
                }, { TextColor3 = 'FontColor', BackgroundColor3 = 'MainColor' })
                entry.Button = selector
                selector.Activated:Connect(function()
                    self:Select(name)
                end)
                return entry
            end
            function box:SetTabbed(enabled, pages)
                assert(not next(self.Tabs), 'SetTabbed must be called before adding sections')
                self.Tabbed, self.Flat = enabled == true, enabled ~= true
                if not self.Tabbed then
                    return self
                end
                self.Header = frame('ScrollingFrame', {
                    Name = tostring(info.Name or 'sections') .. ' tabs',
                    Parent = self.Container,
                    Size = UDim2.new(1, 0, 0, 30),
                    BackgroundTransparency = 1,
                    BorderSizePixel = 0,
                    ScrollBarThickness = 2,
                    ScrollBarImageColor3 = Library.OutlineColor,
                    ScrollingDirection = Enum.ScrollingDirection.X,
                    CanvasSize = UDim2.fromOffset(0, 0),
                    LayoutOrder = -100,
                    Active = true,
                    ZIndex = 5,
                }, { ScrollBarImageColor3 = 'OutlineColor' })
                self.HeaderLayout = frame('UIListLayout', {
                    Parent = self.Header,
                    FillDirection = Enum.FillDirection.Horizontal,
                    SortOrder = Enum.SortOrder.LayoutOrder,
                    Padding = UDim.new(0, 4),
                })
                self.HeaderLayout:GetPropertyChangedSignal('AbsoluteContentSize'):Connect(function()
                    self:Resize()
                end)
                for _, name in ipairs(pages or {}) do
                    self:EnsurePage(name)
                end
                return self
            end
            function box:Select(selected)
                if not self.Tabbed then
                    self.ActiveTab = selected
                    if selected then
                        selected.Holder.Visible = true
                        selected:Resize()
                    end
                    return
                end
                local name = type(selected) == 'string' and selected or selected and selected.TabPage
                local entry = self.Pages[name]
                if not entry then
                    return
                end
                local changed = self.ActivePage ~= name
                if changed then
                    Library:ClosePopups()
                end
                self.ActivePage = name
                self.ActiveTab = entry.Groups[1]
                for _, pageName in ipairs(self.PageOrder) do
                    local pageEntry = self.Pages[pageName]
                    local visible = pageName == name
                    pageEntry.Button.BackgroundTransparency = visible and 0.1 or 1
                    pageEntry.Button.TextColor3 = visible and Library.AccentColor or Library.FontColor
                    Library.RegistryMap[pageEntry.Button].Properties.TextColor3 = visible and 'AccentColor'
                        or 'FontColor'
                    for _, item in ipairs(pageEntry.Groups) do
                        item.Holder.Visible = visible
                        item.SectionButton.Visible = visible
                    end
                end
                if changed then
                    Library:AnimateTabPage(root.TabFrame, entry.Button)
                end
                local scale = math.max(Library.UIScale or 1, 0.01)
                local x = (entry.Button.AbsolutePosition.X - self.Header.AbsolutePosition.X) / scale
                    + self.Header.CanvasPosition.X
                local width = entry.Button.AbsoluteSize.X / scale
                local visibleWidth = self.Header.AbsoluteSize.X / scale
                if x < self.Header.CanvasPosition.X then
                    self.Header.CanvasPosition = Vector2.new(math.max(0, x - 4), 0)
                elseif x + width > self.Header.CanvasPosition.X + visibleWidth then
                    self.Header.CanvasPosition = Vector2.new(math.max(0, x + width - visibleWidth + 4), 0)
                end
                self:Resize()
            end
            function box:AddPageGroup(pageName, name, side)
                assert(self.Tabbed, 'AddPageGroup requires selectable tabs')
                local entry = self:EnsurePage(pageName)
                local item = group(name or pageName, (side or info.Side) == 2 and right or left, self)
                item.TabPage = pageName
                entry.Groups[#entry.Groups + 1] = item
                self.Groups[#self.Groups + 1] = item
                root.Groupboxes[name or pageName] = item
                self:Select(self.ActivePage or pageName)
                item:Resize()
                return item
            end
            function box:AddTab(name, sectionName)
                self.TabSequence += 1
                local item
                if self.Tabbed then
                    item = self:AddPageGroup(name, sectionName or name)
                else
                    item = root:AddGroupbox({ Name = sectionName or name, Side = info.Side })
                    item.FlatSection = true
                end
                self.Tabs[name] = item
                self.ActiveTab = self.ActiveTab or item
                return item
            end
            root.Tabboxes[info.Name or ''] = box
            root.Boxes[#root.Boxes + 1] = box
            return box
        end
        function tab:AddLeftTabbox(name)
            return self:AddTabbox({ Name = name, Side = 1 })
        end
        function tab:AddRightTabbox(name)
            return self:AddTabbox({ Name = name, Side = 2 })
        end
        self.Tabs[name] = tab
        local lower = tostring(name):lower()
        if lower == 'ui settings' or lower == 'ui' then
            self.UITab = tab
        end
        if lower == 'protection' then
            self.ProtectionTab = tab
        end
        if not self.ActiveTab then
            tab:ShowTab()
        end
        if self.RefreshTabLayout then
            self.RefreshTabLayout()
        end
        return tab
    end

    function window:ConfigureItemWorkspace(tab, preview, skins, shop, loadout, avatar)
        local previous = loadout.RootTab
        loadout.Holder.Parent, loadout.RootTab, loadout.Scroll = tab.RightSide, tab, tab.RightScroll
        loadout.Holder:GetPropertyChangedSignal('Size'):Connect(function()
            tab:Resize()
        end)
        local pages = { skins = { preview, skins }, shop = { shop }, loadout = { loadout }, avatar = { avatar } }
        local all = { preview, skins, shop, loadout, avatar }
        local buttons = { skins = tab.TabButton }
        tab.TabButton.Text = 'skins'
        tab.TabButton.Name = 'skins'
        tab.ItemPage = 'skins'
        for index, entry in pairs(Library.ControlRegistry) do
            for name, groups in pairs(pages) do
                for _, group in ipairs(groups) do
                    if entry.Row and entry.Row:IsDescendantOf(group.Holder) then
                        entry.Tab, entry.ItemPage = tab, name
                        if name == 'avatar' then
                            entry.Category = 'visuals'
                        end
                        if entry.Group then
                            entry.Group.RootTab, entry.Group.Scroll = tab, group.Scroll
                        end
                    end
                end
            end
        end
        local originalShow = tab.ShowTab
        function tab:ShowTab()
            originalShow(self)
            window:SelectItemWorkspace('skins', true)
        end
        function window:SelectItemWorkspace(name, alreadyShown)
            if not pages[name] then
                return
            end
            tab.ItemPage = name
            if not alreadyShown then
                originalShow(tab)
            end
            for _, group in ipairs(all) do
                group.Holder.Visible = table.find(pages[name], group) ~= nil
            end
            if buttons[name] and window.ActiveTab == tab then
                self:SelectNavigationPage(buttons[name])
            end
            tab:Resize()
        end
        for i, name in ipairs({ 'shop', 'loadout', 'avatar' }) do
            buttons[name] = makeNav(name, function()
                window:SelectItemWorkspace(name)
            end, 20 + i)
        end
        self:SelectItemWorkspace('skins', true)
        if previous then
            previous:Resize()
        end
    end

    local lastWidth, lastScale, lastSidebar, lastHeight, lastStacked
    local function fit()
        if Library.StartupIntro and Library.StartupIntro.Emitting then
            return
        end
        local screen = ScreenGui.AbsoluteSize
        if screen.X < 100 or screen.Y < 100 then
            return
        end
        local scale = math.max(window.ScaleObject.Scale, 0.01)
        local width = math.clamp(
            outer.Size.X.Offset,
            math.min(500, (screen.X - 16) / scale),
            math.max(100, (screen.X - 16) / scale)
        )
        local height = math.clamp(
            outer.Size.Y.Offset,
            math.min(420, (screen.Y - 16) / scale),
            math.max(100, (screen.Y - 16) / scale)
        )
        outer.Size = UDim2.fromOffset(width, height)
        local x = outer.Position.X.Scale * screen.X + outer.Position.X.Offset
        local y = outer.Position.Y.Scale * screen.Y + outer.Position.Y.Offset
        outer.Position = UDim2.fromOffset(
            math.clamp(x, 8, math.max(8, screen.X - width * scale - 8)),
            math.clamp(y, 8, math.max(8, screen.Y - height * scale - 8))
        )
        local showRail = width >= 900
            and window.ActiveTab ~= nil
            and tostring(window.ActiveTab.Name):lower() == 'items'
            and window.CustomPanel == nil
        rail.Visible, divider.Visible = showRail, showRail
        profileStatus.Visible = showRail
        local sidebar = width < 960 and 96 or 120
        rail.Size = UDim2.new(0, sidebar, 1, 0)
        divider.Position = UDim2.fromOffset(sidebar + 12, 0)
        local inset = showRail and sidebar + 24 or 0
        content.Position, content.Size = UDim2.fromOffset(inset, 4), UDim2.new(1, -inset, 1, -4)
        railTitle.Text = sidebar < 140 and 'WEAPONS' or 'PROFILES'
        local stackedFooter = false
        footer.Visible = false
        body.Position, body.Size = UDim2.fromOffset(12, 85), UDim2.new(1, -24, 1, -97)
        searchOuter.Visible, close.Visible, profileStatus.Visible = true, false, false
        searchOuter.Parent, searchOuter.Position, searchOuter.Size =
            outer, UDim2.new(1, -122, 0, 28), UDim2.fromOffset(110, 22)
        search.PlaceholderText, search.TextSize = 'Search...', Library.UIFontSize
        nav.Size = UDim2.new(1, -138, 0, 24)
        title.Position, title.Size = UDim2.new(0.30, 0, 0, 0), UDim2.new(0.40, 0, 1, 0)
        local navButtons = {}
        for _, child in ipairs(nav:GetChildren()) do
            if child:IsA('TextButton') then
                navButtons[#navButtons + 1] = child
            end
        end
        local tabWidth = math.max(48, (width - 138 - math.max(0, #navButtons - 1) * 2) / math.max(1, #navButtons))
        for _, object in ipairs(navButtons) do
            object.Size = UDim2.fromOffset(tabWidth, 24)
        end
        updateCanvas(nav, navLayout)
        weaponList.CanvasSize = UDim2.fromOffset(0, weaponLayout.AbsoluteContentSize.Y / scale + 4)
        if
            width ~= lastWidth
            or height ~= lastHeight
            or scale ~= lastScale
            or inset ~= lastSidebar
            or stackedFooter ~= lastStacked
        then
            lastWidth, lastScale, lastSidebar, lastHeight, lastStacked = width, scale, inset, height, stackedFooter
            for _, group in ipairs(Library.Groupboxes) do
                if group.RootTab and group.Resize then
                    group:Resize()
                end
            end
            for row, reflow in pairs(Library.WorkspaceRows or {}) do
                if row.Parent then
                    reflow()
                end
            end
            for _, tab in pairs(window.Tabs) do
                tab:Resize()
            end
        end
    end
    window.RefreshTabLayout = fit
    local resizeButton = frame('TextButton', {
        Name = 'ClassicResize',
        Parent = outer,
        Text = '',
        Font = Library.Font,
        TextSize = 16,
        TextColor3 = Library.FontColor,
        TextTransparency = 0.5,
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        Size = UDim2.fromOffset(20, 20),
        Position = UDim2.new(1, -20, 1, -20),
        AutoButtonColor = false,
        ZIndex = 20,
    }, { TextColor3 = 'FontColor' })
    for index = 1, 2 do
        frame('Frame', {
            Parent = resizeButton,
            Position = UDim2.fromOffset(6 + index * 3, 12),
            Size = UDim2.fromOffset(8 - index * 2, 1),
            Rotation = -45,
            BorderSizePixel = 0,
            BackgroundColor3 = Library.OutlineColor,
            ZIndex = 21,
        }, { BackgroundColor3 = 'OutlineColor' })
    end
    self:BindWindowMovement(window, header, resizeButton, fit)
    Library:GiveSignal(ScreenGui:GetPropertyChangedSignal('AbsoluteSize'):Connect(fit))
    window.ScaleObject:GetPropertyChangedSignal('Scale'):Connect(fit)
    local modal = frame('TextButton', {
        Parent = ScreenGui,
        BackgroundTransparency = 1,
        Text = '',
        Size = UDim2.fromOffset(0, 0),
        Modal = false,
        Visible = true,
    })
    local toggled, toggleRevision = false, 0
    function Library:Toggle(fromStartup)
        if self.Unloaded then
            return
        end
        self:HideTooltip()
        toggled, toggleRevision = not toggled, toggleRevision + 1
        local revision = toggleRevision
        if self.StartupIntro and self.StartupIntro.Finishing and not fromStartup then
            self:CancelStartupIntro()
        end
        if not toggled then
            self:StopSliderDrag(true)
        end
        self.MainVisible, modal.Modal = toggled, toggled
        window:StopMovement()
        self:ClosePopups()
        window.FooterSetActive(nil)
        self:RefreshCustomCursor()
        if toggled then
            if not window.CustomPanel and not window.ActiveTab and window.LastTab then
                window.LastTab:ShowTab()
            end
            fit()
            if not outer.Visible then
                outer.GroupTransparency = self.ReducedMotion and 0 or 1
            end
            outer.Visible = true
            self:RefreshVisiblePlayerDropdowns()
            self:AnimateControl(outer, { GroupTransparency = 0 })
        else
            self:AnimateControl(outer, { GroupTransparency = 1 })
            if self.ReducedMotion then
                outer.Visible = false
            else
                task.delay(0.18, function()
                    if revision == toggleRevision and not toggled and outer.Parent then
                        outer.Visible = false
                    end
                end)
            end
        end
        self:SetPlayerInspectorMenuVisible(toggled)
    end
    Library:GiveSignal(InputService.InputBegan:Connect(function(input, processed)
        if input.KeyCode == Enum.KeyCode.Escape and search:IsFocused() then
            search.Text = ''
            search:ReleaseFocus()
            results.Visible = false
            return
        end
        if processed or InputService:GetFocusedTextBox() then
            return
        end
        local key = Library.ToggleKeybind
        if type(key) == 'table' and key.Type == 'KeyPicker' then
            if input.UserInputType == Enum.UserInputType.Keyboard and input.KeyCode.Name == key.Value then
                Library:Toggle()
            end
        elseif input.KeyCode == Enum.KeyCode.RightControl or input.KeyCode == Enum.KeyCode.RightShift then
            Library:Toggle()
        end
    end))
    fit()
    self:BeginStartupIntro(window)
    if config.AutoShow and not self.Unloaded then
        self:Toggle(true)
    end
    return window
end

local PlayerChangePending = false
local function OnPlayerChange()
    if PlayerChangePending or Library.Unloaded then
        return
    end
    PlayerChangePending = true
    task.delay(0.1, function()
        PlayerChangePending = false
        if Library.Unloaded then
            return
        end
        local PlayerList = GetPlayersString()
        for control in pairs(Library.PlayerDropdowns or {}) do
            control:SetValues(PlayerList)
        end
        Library:RefreshVisiblePlayerDropdowns()
    end)
end

