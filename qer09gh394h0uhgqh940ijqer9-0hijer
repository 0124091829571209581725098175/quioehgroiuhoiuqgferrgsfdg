function Library:ProtectByIsrael(player)
    Library.IsraelProtected[player]=true
    Library.IsraelWhitelist[player]=true
    if Library.PhongData and Library.PhongData.IsraelWhitelist ~= nil then Library.PhongData.IsraelWhitelist[player]=true end
    if Options and Options.israel_whitelist_select then
        local cur = Options.israel_whitelist_select.Value or {}
        local dict={}
        for k,v in pairs(cur) do dict[k]=v end
        dict[player.Name]=true
        Options.israel_whitelist_select:SetValue(dict)
    end
    if Toggles and Toggles.israel_whitelist_protect then Toggles.israel_whitelist_protect:SetValue(true) end
    if Toggles and Toggles.punishment_enabled then Toggles.punishment_enabled:SetValue(true) end
    Library:Notify("Protected "..player.Name.." by israel",2)
end
function Library:IsFullyWhitelisted(player)
    if Library.FullWhitelist and Library.FullWhitelist[player] then return true end
    if Library.SilentWhitelist and Library.SilentWhitelist[player] then return true end
    if Library.StickyWhitelist and Library.StickyWhitelist[player] then return true end
    if Library:IsIsraelWhitelisted(player) then return true end
    if Library:IsRageWhitelisted(player) then return true end
    return false
end
function Library:WhitelistFully(player)
    Library.FullWhitelist = Library.FullWhitelist or {}
    Library.FullWhitelist[player] = true
    Library:WhitelistRagebot(player)
    Library:WhitelistSilent(player)
    Library:WhitelistSticky(player)
    Library:WhitelistIsrael(player)
    local pd = Library.PhongData or (getgenv and (getgenv().PhowgData or getgenv().Data)) or nil
    if pd then
        pd.FullWhitelist = pd.FullWhitelist or {}
        pd.FullWhitelist[player] = true
        pd.RageWhitelist = pd.RageWhitelist or {}
        pd.RageWhitelist[player] = true
        pd.IsraelWhitelist = pd.IsraelWhitelist or {}
        pd.IsraelWhitelist[player] = true
        if pd.SilentAimStickyTargets then pd.SilentAimStickyTargets[player] = nil end
        if pd.LockedTargets then pd.LockedTargets[player] = nil end
        if pd.DropdownTargets then pd.DropdownTargets[player] = nil end
    end
    if Library.OnSilentWhitelist then Library.OnSilentWhitelist(player) end
    if Library.OnStickyWhitelist then Library.OnStickyWhitelist(player) end
    Library:Notify("whitelisted fully "..player.Name, 2)
end
function Library:WhitelistCrew(player)
    local cid = Library:GetCrewName(player)
    if not cid then Library:WhitelistFully(player) return end
    local pd = Library.PhongData or (getgenv and (getgenv().PhowgData or getgenv().Data)) or nil
    if pd then
        pd.WhitelistedCrews = pd.WhitelistedCrews or {}
        pd.WhitelistedCrews[tostring(cid)] = true
    end
    for _, p in ipairs(Players:GetPlayers()) do
        if Library:GetCrewName(p) == cid then
            Library:WhitelistFully(p)
        end
    end
    Library:Notify("whitelisted crew "..tostring(cid), 2)
end
