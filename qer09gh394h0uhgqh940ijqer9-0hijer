function Library:IsPopupAncestor(frame, box)
    if typeof(box) == 'Instance' then
        return frame == box
    end
    while box do
        if box.Frame == frame then
            return true
        end
        box = box.ParentSettings
    end
    return false
end
function Library:ClosePopups(except)
    for frame in pairs(table.clone(self.OpenedFrames)) do
        if not self:IsPopupAncestor(frame, except) then
            local closer = self.PopupClosers and self.PopupClosers[frame]
            if closer then
                closer()
            elseif frame.Parent then
                frame.Visible = false
            end
            self.OpenedFrames[frame] = nil
        end
    end
end
table.insert(
    Library.Signals,
    InputService.InputBegan:Connect(function(input)
        if input.KeyCode == Enum.KeyCode.Escape then
            Library:ClosePopups()
            return
        end
        if not Library:IsClickInput(input, true) or not next(Library.OpenedFrames) then
            return
        end
        local point = input.Position
        for frame in pairs(Library.OpenedFrames) do
            local position, size = frame.AbsolutePosition, frame.AbsoluteSize
            if
                point.X >= position.X
                and point.X <= position.X + size.X
                and point.Y >= position.Y
                and point.Y <= position.Y + size.Y
            then
                return
            end
            local box = Library.SettingsBoxes[frame]
            if box then
                position, size = box.Button.AbsolutePosition, box.Button.AbsoluteSize
                if
                    point.X >= position.X
                    and point.X <= position.X + size.X
                    and point.Y >= position.Y
                    and point.Y <= position.Y + size.Y
                then
                    return
                end
            elseif Library.PopupAnchors[frame] then
                position, size = Library.PopupAnchors[frame].AbsolutePosition, Library.PopupAnchors[frame].AbsoluteSize
                if
                    point.X >= position.X
                    and point.X <= position.X + size.X
                    and point.Y >= position.Y
                    and point.Y <= position.Y + size.Y
                then
                    return
                end
            end
        end
        Library:ClosePopups()
    end)
)
Library.ControlRegistry = {}
function Library:RegisterControl(index, control, owner, label, row)
    self.ControlSequence = (self.ControlSequence or 0) + 1
    control.RegistrationSequence = self.ControlSequence
    local group = owner and (owner.ControlGroup or owner)
    control.ControlGroup = group
    local tab = group and group.RootTab
    local category = tab and tostring(tab.Name):lower() or 'other'
    if category == 'character' then
        category = 'movement'
    elseif category == 'world' then
        category = 'visuals'
    elseif category == 'ui settings' then
        category = 'interface'
    elseif category ~= 'visuals' and category ~= 'protection' then
        category = 'other'
    end
    local workspaceRow = self.FormatWorkspaceControl and self:FormatWorkspaceControl(control, owner, label, row)
    row = workspaceRow or row
    self.ControlRegistry[index] = {
        Index = index,
        Control = control,
        Label = tostring(label or index):lower(),
        Group = group,
        Tab = tab,
        Category = category,
        Row = row or control.TextLabel or control.Label or control.Container,
        Settings = self:GetSettingsBox(owner and owner.Container),
    }
    control.ControlIndex = index
    if self.SaveManager and self.SaveManager.ObserveControl then
        self.SaveManager:ObserveControl(index, control)
    end
end
function Library:JumpToControl(index)
    local entry = self.ControlRegistry[index]
    if not entry then
        return false
    end
    if entry.Tab and entry.Tab.ShowTab then
        entry.Tab:ShowTab()
    end
    if entry.ItemPage and self.WorkspaceWindow.SelectItemWorkspace then
        self.WorkspaceWindow:SelectItemWorkspace(entry.ItemPage)
    end
    if entry.Group and entry.Group.Show then
        entry.Group:Show()
    end
    local chain, settings = {}, entry.Settings
    while settings do
        chain[#chain + 1] = settings
        settings = settings.ParentSettings
    end
    for i = #chain, 1, -1 do
        chain[i]:Open()
    end
    local row = entry.Row
    if typeof(row) ~= 'Instance' or not row.Parent then
        return false
    end
    local ancestor, hidden = row.Parent, nil
    while ancestor do
        if self.DependencyHolders[ancestor] and not ancestor.Visible then
            hidden = self.DependencyHolders[ancestor]
        end
        ancestor = ancestor.Parent
    end
    if hidden then
        for _, dependency in ipairs(hidden.Dependencies) do
            local control, value = dependency[1], dependency[2]
            if control.Type == 'Toggle' and control.Value ~= value and control.TextLabel then
                row = control.TextLabel
                self:Notify('This setting is hidden by "' .. row.Text .. '".', 3)
                break
            end
        end
    end
    local parent = row.Parent
    while parent do
        if parent:IsA('ScrollingFrame') then
            parent.CanvasPosition = Vector2.new(
                parent.CanvasPosition.X,
                math.max(
                    0,
                    parent.CanvasPosition.Y
                        + (row.AbsolutePosition.Y - parent.AbsolutePosition.Y) / math.max(self.UIScale or 1, 0.01)
                        - 20
                )
            )
            break
        end
        parent = parent.Parent
    end
    local highlight = self:Create('Frame', {
        Name = 'SearchHighlight',
        Parent = row,
        Size = UDim2.fromScale(1, 1),
        BackgroundColor3 = self.AccentColor,
        BackgroundTransparency = 0.8,
        BorderSizePixel = 0,
        ZIndex = 20,
        Active = false,
    })
    task.delay(0.5, function()
        if not highlight.Parent then
            return
        end
        self:AnimateControl(highlight, { BackgroundTransparency = 1 })
        task.delay(0.2, function()
            if highlight.Parent then
                highlight:Destroy()
            end
        end)
    end)
    return true
end
