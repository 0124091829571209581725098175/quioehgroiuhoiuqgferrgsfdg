    field.BackgroundTransparency = 1
    field.Position, field.Size = UDim2.new(0.43, 0, 0, 6), UDim2.new(0.57, -4, 0, searchList and 64 or control.Type == 'Slider' and 40 or 32)
    control.WorkspaceStyled, control.WorkspaceRow = true, row
    for _, descendant in ipairs(field:GetDescendants()) do
        if descendant:IsA('UIGradient') then descendant:Destroy() end
    end
    if control.Type == 'Slider' then
        local inner = field:FindFirstChildWhichIsA('Frame')
        local display = inner and inner:FindFirstChildWhichIsA('TextLabel')
        if inner and display then
            inner.Position, inner.Size = UDim2.fromOffset(0, 28), UDim2.new(1, 0, 0, 5)
            display.Parent, display.Position, display.Size = field, UDim2.fromOffset(0, 0), UDim2.new(1, -76, 0, 20)
