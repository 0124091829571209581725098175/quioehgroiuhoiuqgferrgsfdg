            Font = self.Font,
            TextColor3 = self.FontColor,
            BackgroundTransparency = 1,
            BorderSizePixel = 0,
            ZIndex = 104,
        })
        entry.CloseButton.TextSize = 14
        entry.CloseButton.Activated:Connect(function()
            entry:Destroy()
        end)
    end
    outer.Destroying:Connect(function()
        entry.Closed = true
        if entry.Timer and entry.Timer ~= coroutine.running() then
            pcall(task.cancel, entry.Timer)
        end
        entry.Timer = nil
        Library.NotificationEntries[entry] = nil
