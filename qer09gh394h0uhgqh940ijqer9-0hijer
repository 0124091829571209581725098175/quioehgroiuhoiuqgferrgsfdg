function Library:SetUIFontSize(value)
    value = tonumber(value)
    if not value or value ~= value then
        return
    end
    self.UIFontSize = math.clamp(math.round(value), 10, 16)
    for object, baseSize in pairs(self.BaseTextSizes) do
        if object.Parent then
            pcall(function()
                object.TextSize = math.clamp(baseSize + self.UIFontSize - 12, 10, 32)
            end)
        end
    end
    table.clear(self.TextBoundsCache)
    self.TextBoundsCacheCount = 0
    for row, reflow in pairs(self.WorkspaceRows or {}) do
        if row.Parent then
            reflow()
        end
    end
    for _, box in ipairs(self.Groupboxes) do
        box:Resize()
    end
    if self.WorkspaceWindow and self.WorkspaceWindow.RefreshTabLayout then
        self.WorkspaceWindow.RefreshTabLayout()
    end
    if self.KeybindContainer then
        self:QueueKeybindLayout()
    end
    if self.RefreshNotifications then
        self:RefreshNotifications()
    end
end
function Library:SetReducedMotion(enabled)
    self.ReducedMotion = enabled == true
    if not self.ReducedMotion then
        return
    end
    self:FinishThemeTransition()
    for target, animation in pairs(self.ControlTweens) do
        animation:Cancel()
        local goals = self.ControlTweenGoals[target]
        if target.Parent and goals then
            for property, value in pairs(goals) do
                target[property] = value
            end
        end
        self.ControlTweens[target] = nil
        self.ControlTweenGoals[target] = nil
    end
    for _, box in ipairs(self.DependencyBoxes) do
        box:Update(true)
    end
    local startup = self.StartupIntro
    if startup then
        if startup.Emitting then
            self:CancelStartupIntro()
        else
            if startup.FillTween then
                startup.FillTween:Cancel()
                startup.FillTween = nil
            end
            startup.DisplayProgress = startup.Progress or 0
            startup.Fill.Size = UDim2.fromScale(startup.DisplayProgress, 1)
        end
    end
end
