Library.WorkspaceNotifications = {}
function Library:NotifyWorkspace(text, duration)
    if self.Unloaded then return end
    text = tostring(text)
    local existing = self.WorkspaceNotifications[text]
    if existing and existing.Frame.Parent then
        existing.Count = existing.Count + 1
        existing.Label.Text = text .. ' ×' .. existing.Count
        existing.Revision = existing.Revision + 1
        self:AnimateControl(existing.Frame, {GroupTransparency = 0})
    else
        local width = math.min(420, math.max(180, ScreenGui.AbsoluteSize.X / math.max(self.UIScale or 1, 0.01) - 24))
        local _, height = self:GetTextBounds(text, self.Font, 13, Vector2.new(width - 36, math.huge))
        local holder = self:Create('CanvasGroup', {Name = 'WorkspaceNotification', Parent = self.NotificationArea, BackgroundColor3 = self.MainColor, BorderColor3 = self.OutlineColor, BorderSizePixel = 0, Size = UDim2.fromOffset(width, math.max(44, height + 22)), GroupTransparency = self.ReducedMotion and 0 or 1, ZIndex = 100})
        self:AddToRegistry(holder, {BackgroundColor3 = 'MainColor', BorderColor3 = 'OutlineColor'}, true)
        self:StyleControl(holder, holder, 8)
        local message = self:CreateLabel({Parent = holder, Position = UDim2.fromOffset(14, 10), Size = UDim2.new(1, -28, 1, -20), Text = text, TextSize = 13, TextWrapped = true, TextTruncate = Enum.TextTruncate.AtEnd, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 102}, true)
        existing = {Frame = holder, Label = message, Count = 1, Revision = 1}
        self.WorkspaceNotifications[text] = existing
        self:AnimateControl(holder, {GroupTransparency = 0})
        holder.Destroying:Connect(function() if self.WorkspaceNotifications[text] == existing then self.WorkspaceNotifications[text] = nil end end)
        local count, oldest = 0, nil
        for _, child in ipairs(self.NotificationArea:GetChildren()) do
            if child:IsA('GuiObject') then count = count + 1; oldest = oldest or child end
        end
        if count > 5 and oldest and oldest ~= holder then oldest:Destroy() end
    end
    local revision = existing.Revision
    task.delay(math.max(0.2, tonumber(duration) or self.NotifyDuration or 5), function()
        if self.Unloaded or existing.Revision ~= revision or not existing.Frame.Parent then return end
        self:AnimateControl(existing.Frame, {GroupTransparency = 1})
        task.delay(self.ReducedMotion and 0 or 0.13, function()
            if existing.Revision == revision and existing.Frame.Parent then existing.Frame:Destroy() end
        end)
    end)
end

