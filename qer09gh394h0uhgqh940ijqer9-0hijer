function Library:EnsureChromaConnection()
    if Library.ChromaConn then return end
    Library.ChromaConn = RenderStepped:Connect(function()
        if Library.ReducedMotion then return end
        local t = tick()
        for picker,_ in next, Library.ChromaSet do
            if picker.RgbEnabled then
                local s = picker.ChromaSpeed or 1
                picker.Hue = (t * (0.1166667 * s)) % 1
                picker.Sat = 1
                picker.Vib = 1
                picker:Display()
            end
        end
    end)
    table.insert(Library.Signals, Library.ChromaConn)
end
function Library:SetChromaEnabled(picker, enabled)
    if enabled and not picker.RgbEnabled then
        picker.OriginalHue = picker.Hue
        picker.OriginalSat = picker.Sat
        picker.OriginalVib = picker.Vib
        picker.OriginalValue = picker.Value
        picker.OriginalTransparency = picker.Transparency
    end
    picker.RgbEnabled = enabled
    if enabled then
        Library.ChromaSet[picker] = true
        Library:EnsureChromaConnection()
    else
        Library.ChromaSet[picker] = nil
        if picker.OriginalHue ~= nil then
            picker.Hue = picker.OriginalHue
            picker.Sat = picker.OriginalSat
            picker.Vib = picker.OriginalVib
            picker.Transparency = picker.OriginalTransparency or 0
            picker:Display()
            picker.OriginalHue = nil
            picker.OriginalSat = nil
            picker.OriginalVib = nil
            picker.OriginalValue = nil
        end
    end
    if picker.UpdateChromaBtn then picker.UpdateChromaBtn() end
end
function Library:SetGroupChroma(groupbox, enabled)
    if not groupbox or not groupbox.ColorPickers then return end
    for _,p in ipairs(groupbox.ColorPickers) do
        Library:SetChromaEnabled(p, enabled)
    end
    if groupbox.ChromaBtn then
        groupbox.ChromaOn = enabled
        local inner = groupbox.ChromaBtnInner
        local label = groupbox.ChromaBtnLabel
        if enabled then
            inner.BackgroundColor3 = Library.AccentColor
            inner.BorderColor3 = Library.AccentColorDark
            Library.RegistryMap[inner].Properties.BackgroundColor3 = 'AccentColor'
            Library.RegistryMap[inner].Properties.BorderColor3 = 'AccentColorDark'
            label.TextColor3 = Color3.new(1,1,1)
            if Library.RegistryMap[label] then Library.RegistryMap[label].Properties.TextColor3 = Color3.new(1,1,1) end
        else
            inner.BackgroundColor3 = Library.MainColor
            inner.BorderColor3 = Library.OutlineColor
            Library.RegistryMap[inner].Properties.BackgroundColor3 = 'MainColor'
            Library.RegistryMap[inner].Properties.BorderColor3 = 'OutlineColor'
            label.TextColor3 = Library.FontColor
            if Library.RegistryMap[label] then Library.RegistryMap[label].Properties.TextColor3 = 'FontColor' end
        end
    end
end

local RainbowStep = 0
local Hue = 0

table.insert(Library.Signals, RenderStepped:Connect(function(Delta)
    RainbowStep = RainbowStep + Delta

    if RainbowStep >= (1 / 60) then
        RainbowStep = 0

        Hue = Hue + (1 / 400);

        if Hue > 1 then
            Hue = 0;
        end;

        Library.CurrentRainbowHue = Hue;
        Library.CurrentRainbowColor = Color3.fromHSV(Hue, 0.8, 1);
    end
end))

local function GetPlayersString()
    local PlayerList = Players:GetPlayers();

    for i = 1, #PlayerList do
        PlayerList[i] = PlayerList[i].Name;
    end;

    table.sort(PlayerList, function(str1, str2) return str1 < str2 end);

    return PlayerList;
end;

