function Library:StopSliderDrag(save)
    local drag = self.ActiveSliderDrag;
    self.ActiveSliderDrag = nil;
    if drag and save and drag.Changed then self:AttemptSave(drag.Control.ControlIndex, drag.Control) end;
end;
function Library:UpdateSliderDrag(input)
    local drag = self.ActiveSliderDrag;
    if not drag then return end;
    if self.Unloaded or not self.MainVisible or not drag.Track.Parent then self:StopSliderDrag(false); return end;
    if drag.Input.UserInputType == Enum.UserInputType.Touch and input ~= drag.Input then return end;
    local x = input.Position and input.Position.X or Mouse.X;
    local track = drag.Track;
    local width = math.max(1, track.AbsoluteSize.X);
    local value;
    if drag.Precision then
        value = drag.StartValue + (x - drag.StartX) / width * (drag.Control.Max - drag.Control.Min) * 0.1;
        value = tonumber(string.format('%.' .. math.clamp(drag.Control.Rounding or 0, 0, 10) .. 'f', value));
        value = math.clamp(value, drag.Control.Min, drag.Control.Max);
    else
        value = drag.Control:GetValueFromXOffset(math.clamp(x - track.AbsolutePosition.X, 0, width));
    end;
    if value ~= drag.Control.Value then
        drag.Changed = true;
        drag.Control:SetValue(value);
    end;
end;
function Library:BindSliderInput(control, track)
    control.Track = track;
    local hit = self:Create('TextButton', {Name = 'SliderHitArea'; Parent = track.Parent; BackgroundTransparency = 1; Text = ''; AutoButtonColor = false; Active = true; Position = UDim2.fromOffset(0, 0); Size = UDim2.new(track.Size.X.Scale, track.Size.X.Offset, 1, 0); ZIndex = 11;});
    control.HitArea = hit;
    track:GetPropertyChangedSignal('Size'):Connect(function() hit.Size = UDim2.new(track.Size.X.Scale, track.Size.X.Offset, 1, 0) end);
    hit.InputBegan:Connect(function(input)
        if not self:IsClickInput(input) or self.Unloaded or self:MouseIsOverOpenedFrame(hit) then return end;
        self:StopSliderDrag(true);
        local focused = InputService:GetFocusedTextBox();
        if focused then focused:ReleaseFocus() end;
        local precision = InputService:IsKeyDown(Enum.KeyCode.LeftShift) or InputService:IsKeyDown(Enum.KeyCode.RightShift);
        self.ActiveSliderDrag = {Control = control; Track = track; Input = input; StartX = input.Position and input.Position.X or Mouse.X; StartValue = control.Value; Precision = precision; Changed = false;};
        self:UpdateSliderDrag(input);
    end);
    if self.SliderInputBound then return end;
    self.SliderInputBound = true;
    self:GiveSignal(InputService.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then self:UpdateSliderDrag(input) end;
    end));
    self:GiveSignal(InputService.InputEnded:Connect(function(input)
        local drag = self.ActiveSliderDrag;
        if drag and (input == drag.Input or input.UserInputType == Enum.UserInputType.MouseButton1 and drag.Input.UserInputType == Enum.UserInputType.MouseButton1) then self:StopSliderDrag(true) end;
    end));
    self:GiveSignal(InputService.InputBegan:Connect(function(input)
        local slider = self.FocusedSlider;
        local entry = slider and slider.NumericEntry;
        if not entry or not entry:IsFocused() or self.Unloaded then return end;
        local key, direction = input.KeyCode, nil;
        if key == Enum.KeyCode.Up then direction = 1 elseif key == Enum.KeyCode.Down then direction = -1 end;
        if key == Enum.KeyCode.Escape then entry.Text = tostring(slider.Value); entry:ReleaseFocus(); return end;
        local value = tonumber(entry.Text) or slider.Value;
        if direction then
            local multiplier = InputService:IsKeyDown(Enum.KeyCode.LeftShift) or InputService:IsKeyDown(Enum.KeyCode.RightShift);
            value = value + direction * (slider.Step or 10 ^ -(slider.Rounding or 0)) * (multiplier and 10 or 1);
        elseif key == Enum.KeyCode.Home then value = slider.Min
        elseif key == Enum.KeyCode.End then value = slider.Max
        else return end;
        slider:SetValue(value);
        entry.Text = tostring(slider.Value);
        self:AttemptSave(slider.ControlIndex, slider);
    end));
end;

