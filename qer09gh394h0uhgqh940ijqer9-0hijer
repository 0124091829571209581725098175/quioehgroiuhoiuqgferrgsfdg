            .. ' '
            .. tostring(weapon or ''):gsub('[%[%]]', '')
        subtitle.Text = (metadata and metadata.Rarity and tostring(metadata.Rarity) .. '  /  ' or '')
            .. 'Drag to rotate  /  scroll to zoom'
