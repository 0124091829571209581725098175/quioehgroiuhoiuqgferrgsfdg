                local scale = math.max(Library.UIScale or 1, 0.01)
                local sectionScroll = section.Scroll
                sectionScroll.CanvasPosition = Vector2.new(0, math.max(0, sectionScroll.CanvasPosition.Y + (holder.AbsolutePosition.Y - sectionScroll.AbsolutePosition.Y) / scale - 8))
                for _, other in ipairs(tab.Sections) do
                    local selected = other == section
                    other.SectionButton.BackgroundTransparency = selected and 0 or 1
                    other.SectionButton.TextColor3 = selected and Library.AccentColor or Library.FontColor
                    Library.RegistryMap[other.SectionButton].Properties.TextColor3 = selected and 'AccentColor' or 'FontColor'
                end
            end)
            section.SectionButton = sectionButton
            if #tab.Sections == 1 then sectionButton.BackgroundTransparency = 0; sectionButton.TextColor3 = Library.AccentColor; Library.RegistryMap[sectionButton].Properties.TextColor3 = 'AccentColor' end
            Library.Groupboxes[#Library.Groupboxes + 1] = section
            Library.CurrentGroupbox = section
            return section
        end
        function tab:AddGroupbox(info)
            local item = group(info.Name, info.Side == 2 and right or left)
            self.Groupboxes[info.Name] = item
            local lower = tostring(self.Name):lower()
            if (lower == 'ui settings' or lower == 'ui' or lower == 'settings') and not self.ClassicDefaults then
                self.ClassicDefaults = true
                item:AddDropdown('NotificationStyle', {Text = 'Notification style', Values = {'Default', 'Gamesense', 'Simple', 'Gamesensical', 'Progress'}, Default = Library.NotificationStyle or 'Default', Callback = function(value) Library:SetNotificationStyle(value) end})
                item:AddDropdown('NotificationPosition', {Text = 'Notification position', Values = {'Bottom', 'Top', 'Bottom Left', 'Bottom Right', 'Top Left', 'Top Right'}, Default = Library.NotificationPosition or 'Bottom', Callback = function(value) Library:SetNotificationPosition(value) end})
                item:AddSlider('UIScale', {Text = 'UI scale', Default = 100, Min = 75, Max = 150, Rounding = 0, Suffix = '%', Callback = function(value) Library:SetUIScale(value / 100) end})
                item:AddToggle('ReducedMotion', {Text = 'Reduced motion', Default = false, Callback = function(value) Library.ReducedMotion = value end})

            end
            item:Resize()
            return item
        end
        function tab:AddLeftGroupbox(name) return self:AddGroupbox({Name = name, Side = 1}) end
        function tab:AddRightGroupbox(name) return self:AddGroupbox({Name = name, Side = 2}) end
        function tab:AddTabbox(info)
            local root=self
            local box={Tabs={},RootTab=root,TabSequence=0,Flat=true}
            box.Holder,box.Container=info.Side==2 and right or left,info.Side==2 and right or left
            function box:Resize()root:Resize()end
            function box:Select(selected)
                self.ActiveTab=selected
                if selected then selected.Holder.Visible=true;selected:Resize() end
            end
            function box:AddTab(name)
                self.TabSequence+=1
                local item=root:AddGroupbox({Name=name,Side=info.Side})
                item.FlatSection=true
                self.Tabs[name]=item
                self.ActiveTab=self.ActiveTab or item
                return item
            end
            root.Tabboxes[info.Name or '']=box
            root.Boxes[#root.Boxes+1]=box
            return box
        end
        function tab:AddLeftTabbox(name) return self:AddTabbox({Name = name, Side = 1}) end
        function tab:AddRightTabbox(name) return self:AddTabbox({Name = name, Side = 2}) end
        self.Tabs[name] = tab
        local lower = tostring(name):lower()
        if lower == 'ui settings' or lower == 'ui' then self.UITab = tab end
        if lower == 'protection' then self.ProtectionTab = tab end
        if not self.ActiveTab then tab:ShowTab() end
        if self.RefreshTabLayout then self.RefreshTabLayout() end
        return tab
    end

    function window:ConfigureItemWorkspace(tab, preview, skins, shop, loadout, avatar)
        local previous = loadout.RootTab
        loadout.Holder.Parent, loadout.RootTab, loadout.Scroll = tab.RightSide, tab, tab.RightScroll
        loadout.Holder:GetPropertyChangedSignal('Size'):Connect(function() tab:Resize() end)
        local pages = {skins = {preview, skins}, shop = {shop}, loadout = {loadout}, avatar = {avatar}}
        local all = {preview, skins, shop, loadout, avatar}
        local buttons = {skins = tab.TabButton}
        tab.TabButton.Text = 'skins'
        tab.TabButton.Name = 'skins'
        tab.ItemPage = 'skins'
        for index, entry in pairs(Library.ControlRegistry) do
            for name, groups in pairs(pages) do
                for _, group in ipairs(groups) do
                    if entry.Row and entry.Row:IsDescendantOf(group.Holder) then
                        entry.Tab, entry.ItemPage = tab, name
                        if name == 'avatar' then entry.Category = 'visuals' end
                        if entry.Group then entry.Group.RootTab, entry.Group.Scroll = tab, group.Scroll end
                    end
                end
            end
        end
        local originalShow = tab.ShowTab
        function tab:ShowTab()
            originalShow(self)
            window:SelectItemWorkspace('skins', true)
        end
        function window:SelectItemWorkspace(name, alreadyShown)
            if not pages[name] then return end
            tab.ItemPage = name
            if not alreadyShown then originalShow(tab) end
            for _, group in ipairs(all) do group.Holder.Visible = table.find(pages[name], group) ~= nil end
            if buttons[name] and window.ActiveTab == tab then self:SelectNavigationPage(buttons[name]) end
            tab:Resize()
        end
        for i, name in ipairs({'shop', 'loadout', 'avatar'}) do
            buttons[name] = makeNav(name, function() window:SelectItemWorkspace(name) end, 20 + i)
        end
        self:SelectItemWorkspace('skins', true)
        if previous then previous:Resize() end
    end

    local drag, resize, lastWidth, lastScale, lastSidebar, lastHeight, lastStacked
    local function fit()
        local screen = ScreenGui.AbsoluteSize
        if screen.X < 100 or screen.Y < 100 then return end
        local scale = math.max(window.ScaleObject.Scale, 0.01)
        local width = math.clamp(outer.Size.X.Offset, math.min(500, (screen.X - 16) / scale), math.max(100, (screen.X - 16) / scale))
        local height = math.clamp(outer.Size.Y.Offset, math.min(420, (screen.Y - 16) / scale), math.max(100, (screen.Y - 16) / scale))
        outer.Size = UDim2.fromOffset(width, height)
        local x = outer.Position.X.Scale * screen.X + outer.Position.X.Offset
        local y = outer.Position.Y.Scale * screen.Y + outer.Position.Y.Offset
        outer.Position = UDim2.fromOffset(math.clamp(x, 8, math.max(8, screen.X - width * scale - 8)), math.clamp(y, 8, math.max(8, screen.Y - height * scale - 8)))
        local showRail = width>=900 and window.ActiveTab ~= nil and tostring(window.ActiveTab.Name):lower() == 'items' and window.CustomPanel == nil
        rail.Visible, divider.Visible = showRail, showRail
        profileStatus.Visible = showRail
        local sidebar = width < 960 and 96 or 120
        rail.Size = UDim2.new(0, sidebar, 1, 0)
        divider.Position = UDim2.fromOffset(sidebar + 12, 0)
        local inset = showRail and sidebar + 24 or 0
        content.Position, content.Size = UDim2.fromOffset(inset, 4), UDim2.new(1, -inset, 1, -4)
        railTitle.Text = sidebar < 140 and 'WEAPONS' or 'PROFILES'
        local searchWidth = math.min(230, math.max(130, width * 0.24))
        local stackedFooter=false
        footer.Visible=false
        body.Position,body.Size=UDim2.fromOffset(12,85),UDim2.new(1,-24,1,-97)
        searchOuter.Visible,close.Visible,profileStatus.Visible=true,false,false
        searchOuter.Parent,searchOuter.Position,searchOuter.Size=outer,UDim2.new(1,-122,0,28),UDim2.fromOffset(110,22)
        search.PlaceholderText,search.TextSize='Search...',12
        nav.Size=UDim2.new(1,-138,0,24)
        title.Position,title.Size=UDim2.new(0.30,0,0,0),UDim2.new(0.40,0,1,0)
        local navButtons = {}
        for _, child in ipairs(nav:GetChildren()) do if child:IsA('TextButton') then navButtons[#navButtons + 1] = child end end
        local tabWidth = math.max(48,(width - 138 - math.max(0, #navButtons - 1) * 2) / math.max(1, #navButtons))
        for _, object in ipairs(navButtons) do object.Size = UDim2.fromOffset(tabWidth, 24) end
        updateCanvas(nav, navLayout)
        weaponList.CanvasSize = UDim2.fromOffset(0, weaponLayout.AbsoluteContentSize.Y / scale + 4)
        if width ~= lastWidth or height~=lastHeight or scale ~= lastScale or inset ~= lastSidebar or stackedFooter~=lastStacked then
            lastWidth, lastScale, lastSidebar, lastHeight, lastStacked = width, scale, inset, height, stackedFooter
            for _, group in ipairs(Library.Groupboxes) do if group.RootTab and group.Resize then group:Resize() end end
            for row, reflow in pairs(Library.WorkspaceRows or {}) do if row.Parent then reflow() end end
            for _, tab in pairs(window.Tabs) do tab:Resize() end
        end
    end
    window.RefreshTabLayout = fit
    header.InputBegan:Connect(function(input)
        if not Library:IsClickInput(input) or Library:MouseIsOverOpenedFrame() or InputService:GetFocusedTextBox() then return end
        drag = {Input = input, Pointer = input.Position, Position = outer.Position}
        Library:ConsumeInput(input)
    end)
    local resizeButton = frame('TextButton', {Name = 'ClassicResize', Parent = outer, Text = '', Font = Library.Font, TextSize = 16, TextColor3 = Library.FontColor, TextTransparency = 0.5, BackgroundTransparency = 1, BorderSizePixel = 0, Size = UDim2.fromOffset(20, 20), Position = UDim2.new(1, -20, 1, -20), AutoButtonColor = false, ZIndex = 20}, {TextColor3 = 'FontColor'})
    for index=1,2 do frame('Frame',{Parent=resizeButton,Position=UDim2.fromOffset(6+index*3,12),Size=UDim2.fromOffset(8-index*2,1),Rotation=-45,BorderSizePixel=0,BackgroundColor3=Library.OutlineColor,ZIndex=21},{BackgroundColor3='OutlineColor'}) end
    resizeButton.InputBegan:Connect(function(input)
        if not Library:IsClickInput(input) or Library:MouseIsOverOpenedFrame() then return end
        resize = {Input = input, Pointer = input.Position, Size = outer.Size}
        Library:ConsumeInput(input)
    end)
    Library:GiveSignal(InputService.InputChanged:Connect(function(input)
        local action = resize or drag
        if not action or not Library.MainVisible then return end
        if input ~= action.Input and input.UserInputType ~= Enum.UserInputType.MouseMovement then return end
        local delta = input.Position - action.Pointer
        local scale = math.max(window.ScaleObject.Scale, 0.01)
        if resize then outer.Size = UDim2.fromOffset(action.Size.X.Offset + delta.X / scale, action.Size.Y.Offset + delta.Y / scale)
        else outer.Position = UDim2.fromOffset(action.Position.X.Offset + delta.X, action.Position.Y.Offset + delta.Y) end
        fit()
    end))
    Library:GiveSignal(InputService.InputEnded:Connect(function(input)
        if drag and input == drag.Input then drag = nil end
        if resize and input == resize.Input then resize = nil end
    end))
    Library:GiveSignal(ScreenGui:GetPropertyChangedSignal('AbsoluteSize'):Connect(fit))
    window.ScaleObject:GetPropertyChangedSignal('Scale'):Connect(fit)
    local modal = frame('TextButton', {Parent = ScreenGui, BackgroundTransparency = 1, Text = '', Size = UDim2.fromOffset(0, 0), Modal = false, Visible = true})
    local toggled, toggleRevision = false, 0
    function Library:Toggle()
        if self.Unloaded then return end
        self:HideTooltip()
        toggled, toggleRevision = not toggled, toggleRevision + 1
        local revision = toggleRevision
        if not toggled then self:StopSliderDrag(true); self:ClosePlayerInspector() end
        self.MainVisible, modal.Modal = toggled, toggled
        drag, resize = nil, nil
        self:ClosePopups()
        self:HideToolbarPanels()
        window.FooterSetActive(nil)
        self:RefreshCustomCursor()
        if toggled then
            if not window.ActiveTab and window.LastTab then window.LastTab:ShowTab() end
            fit()
            if not outer.Visible then outer.GroupTransparency = self.ReducedMotion and 0 or 1 end
            outer.Visible = true
            self:AnimateControl(outer, {GroupTransparency = 0})
        else
            self:AnimateControl(outer, {GroupTransparency = 1})
            if self.ReducedMotion then outer.Visible = false
            else task.delay(0.13, function() if revision == toggleRevision and not toggled and outer.Parent then outer.Visible = false end end) end
        end
    end
    Library:GiveSignal(InputService.InputBegan:Connect(function(input, processed)
        if input.KeyCode == Enum.KeyCode.Escape and search:IsFocused() then search.Text = ''; search:ReleaseFocus(); results.Visible = false; return end
        if processed or InputService:GetFocusedTextBox() then return end
        local key = Library.ToggleKeybind
        if type(key) == 'table' and key.Type == 'KeyPicker' then
            if input.UserInputType == Enum.UserInputType.Keyboard and input.KeyCode.Name == key.Value then Library:Toggle() end
        elseif input.KeyCode == Enum.KeyCode.RightControl or input.KeyCode == Enum.KeyCode.RightShift then Library:Toggle() end
    end))
    fit()
    if config.AutoShow then task.defer(function() if not Library.Unloaded then Library:Toggle() end end) end
    return window
end

local PlayerChangePending = false;
local function OnPlayerChange()
    if PlayerChangePending or Library.Unloaded then return; end;
    PlayerChangePending = true;
    task.defer(function()
        PlayerChangePending = false;
        if Library.Unloaded then return; end;
        local PlayerList = GetPlayersString();
        for _, Value in next, Options do
            if Value.Type == 'Dropdown' and Value.SpecialType == 'Player' then Value:SetValues(PlayerList); end;
        end;
    end);
end;

Library:GiveSignal(Players.PlayerAdded:Connect(function(player)
    Library.PlayerJoinTimes[player], Library.PlayerJoinTimes[player.UserId] = tick(), tick();
    OnPlayerChange();
end));
Library:GiveSignal(Players.PlayerRemoving:Connect(OnPlayerChange));

