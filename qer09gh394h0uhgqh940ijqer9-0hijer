function Library:GetDropdownLayout(Position: Vector2, ControlSize: Vector2, RequestedHeight: number, Viewport: Vector2)
    local Width = math.min(math.max(0, ControlSize.X), math.max(0, Viewport.X - 16))
    local Height = math.min(math.max(1, RequestedHeight), math.max(1, Viewport.Y - 16))
    local X = math.clamp(Position.X, 8, math.max(8, Viewport.X - Width - 8))
    local Y = (Position.Y :: number) + (ControlSize.Y :: number) + 4
    local Above = (Position.Y :: number) - Height - 4
    if Y + Height > Viewport.Y - 8 and Above >= 8 then
        Y = Above
    end
    Y = math.clamp(Y, 8, math.max(8, Viewport.Y - Height - 8))
    return UDim2.fromOffset(X, Y), UDim2.fromOffset(Width, Height)
end
function Library:CalculateTabWidths(AvailableWidth, NaturalWidths, RequestedPadding)
    local Count = #NaturalWidths
    if Count == 0 then
        return {}, 0
    end
    local Available = math.max(0, math.floor(AvailableWidth))
    local Padding = Count > 1
            and math.min(math.max(0, math.floor(RequestedPadding or 0)), math.floor(Available * 0.08 / (Count - 1)))
        or 0
    local Budget = math.max(0, Available - Padding * (Count - 1))
    local Total = 0
    for _, Width in ipairs(NaturalWidths) do
        Total = Total + math.max(1, Width)
    end
    local Widths, Used, Cumulative = {}, 0, 0
    for Index, Width in ipairs(NaturalWidths) do
        local Natural = math.max(1, Width)
        local Share = Total <= Budget and (Natural + (Budget - Total) / Count) or (Natural / Total * Budget)
        Cumulative = Cumulative + Share
        local Edge = Index == Count and Budget or math.min(Budget, math.floor(Cumulative))
        Widths[Index] = math.max(0, Edge - Used)
        Used = Edge
    end
    return Widths, Padding
end
function Library:CreateResetIcon(parent)
    local icon = self:Create('Frame', {
        Name = 'ResetIcon',
        Parent = parent,
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.fromScale(0.5, 0.5),
        Size = UDim2.fromOffset(14, 14),
        BackgroundTransparency = 1,
        ZIndex = parent.ZIndex + 1,
    })
    local function line(x1, y1, x2, y2)
        local dx, dy = x2 - x1, y2 - y1
        local segment = self:Create('Frame', {
            Parent = icon,
            AnchorPoint = Vector2.new(0.5, 0.5),
            Position = UDim2.fromOffset((x1 + x2) / 2, (y1 + y2) / 2),
            Size = UDim2.fromOffset(math.sqrt(dx * dx + dy * dy) + 0.5, 1.4),
            Rotation = math.deg(math.atan2(dy, dx)),
            BackgroundColor3 = self.FontColor,
            BorderSizePixel = 0,
            ZIndex = icon.ZIndex,
        })
        self:AddToRegistry(segment, { BackgroundColor3 = 'FontColor' })
    end
    for i = 0, 9 do
        local a, b = math.rad(-135 + i * 27), math.rad(-135 + (i + 1) * 27)
        line(7 + math.cos(a) * 4.5, 7 + math.sin(a) * 4.5, 7 + math.cos(b) * 4.5, 7 + math.sin(b) * 4.5)
    end
    local x, y = 7 + math.cos(math.rad(135)) * 4.5, 7 + math.sin(math.rad(135)) * 4.5
    line(x, y, x + 3.5, y + 0.1)
    line(x, y, x + 0.1, y - 3.5)
    return icon
end

function Library:VisiblePreviewBounds(model)
    local lower, upper
    for _, part in ipairs(model:GetDescendants()) do
        if part:IsA('BasePart') and part.Transparency < 1 then
            local cf, size = part.CFrame, part.Size
            local radius = ((cf.XVector * size.X):Abs() + (cf.YVector * size.Y):Abs() + (cf.ZVector * size.Z):Abs()) / 2
            local first, last = part.Position - radius, part.Position + radius
            if lower then
                lower = lower:Min(first)
                upper = upper:Max(last)
            else
                lower, upper = first, last
            end
        end
    end
    if not lower then
        return nil, nil
    end
    return (lower + upper) / 2, upper - lower
end
