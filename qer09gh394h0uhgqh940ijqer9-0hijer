        Library:AddToRegistry(close, {TextColor3 = 'FontColor'})
        local scroll = Library:Create('ScrollingFrame', {BackgroundTransparency = 1; BorderSizePixel = 0;
            Position = UDim2.fromOffset(10, 32); Size = UDim2.new(1, -20, 1, -40);
            CanvasSize = UDim2.fromOffset(0, 0); ScrollBarThickness = 2; ScrollBarImageColor3 = Library.AccentColor;
            ScrollingDirection = Enum.ScrollingDirection.Y; Active = true; ZIndex = 4; Parent = frame})
        Library:AddToRegistry(scroll, {ScrollBarImageColor3 = 'AccentColor'})
        local container = Library:Create('Frame', {BackgroundTransparency = 1; Size = UDim2.new(1, -4, 0, 0); ZIndex = 4; Parent = scroll})
        local layout = Library:Create('UIListLayout', {FillDirection = Enum.FillDirection.Vertical; SortOrder = Enum.SortOrder.LayoutOrder; Parent = container})
        box.Container = container
        setmetatable(box, BaseGroupbox)
        function box:Position()
            local viewport = ScreenGui.AbsoluteSize
            local scale = Library.UIScale or 1
            local width = math.min(info.Width or 280, math.max(120, (viewport.X - 16) / scale))
            local height = math.min(math.max(42, layout.AbsoluteContentSize.Y / scale + 40), math.max(42, (viewport.Y - 16) / scale))
            frame.Size = UDim2.fromOffset(width, height)
            local point, size = button.AbsolutePosition - ScreenGui.AbsolutePosition, frame.AbsoluteSize
            local x = point.X + button.AbsoluteSize.X + 8
            if x + size.X > viewport.X - 8 then x = point.X - size.X - 8 end
            frame.Position = UDim2.fromOffset(math.clamp(x, 8, math.max(8, viewport.X - size.X - 8)), math.clamp(point.Y, 8, math.max(8, viewport.Y - size.Y - 8)))
        end
        function box:Resize()
            local scale = Library.UIScale or 1
            container.Size = UDim2.new(1, -4, 0, layout.AbsoluteContentSize.Y / scale)
            scroll.CanvasSize = UDim2.fromOffset(0, layout.AbsoluteContentSize.Y / scale)
            if frame.Visible then self:Position() end
        end
        function box:Open()
            if Library.Unloaded or not button.Parent then return end
            if Library.IsControlVisible and not Library:IsControlVisible(button) then return end
            Library:ClosePopups(self)
            self:Resize(); self:Position()
            frame.Visible = true
            Library.OpenedFrames[frame] = true
        end
        function box:Close()
            if self.Closing then return end
            self.Closing = true
            for popup in pairs(table.clone(Library.OpenedFrames)) do
                local child = Library:GetSettingsBox(Library.PopupAnchors[popup])
                if popup ~= frame and Library:IsPopupAncestor(frame, child) then
                    local closer = Library.PopupClosers and Library.PopupClosers[popup]
                    if closer then closer() elseif popup.Parent then popup.Visible = false end
                    Library.OpenedFrames[popup] = nil
                end
            end
            frame.Visible = false
            Library.OpenedFrames[frame] = nil
            self.Closing = false
        end
        Library.PopupOwners = Library.PopupOwners or {}
        Library.PopupClosers = Library.PopupClosers or {}
        Library.PopupOwners[frame], Library.PopupClosers[frame] = button, function() box:Close() end
        Library:ApplyScaleTo(frame)
        Library:BindPopupPosition(button, frame, function() box:Position() end)
        layout:GetPropertyChangedSignal('AbsoluteContentSize'):Connect(function() box:Resize() end)
        scroll:GetPropertyChangedSignal('CanvasPosition'):Connect(function() if Library.PrunePopups then Library:PrunePopups() end end)
        button.InputBegan:Connect(function(input)
            if not Library:IsClickInput(input) or Library:MouseIsOverOpenedFrame(button) then return end
            Library:ConsumeInput(input)
            if frame.Visible then box:Close() else box:Open() end
        end)
        close.InputBegan:Connect(function(input)
            if Library:IsClickInput(input) then Library:ConsumeInput(input); box:Close() end
        end)
        toggle.Settings = box
        return box
    end

    function Funcs:AddDependencyBox()
        local Depbox = {
            Dependencies = {};
        };
        
        local Groupbox = self;
        local Container = Groupbox.Container;

        local Holder = Library:Create('Frame', {
            BackgroundTransparency = 1;
            Size = UDim2.new(1, 0, 0, 0);
            Visible = false;
            Parent = Container;
        });

        local Frame = Library:Create('Frame', {
            BackgroundTransparency = 1;
            Size = UDim2.new(1, 0, 1, 0);
            Visible = true;
            Parent = Holder;
        });

        local Layout = Library:Create('UIListLayout', {
            FillDirection = Enum.FillDirection.Vertical;
            SortOrder = Enum.SortOrder.LayoutOrder;
            Parent = Frame;
        });

        function Depbox:Resize()
            Holder.Size = UDim2.new(1, 0, 0, Layout.AbsoluteContentSize.Y / math.max(Library.UIScale or 1, 0.01));
            Groupbox:Resize();
        end;

        Layout:GetPropertyChangedSignal('AbsoluteContentSize'):Connect(function()
            Depbox:Resize();
        end);

        Holder:GetPropertyChangedSignal('Visible'):Connect(function()
            Depbox:Resize();
        end);

        function Depbox:Update()
            for _, Dependency in next, Depbox.Dependencies do
                local Elem = Dependency[1];
                local Value = Dependency[2];

                if Elem.Type == 'Toggle' and Elem.Value ~= Value then
                    Holder.Visible = false;
                    Depbox:Resize();
                    return;
                end;
            end;

            Holder.Visible = true;
            Depbox:Resize();
        end;

        function Depbox:SetupDependencies(Dependencies)
            for _, Dependency in next, Dependencies do
                assert(type(Dependency) == 'table', 'SetupDependencies: Dependency is not of type `table`.');
                assert(Dependency[1], 'SetupDependencies: Dependency is missing element argument.');
                assert(Dependency[2] ~= nil, 'SetupDependencies: Dependency is missing value argument.');
            end;

            Depbox.Dependencies = Dependencies;
            Depbox:Update();
        end;

        Depbox.Container = Frame;
        Depbox.ControlGroup, Depbox.RootTab = self.ControlGroup or self, self.RootTab;

        setmetatable(Depbox, BaseGroupbox);

        table.insert(Library.DependencyBoxes, Depbox);

        return Depbox;
    end;

    BaseGroupbox.__index = Funcs;
    BaseGroupbox.__namecall = function(Table, Key, ...)
        return Funcs[Key](...);
    end;
end;

