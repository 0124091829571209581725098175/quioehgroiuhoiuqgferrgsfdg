    local char = LocalPlayer.Character
    local tchar = target.Character
    if char and tchar and tchar:FindFirstChild("HumanoidRootPart") and char:FindFirstChild("HumanoidRootPart") then
        char.HumanoidRootPart.CFrame = tchar.HumanoidRootPart.CFrame + Vector3.new(0, 3, 3)
        Library:Notify("Teleported to "..target.Name, 2)
    else
        Library:Notify("Cannot teleport", 2)
    end
end
