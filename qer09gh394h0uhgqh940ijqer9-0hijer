            local entry = self:Create('TextBox', {Name = 'SliderValue', Parent = field, Position = UDim2.new(1, -66, 0, -1), Size = UDim2.fromOffset(66, 24), Text = tostring(control.Value), ClearTextOnFocus = false, Font = self.Font, TextSize = 12, TextColor3 = self.FontColor, BackgroundColor3 = self.MainColor, BorderColor3 = self.OutlineColor, BorderSizePixel = 0, ZIndex = 12})
            self:AddToRegistry(entry, {TextColor3 = 'FontColor', BackgroundColor3 = 'MainColor', BorderColor3 = 'OutlineColor'})
            self:StyleControl(entry, entry, 5)
            local displayOriginal = control.Display
