        self:GiveSignal(self.CustomCursorConnection)
    elseif not Visible and self.CustomCursorConnection then
        self.CustomCursorConnection:Disconnect()
        local Index = table.find(self.Signals, self.CustomCursorConnection)
        if Index then
            table.remove(self.Signals, Index)
        end
        self.CustomCursorConnection = nil
    end
end
