function Library:FinishThemeTransition()
    local transition = self.ThemeTransition
    self.ThemeTransition = nil
    if not transition then
        return
    end
    if transition.Connection then
        transition.Connection:Disconnect()
    end
    for _, item in ipairs(transition.Items) do
        if item.Instance.Parent then
            item.Instance[item.Property] = item.Target
        end
    end
end
function Library:UpdateColorsUsingRegistry()
    local previous = self.ThemeTransition
    if previous and previous.Connection then
        previous.Connection:Disconnect()
    end
    self.ThemeTransition = nil
    local items = {}
    local animate = not self.ReducedMotion
        and self.MainVisible
        and self.ControlsReady ~= false
        and not self.ConfigLoading
    for _, object in ipairs(self.Registry) do
        if object.Instance.Parent then
            for property, colorIndex in pairs(object.Properties) do
                local color = type(colorIndex) == 'function' and colorIndex() or self[colorIndex]
                if color ~= nil and object.Instance[property] ~= color then
                    if animate and typeof(color) == 'Color3' and typeof(object.Instance[property]) == 'Color3' then
                        items[#items + 1] = {
                            Instance = object.Instance,
                            Property = property,
                            Start = object.Instance[property],
                            Target = color,
                        }
                    else
                        object.Instance[property] = color
                    end
                end
            end
        end
    end
    if #items == 0 then
        return
    end
    local transition = { Items = items, At = os.clock(), LastDraw = 0 }
    self.ThemeTransition = transition
    transition.Connection = RunService.RenderStepped:Connect(function()
        if self.Unloaded or self.ThemeTransition ~= transition then
            transition.Connection:Disconnect()
            return
        end
        local now = os.clock()
        local progress = math.clamp((now - transition.At) / 0.25, 0, 1)
        if self.ReducedMotion or not self.MainVisible or progress >= 1 then
            self:FinishThemeTransition()
            return
        end
        if now - transition.LastDraw < 1 / 30 then
            return
        end
        transition.LastDraw = now
        local eased = 1 - (1 - progress) ^ 3
        for _, item in ipairs(items) do
            if item.Instance.Parent then
                item.Instance[item.Property] = item.Start:Lerp(item.Target, eased)
            end
        end
    end)
    self:GiveSignal(transition.Connection)
end

function Library:GiveSignal(Signal)
    if not Signal then
        return
    end
    self.SignalSet = self.SignalSet or setmetatable({}, { __mode = 'k' })
    if self.SignalSet[Signal] then
        return Signal
    end
    if self.Unloaded then
        Signal:Disconnect()
        return Signal
    end
    if #self.Signals >= (self.NextSignalSweep or 256) then
        self:CompactSignals()
    end
    self.SignalSet[Signal] = true
    table.insert(Library.Signals, Signal)
    return Signal
end
function Library:CompactSignals()
    local write = 1
    for _, signal in ipairs(self.Signals) do
        if signal.Connected ~= false then
            self.Signals[write] = signal
            write += 1
        elseif self.SignalSet then
            self.SignalSet[signal] = nil
        end
    end
    for index = #self.Signals, write, -1 do
        self.Signals[index] = nil
    end
    self.NextSignalSweep = #self.Signals + 256
end

function Library:Unload()
    if self.Unloaded then
        return
    end
    self:FinishThemeTransition()
    for _, box in ipairs(self.DependencyBoxes) do
        if box.Tween then
            box.Tween:Cancel()
            box.Tween = nil
        end
    end
    Library:StopSliderDrag(false)
    if self.WorkspaceWindow and self.WorkspaceWindow.StopMovement then
        self.WorkspaceWindow:StopMovement()
    end
    Library:ClosePlayerInspector(true)
    Library:StopPlayerView()
    Library.Unloaded = true
    if self.CancelStartupIntro then
        self:CancelStartupIntro()
    end
    if self.UIWork then
        if self.UIWork.Worker and self.UIWork.Worker ~= coroutine.running() then
            pcall(task.cancel, self.UIWork.Worker)
        end
        table.clear(self.UIWork.Items)
        table.clear(self.UIWork.Keys)
        self.UIWork = nil
    end
    for job in pairs(self.ConfigCallbackJobs or {}) do
        if job.Thread and job.Thread ~= coroutine.running() then
            pcall(task.cancel, job.Thread)
        end
    end
    self.ConfigCallbackJobs = nil
    self.PendingLayouts = nil
    if self.PlayerListTimer then
        pcall(task.cancel, self.PlayerListTimer)
        self.PlayerListTimer = nil
    end
    Library:HideTooltip()
    Library.CustomCursorEnabled = false
    Library:RefreshCustomCursor()
    Library:RestoreMouseIcon()
    for Handle in pairs(Library.ProgressNotifications or {}) do
        Handle:Complete()
    end
    for Target, Tween in pairs(Library.ControlTweens) do
        Tween:Cancel()
        Library.ControlTweens[Target] = nil
    end
    table.clear(Library.ControlTweenGoals)
    if Library.NeonConnection then
        Library.NeonConnection:Disconnect()
        Library.NeonConnection = nil
    end
    table.clear(Library.NeonBorders)
    -- Unload all of the signals
    for Idx = #Library.Signals, 1, -1 do
        local Connection = table.remove(Library.Signals, Idx)
        pcall(Connection.Disconnect, Connection)
    end
    if self.SignalSet then
        table.clear(self.SignalSet)
    end
    if Library.AnimatedGradients then
        table.clear(Library.AnimatedGradients)
    end
    Library.GradientConnection = nil

    -- Call our unload callback, maybe to undo some hooks etc
    if Library.OnUnload then
        local ok, problem = pcall(Library.OnUnload)
        if not ok then
            warn('[phowg] unload: ' .. tostring(problem))
        end
    end

    ScreenGui:Destroy()
end

