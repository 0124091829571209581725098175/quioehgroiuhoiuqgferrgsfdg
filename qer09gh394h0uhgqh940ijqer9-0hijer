                    if not Library.ClassicEnabled then Library:StyleControl(Button, Button, 3) else Button.BorderSizePixel = 0 end;
                    local SelectionMarker = Library:CreateSelectionMarker(Button);

                    function Table:UpdateButton()
                        if Info.Multi then
                            Selected = Dropdown.Value[Value];
                        else
                            Selected = Dropdown.Value == Value;
                        end;
                        SelectionMarker.Visible = not not Selected;
                        Button.BackgroundColor3 = Selected and Library.BackgroundColor or Library.MainColor;
                        Library.RegistryMap[Button].Properties.BackgroundColor3 = Selected and 'BackgroundColor' or 'MainColor';

                        ButtonLabel.TextColor3 = Selected and Library.AccentColor or Library.FontColor;
                        Library.RegistryMap[ButtonLabel].Properties.TextColor3 = Selected and 'AccentColor' or 'FontColor';

                        if Dropdown.Highlight == Value and not Selected then
                            Button.BorderColor3 = Library.AccentColor;
                            Library.RegistryMap[Button].Properties.BorderColor3 = 'AccentColor';
                        elseif not Selected then
                            Button.BorderColor3 = Library.OutlineColor;
                            Library.RegistryMap[Button].Properties.BorderColor3 = 'OutlineColor';
                        end;
                    end;

                    function Table:Activate()
                        local Try = not Selected;

                        if Dropdown:GetActiveValues() == 1 and (not Try) and (not Info.AllowNull) then
                            return;
                        end;

                        if Info.Multi then
                            Selected = Try;

                            if Selected then
                                Dropdown.Value[Value] = true;
                            else
                                Dropdown.Value[Value] = nil;
                            end;
                        else
                            Selected = Try;

                            if Selected then
                                Dropdown.Value = Value;
                            else
                                Dropdown.Value = nil;
                            end;
                        end;

                        Table:UpdateButton();
                        Dropdown:Display();

                        Library:SafeCallback(Dropdown.Callback, Dropdown.Value);
                        Library:SafeCallback(Dropdown.Changed, Dropdown.Value);

                        Library:AttemptSave(Idx, Dropdown);
                    end;

                    Button.Activated:Connect(function() Table:Activate() end);

                    Table:UpdateButton();

                    RowTables[Button] = Table;
                    RowByValue[Value] = Table;
                end;
            end;

            Scrolling.CanvasSize = UDim2.fromOffset(0, (Count * 20) + 1);
