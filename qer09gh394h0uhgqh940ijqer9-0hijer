                local available = math.max(40, holder.AbsoluteSize.X / math.max(Library.UIScale or 1, 0.01) - 110)
                local total = 0
                for _, item in ipairs(owner.HeaderButtons) do
                    item.HeaderWidth = math.clamp(select(1, Library:GetTextBounds(item.Label.Text, Library.Font, 12)) + 24, 48, 120)
                    total += item.HeaderWidth
                end
                local gaps = math.max(0, #owner.HeaderButtons - 1) * 5
                local ratio = math.min(1, math.max(1, available - gaps) / math.max(total, 1))
                local x = 0
                for _, item in ipairs(owner.HeaderButtons) do
                    local width = item.HeaderWidth * ratio
                    item.Outer.Position = UDim2.fromOffset(x,0)
                    item.Outer.Size = UDim2.fromOffset(width,22)
                    x += width + 5
                end
                owner.HeaderActionsWidth = math.max(0, x - 5)
                owner.HeaderActions.Size = UDim2.fromOffset(owner.HeaderActionsWidth,22)
                reflowing = false
                owner:Resize()
            end
            Library:GiveSignal(holder:GetPropertyChangedSignal('AbsoluteSize'):Connect(self.ReflowHeaderButtons))
        end
        local proxy = setmetatable({Container=self.HeaderActions, AddBlank=function() end, Resize=function() end}, {__index=self})
        local result = BaseGroupbox.__index.AddButton(proxy, ...)
        result.Outer.Name = 'SectionActionButton'
