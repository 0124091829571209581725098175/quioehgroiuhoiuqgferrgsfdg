            self:ConsumeInput(input)
        end
    end)
    connect(InputService.InputChanged, function(input)
        if state.Drag and (input == state.Drag or input.UserInputType == Enum.UserInputType.MouseMovement) then
            state.Angle = state.StartAngle + (input.Position.X - state.DragX) * 0.012
        end
    end)
    connect(InputService.InputEnded, function(input) if input == state.Drag then state.Drag = nil end end)
    connect(InputService.WindowFocusReleased,function() state.Drag=nil;releaseScroll() end)
    connect(main.Viewport.InputChanged, function(input)
        if input.UserInputType == Enum.UserInputType.MouseWheel then state.Zoom = math.clamp(state.Zoom - input.Position.Z * 0.08, 0.7, 2) end
    end)
    connect(RunService.Heartbeat, function(delta)
        local tab = owner.RootTab
        if self.Unloaded or not self.MainVisible or not owner.Holder.Visible or not tab.TabFrame.Visible then state.Drag = nil; releaseScroll(); return end
        state.Elapsed = state.Elapsed + delta
        if state.Elapsed < 1 / 30 then return end
        local elapsed = state.Elapsed
        state.Elapsed = 0
        local _, _, _, token = selected()
        if state.Dirty or state.Token ~= token then state.Refresh() end
        if not state.Drag and not self.ReducedMotion then state.Angle = state.Angle + math.min(elapsed, 0.1) * 0.12 end
        cameraFit(main, state.Angle, state.Zoom)
        state.SummaryAt = (state.SummaryAt or 0) + elapsed
        if state.SummaryAt >= 0.5 then
            state.SummaryAt = 0
            loadout.Text = summary and summary() or ''
        end
    end)
    holder.Destroying:Connect(function() releaseScroll(); for _, connection in ipairs(state.Connections) do connection:Disconnect() end end)
    self:GiveSignal({Disconnect = function() if holder.Parent then holder:Destroy() end end})
    owner:Resize()
    return state
end

function Library:FormatClassicControl(control, owner, text, anchor)
    local container = owner.Container
    local field = control.Type == 'Slider' and control.Outer or anchor
    local caption = control.Label
    if control.Type == 'Input' then
        caption = anchor
        local following = false
        for _, child in ipairs(container:GetChildren()) do
            if child == anchor then following = true
            elseif following and child:IsA('Frame') and child:FindFirstChildWhichIsA('Frame') then field = child; break end
        end
    elseif not caption then
        local previous
        for _, child in ipairs(container:GetChildren()) do
            if child == anchor then caption = previous; break end
            if child:IsA('TextLabel') then previous = child end
        end
        if caption and caption.Text ~= text then caption = nil end
    end
    if not field or field.Parent ~= container then return end
    local searchList = control.Type == 'Dropdown' and control.Filtered ~= nil
    local row = self:Create('Frame', {Name = 'ClassicControlRow', Parent = container, BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 28), ZIndex = 5})
    if not caption then caption = self:CreateLabel({Text = text or '', TextSize = 14, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 6}) end
    caption.Parent, caption.TextTruncate, caption.TextYAlignment = row, Enum.TextTruncate.AtEnd, Enum.TextYAlignment.Center
    field.Parent, field.AnchorPoint = row, Vector2.zero
    field.BackgroundTransparency = 1
    control.WorkspaceStyled, control.WorkspaceRow = true, row
    if control.Type == 'Slider' then
        local inner = field:FindFirstChildWhichIsA('Frame')
        local display = inner and inner:FindFirstChildWhichIsA('TextLabel')
        if inner then
            inner.Position, inner.Size = UDim2.fromOffset(0, 2), UDim2.new(1, 0, 0, 12)
            inner.BorderSizePixel = 0
            local stroke = inner:FindFirstChild('ControlStroke')
            if stroke then stroke.Transparency = 1 end
        end
        if display then display.Visible = false end
        local entry = self:Create('TextBox', {Name = 'SliderValue', Parent = field, Position = UDim2.new(0.5,-32,0,0), Size = UDim2.fromOffset(64,18), Text = tostring(control.Value) .. control.Suffix, TextXAlignment = Enum.TextXAlignment.Center, ClearTextOnFocus = false, Font = self.Font, TextSize = 11, TextColor3 = self.FontColor, BackgroundColor3 = self.MainColor, BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 12})
        self:AddToRegistry(entry, {TextColor3 = 'FontColor', BackgroundColor3 = 'MainColor'})
        local editorStroke = self:Create('UIStroke', {Name = 'NumericFocus', Parent = entry, Color = self.AccentColor, Thickness = 1, Transparency = 1})
        self:AddToRegistry(editorStroke, {Color = 'AccentColor'})
        self:Create('UICorner', {Parent = entry, CornerRadius = UDim.new(0, 2)})
        local original = control.Display
        function control:Display()
            original(self)
            if not entry:IsFocused() then entry.Text = tostring(self.Value) .. self.Suffix end
        end
        entry.Focused:Connect(function()
            Library.FocusedSlider = control; entry.Text = tostring(control.Value); entry.BackgroundTransparency = 0.25; editorStroke.Transparency = 0
        end)
        entry.FocusLost:Connect(function()
            if Library.FocusedSlider == control then Library.FocusedSlider = nil end
            entry.BackgroundTransparency = 1; editorStroke.Transparency = 1
            local value = tonumber(entry.Text)
            if value and value == value and math.abs(value) ~= math.huge then
                value = tonumber(string.format('%.' .. math.clamp(control.Rounding or 0, 0, 10) .. 'f', value))
                if value ~= control.Value then control:SetValue(value); Library:AttemptSave(control.ControlIndex, control) end
            end
            entry.Text = tostring(control.Value) .. control.Suffix
        end)
        control.NumericEntry = entry
        local reset = self:Create('TextButton', {Name = 'ResetSlider', Parent = field, Position = UDim2.new(1, -22, 0, 0), Size = UDim2.fromOffset(22, 22), Text = '', Font = self.Font, TextSize = 16, TextColor3 = self.FontColor, BackgroundTransparency = 1, BorderSizePixel = 0, AutoButtonColor = false, ZIndex = 12})
        self:CreateResetIcon(reset)
        reset.Visible=false
        self:AddToRegistry(reset, {TextColor3 = 'FontColor'})
        reset.Activated:Connect(function()
            if Library.Unloaded or Library:MouseIsOverOpenedFrame(reset) then return end
            Library:StopSliderDrag(true)
            if entry:IsFocused() then entry:ReleaseFocus() end
            control:SetValue(control.Default or control.Min)
            Library:AttemptSave(control.ControlIndex, control)
        end)
    end
    self.WorkspaceRows = self.WorkspaceRows or setmetatable({}, {__mode = 'k'})
    local function reflow()
        local scale = math.max(Library.UIScale or 1, 0.01)
        local height=searchList and (control.ClassicListHeight or 120) or 16
        row.Size=UDim2.new(1,0,0,searchList and height+20 or 36)
        caption.Position,caption.Size,caption.TextSize=UDim2.fromOffset(0,0),UDim2.new(1,0,0,17),12
        field.Position=UDim2.fromOffset(0,18)
        field.Size=UDim2.new(1,0,0,searchList and height or 16)
        if owner.Resize then owner:Resize() end
    end
    control.ClassicReflow, self.WorkspaceRows[row] = reflow, reflow
    local lastWidth
    row:GetPropertyChangedSignal('AbsoluteSize'):Connect(function()
        if lastWidth == row.AbsoluteSize.X then return end
        lastWidth = row.AbsoluteSize.X
        reflow()
    end)
    reflow()
    return row
end

function Library:FormatWorkspaceControl(control, owner, text, anchor)
