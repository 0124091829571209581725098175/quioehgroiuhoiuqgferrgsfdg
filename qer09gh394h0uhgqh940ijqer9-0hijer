function Library:BuildCustomCursor()
    local Cursor = self.CustomCursor
    if not Cursor then
        return
    end
    local Style, Size, Color = self.CustomCursorStyle, self.CustomCursorSize, self.CustomCursorColor
    if self.CursorBuiltStyle == Style and self.CursorBuiltSize == Size and self.CursorBuiltColor == Color then
        return
    end
    for _, Child in ipairs(Cursor:GetChildren()) do
        Child:Destroy()
    end
    self.CursorBuiltStyle, self.CursorBuiltSize, self.CursorBuiltColor = Style, Size, Color
    Cursor.Size = UDim2.fromOffset(Size, Size)
    Cursor.AnchorPoint = Style == 'arrow' and Vector2.zero or Vector2.new(0.5, 0.5)
    local function Shape(Properties)
        Properties.Parent, Properties.Active, Properties.BorderSizePixel, Properties.ZIndex =
            Cursor, false, 0, Properties.ZIndex or 10000
        return self:Create('Frame', Properties)
    end
    local function Line(X1, Y1, X2, Y2)
        local DX, DY = X2 - X1, Y2 - Y1
        local Length, Angle = math.sqrt(DX * DX + DY * DY), math.deg(math.atan2(DY, DX))
        for _, Outline in ipairs({ true, false }) do
            Shape({
                AnchorPoint = Vector2.new(0.5, 0.5),
                Position = UDim2.fromOffset((X1 + X2) * 0.5, (Y1 + Y2) * 0.5),
                Size = UDim2.fromOffset(Length, Outline and 3 or 1),
                Rotation = Angle,
                BackgroundColor3 = Outline and Color3.new(0, 0, 0) or Color,
                ZIndex = Outline and 10000 or 10001,
            })
        end
    end
    local function Circle(Diameter, Hollow)
        local Object = Shape({
            AnchorPoint = Vector2.new(0.5, 0.5),
            Position = UDim2.fromScale(0.5, 0.5),
            Size = UDim2.fromOffset(Diameter, Diameter),
            BackgroundColor3 = Color,
            BackgroundTransparency = Hollow and 1 or 0,
        })
        self:Create('UICorner', { CornerRadius = UDim.new(0, 0), Parent = Object })
        self:Create(
            'UIStroke',
            { Color = Hollow and Color or Color3.new(0, 0, 0), Thickness = Hollow and 1.5 or 1, Parent = Object }
        )
    end
    local Half, Gap = Size * 0.5, math.max(2, math.floor(Size * 0.15))
    if Style == 'cross' then
        Line(0, Half, Size, Half)
        Line(Half, 0, Half, Size)
    elseif Style == 'crosshair' then
        Line(0, Half, Half - Gap, Half)
        Line(Half + Gap, Half, Size, Half)
        Line(Half, 0, Half, Half - Gap)
        Line(Half, Half + Gap, Half, Size)
    elseif Style == 'dot' then
        Circle(math.max(3, math.floor(Size * 0.25)), false)
    elseif Style == 'ring' then
        Circle(Size - 2, true)
    elseif Style == 'diamond' then
        Line(Half, 1, Size - 1, Half)
        Line(Size - 1, Half, Half, Size - 1)
        Line(Half, Size - 1, 1, Half)
        Line(1, Half, Half, 1)
    elseif Style == 'arrow' then
        Line(1, 1, 1, Size * 0.85)
        Line(1, 1, Size * 0.6, Size * 0.6)
        Line(Size * 0.6, Size * 0.6, Size * 0.24, Size * 0.6)
        Line(Size * 0.24, Size * 0.6, 1, Size * 0.85)
        Line(Size * 0.24, Size * 0.6, Size * 0.4, Size)
    end
end
function Library:RefreshCustomCursor()
    local Visible = self.CustomCursorEnabled
        and not self.Unloaded
        and (self.CustomCursorAlways or self.MainVisible == true)
    if Visible and not self.CustomCursor then
        self.CustomCursor = self:Create('Frame', {
            Name = 'CustomCursor',
            BackgroundTransparency = 1,
            BorderSizePixel = 0,
            Size = UDim2.fromOffset(20, 20),
            Active = false,
            ZIndex = 10000,
            Parent = ScreenGui,
        })
    end
    if self.CustomCursor then
        if Visible then
            self:BuildCustomCursor()
            self.CustomCursor.Position = UDim2.fromOffset(Mouse.X, Mouse.Y)
        end
        self.CustomCursor.Visible = Visible == true
    end
    self:SetMouseIconHidden('custom cursor', Visible == true)
    if Visible and not self.CustomCursorConnection then
        self.CustomCursorConnection = InputService.InputChanged:Connect(function(Input)
            if Input.UserInputType == Enum.UserInputType.MouseMovement and self.CustomCursor then
                self.CustomCursor.Position = UDim2.fromOffset(Mouse.X, Mouse.Y)
