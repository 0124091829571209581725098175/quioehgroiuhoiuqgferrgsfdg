            Parent = ListInner,

            TopImage = 'rbxasset://textures/ui/Scroll/scroll-middle.png',
            BottomImage = 'rbxasset://textures/ui/Scroll/scroll-middle.png',

            ScrollBarThickness = 3,
            ScrollBarImageColor3 = Library.AccentColor,
        })

        Library:AddToRegistry(Scrolling, {
            ScrollBarImageColor3 = 'AccentColor',
        })

        Library:Create('UIListLayout', {
            Padding = UDim.new(0, 0),
            FillDirection = Enum.FillDirection.Vertical,
            SortOrder = Enum.SortOrder.LayoutOrder,
            Parent = Scrolling,
        })

        local RefreshCustomBox
        local Buttons = {}
        local BuiltValues = {}

        function Dropdown:Display()
            for _, Button in pairs(Buttons) do
                Button:UpdateButton()
            end
            local Values = Dropdown.Values
            local Str = ''
            if Info.Multi then
                local SelectedValues = {}
                for Idx, Value in next, Values do
                    if Dropdown.Value[Value] then
                        SelectedValues[#SelectedValues + 1] = tostring(Value)
                    end
                end
                Str = table.concat(SelectedValues, ', ')
            else
                Str = Dropdown.Value or ''
            end
            ItemList.Text = Info.SpecialType == 'Player' and (Str == '' and '--' or Str)
                or tostring(Str == '' and '--' or Str):lower()
            if Info.Dangerous then
                ItemList.TextColor3 = Library.RiskColor
                Library.RegistryMap[ItemList].Properties.TextColor3 = 'RiskColor'
            end
            RefreshCustomBox()
        end

        local CustomKey = nil

        for _, V in next, Dropdown.Values do
            if type(V) == 'string' and V:lower() == 'custom' then
                CustomKey = V
                break
            end
        end

        local CustomOuter = nil
        local CustomBox = nil

        if CustomKey ~= nil then
            CustomOuter = Library:Create('Frame', {
                BackgroundColor3 = Color3.new(0, 0, 0),
                BorderColor3 = Color3.new(0, 0, 0),
                Size = UDim2.new(1, -4, 0, 20),
                Visible = false,
                ZIndex = 5,
                Parent = Container,
            })

            local CustomInner = Library:Create('Frame', {
                BackgroundColor3 = Library.MainColor,
                BorderColor3 = Library.OutlineColor,
                BorderMode = Enum.BorderMode.Inset,
                Size = UDim2.new(1, 0, 1, 0),
                ZIndex = 6,
                Parent = CustomOuter,
            })
            Library:StyleControl(CustomOuter, CustomInner, 4)

            Library:AddToRegistry(CustomInner, {
                BackgroundColor3 = 'MainColor',
                BorderColor3 = 'OutlineColor',
            })

            Library:OnHighlight(CustomOuter, CustomOuter, { BorderColor3 = 'AccentColor' }, { BorderColor3 = 'Black' })

            CustomBox = Library:Create('TextBox', {
                BackgroundTransparency = 1,
                ClearTextOnFocus = false,
                Position = UDim2.new(0, 5, 0, 0),
                Size = UDim2.new(1, -10, 1, 0),
                Font = Library.Font,
                PlaceholderColor3 = Color3.fromRGB(190, 190, 190),
                PlaceholderText = 'custom value...',
                Text = '',
                TextColor3 = Library.FontColor,
                TextSize = 14,
                TextXAlignment = Enum.TextXAlignment.Left,
                ZIndex = 7,
                Parent = CustomInner,
            })

            Library:ApplyTextStroke(CustomBox)

            Library:AddToRegistry(CustomBox, {
                TextColor3 = 'FontColor',
            })

            CustomBox:GetPropertyChangedSignal('Text'):Connect(function()
                if Info.Multi and Dropdown.Value[CustomKey] or (not Info.Multi) and Dropdown.Value == CustomKey then
                    Library:SafeCallback(Dropdown.Callback, CustomBox.Text ~= '' and CustomBox.Text or CustomKey)
                    Library:AttemptSave(Idx, Dropdown)
                end
            end)
        end

        RefreshCustomBox = function()
            if CustomOuter == nil then
                return
            end

            local Show = false

            if Info.Multi then
                Show = Dropdown.Value[CustomKey] == true
            else
                Show = Dropdown.Value == CustomKey
            end

            CustomOuter.Visible = Show

            if Show and not Info.Multi and CustomBox.Text ~= '' then
                ItemList.Text = CustomBox.Text
            end

            Groupbox:Resize()
        end

        function Dropdown:GetActiveValues()
            if Info.Multi then
                local T = {}

                for Value, Bool in next, Dropdown.Value do
                    table.insert(T, Value)
                end

                return T
            else
                return Dropdown.Value and 1 or 0
            end
        end

        function Dropdown:BuildDropdownList()
            Dropdown.ListDirty = false
            local Values = Dropdown.Values
            table.clear(Buttons)
            BuiltValues = table.clone(Values)

            for _, Element in next, Scrolling:GetChildren() do
                if not Element:IsA('UIListLayout') then
                    Element:Destroy()
                end
            end

            local Count = 0

            for Idx, Value in next, Values do
                local Table = {}

                Count = Count + 1

                local Button = Library:Create('TextButton', {
                    Name = tostring(Value),
                    Text = '',
                    AutoButtonColor = false,
                    BackgroundColor3 = Library.MainColor,
                    BorderColor3 = Library.OutlineColor,
                    BorderMode = Enum.BorderMode.Middle,
                    Size = UDim2.new(1, -1, 0, 20),
                    LayoutOrder = Count,
                    ZIndex = 23,
                    Active = true,
                    Parent = Scrolling,
                })

                Library:AddToRegistry(Button, {
                    BackgroundColor3 = 'MainColor',
                    BorderColor3 = 'OutlineColor',
                })

                local ButtonLabel = Library:CreateLabel({
                    Active = false,
                    Size = UDim2.new(1, -6, 1, 0),
                    Position = UDim2.new(0, 6, 0, 0),
                    TextSize = 14,
                    Text = Info.SpecialType == 'Player' and Value or tostring(Value):lower(),
                    TextXAlignment = Enum.TextXAlignment.Left,
                    TextTruncate = Enum.TextTruncate.AtEnd,
                    ZIndex = 25,
                    Parent = Button,
                })

                Library:OnHighlight(
                    Button,
                    Button,
                    { BorderColor3 = 'AccentColor', ZIndex = 24 },
                    { BorderColor3 = 'OutlineColor', ZIndex = 23 }
                )
                if not Library.ClassicEnabled then
                    Library:StyleControl(Button, Button, 3)
                else
                    Button.BorderSizePixel = 0
                end
                local SelectionMarker = Library:CreateSelectionMarker(Button)

                local Selected

                if Info.Multi then
                    Selected = Dropdown.Value[Value]
                else
                    Selected = Dropdown.Value == Value
                end

                local DangerousMap = Info.DangerousOptions or Info.DangerousMap or {}
                local IsDangerousOption = Info.Dangerous and true or DangerousMap[Value] == true
                if Info.DangerousValues and Info.DangerousValues[Value] then
                    IsDangerousOption = true
                end
                local UpdateChoice = Library:BindChoiceStyle(Button, ButtonLabel, SelectionMarker, function()
                    return Selected
                end, IsDangerousOption)
                function Table:UpdateButton()
                    Selected = Info.Multi and Dropdown.Value[Value] or not Info.Multi and Dropdown.Value == Value
                    UpdateChoice()
                end

                Button.Activated:Connect(function()
                    local Try = not Selected

                    if Dropdown:GetActiveValues() == 1 and not Try and not Info.AllowNull then
                    else
                        if Info.Multi then
                            Selected = Try

                            if Selected then
                                Dropdown.Value[Value] = true
                            else
                                Dropdown.Value[Value] = nil
                            end
                        else
                            Selected = Try

                            if Selected then
                                Dropdown.Value = Value
                            else
                                Dropdown.Value = nil
                            end
                        end

                        Dropdown:Display()
                        if not Info.Multi then
                            Dropdown:CloseDropdown()
                        end

                        Library:SafeCallback(Dropdown.Callback, Dropdown.Value)
                        Library:SafeCallback(Dropdown.Changed, Dropdown.Value)

                        Library:AttemptSave(Idx, Dropdown)
                    end
                end)

                Table:UpdateButton()

                Buttons[Button] = Table
            end

            Scrolling.CanvasSize = UDim2.fromOffset(0, (Count * 20) + 1)

            local Y = math.clamp(Count * 20, 0, MAX_DROPDOWN_ITEMS * 20) + 1
            RecalculateListSize(Y)
            Dropdown:Display()
        end

        function Dropdown:SetValues(NewValues)
            if NewValues then
                Dropdown.Values = NewValues
                local Unchanged = #NewValues == #BuiltValues
                if Unchanged then
                    for Index, Value in ipairs(NewValues) do
                        if BuiltValues[Index] ~= Value then
                            Unchanged = false
                            break
                        end
                    end
                end
                if Unchanged then
                    Dropdown:Display()
                    return
                end
            end

            if Dropdown.SpecialType == 'Player' and not ListOuter.Visible then
                Dropdown.ListDirty = true
                return
            end
            Dropdown:BuildDropdownList()
        end

        function Dropdown:OpenDropdown()
            Library:ClosePopups(ListOuter)
            if Dropdown.ListDirty then
                Dropdown:BuildDropdownList()
            end
            RecalculateListPosition()
            ListOuter.Visible = true
            Library.OpenedFrames[ListOuter] = true
            ListOuter.GroupTransparency = Library.ReducedMotion and 0 or 0.2
            Library:AnimateControl(ListOuter, { GroupTransparency = 0 })
            Library:AnimateControl(DropdownArrow, { Rotation = 180 })
        end

        function Dropdown:CloseDropdown()
            ListOuter.Visible = false
            Library.OpenedFrames[ListOuter] = nil
            Library:AnimateControl(DropdownArrow, { Rotation = 0 })
        end
        Library.PopupClosers = Library.PopupClosers or {}
        Library.PopupClosers[ListOuter] = function()
            Dropdown:CloseDropdown()
        end
        Dropdown.Outer, Dropdown.Inner, Dropdown.Arrow, Dropdown.ListOuter, Dropdown.ItemList =
            DropdownOuter, DropdownInner, DropdownArrow, ListOuter, ItemList

        function Dropdown:SetMulti(Multi, Value)
            Multi = Multi == true
            if self.Multi == Multi then
                return
            end
            self:CloseDropdown()
            Info.Multi, self.Multi = Multi, Multi
            self:SetValue(Value == nil and self.Value or Value, true)
            self:BuildDropdownList()
        end

        function Dropdown:OnChanged(Func)
            Dropdown.Changed = Func
            Func(Dropdown.Value)
        end

        function Dropdown:SetValue(Val, Silent)
            if Dropdown.Multi then
                local nTable = {}
                if type(Val) == 'string' then
                    if table.find(Dropdown.Values, Val) then
                        nTable[Val] = true
                    end
                elseif type(Val) == 'table' then
                    for Value, Bool in next, Val do
                        local key = Value
                        local isActive = Bool
                        if type(Value) == 'number' then
                            key = Bool
                            isActive = true
                        end
                        if type(key) == 'string' and table.find(Dropdown.Values, key) and isActive then
                            nTable[key] = true
                        end
                    end
                end
                Dropdown.Value = nTable
            else
                if (not Val) or (type(Val) == 'table' and next(Val) == nil) then
                    Dropdown.Value = nil
                elseif type(Val) == 'string' and table.find(Dropdown.Values, Val) then
                    Dropdown.Value = Val
                elseif type(Val) == 'table' then
                    for k, v in next, Val do
                        if type(v) == 'string' and table.find(Dropdown.Values, v) then
                            Dropdown.Value = v
                            break
                        end
                        if type(k) == 'string' and table.find(Dropdown.Values, k) and v then
                            Dropdown.Value = k
                            break
                        end
                    end
                end
            end
            Dropdown:Display()
            if not Silent then
                Library:SafeCallback(Dropdown.Callback, Dropdown.Value)
                Library:SafeCallback(Dropdown.Changed, Dropdown.Value)
            end
        end

        DropdownOuter.InputBegan:Connect(function(Input)
            if Library:IsClickInput(Input) and not Library:MouseIsOverOpenedFrame(DropdownOuter) then
                if ListOuter.Visible then
                    Dropdown:CloseDropdown()
                else
                    Dropdown:OpenDropdown()
                end
            end
        end)

        Library:GiveSignal(InputService.InputBegan:Connect(function(Input)
            if ListOuter.Visible and Library:IsClickInput(Input) then
                local AbsPos, AbsSize = ListOuter.AbsolutePosition, ListOuter.AbsoluteSize
                local ButtonPos, ButtonSize = DropdownOuter.AbsolutePosition, DropdownOuter.AbsoluteSize
                local P = Input.Position
                local OverList = P.X >= AbsPos.X
                    and P.X <= AbsPos.X + AbsSize.X
                    and P.Y >= AbsPos.Y
                    and P.Y <= AbsPos.Y + AbsSize.Y
                local OverButton = P.X >= ButtonPos.X
                    and P.X <= ButtonPos.X + ButtonSize.X
                    and P.Y >= ButtonPos.Y
                    and P.Y <= ButtonPos.Y + ButtonSize.Y
                if not OverList and not OverButton then
                    Dropdown:CloseDropdown()
                end
            end
        end))

        Dropdown:BuildDropdownList()
        Dropdown:Display()

        local Defaults = {}

        if type(Info.Default) == 'string' then
            local DefaultIndex = table.find(Dropdown.Values, Info.Default)
            if DefaultIndex then
                table.insert(Defaults, DefaultIndex)
            end
        elseif type(Info.Default) == 'table' then
            for _, Value in next, Info.Default do
                local DefaultIndex = table.find(Dropdown.Values, Value)
                if DefaultIndex then
                    table.insert(Defaults, DefaultIndex)
                end
            end
        elseif type(Info.Default) == 'number' and Dropdown.Values[Info.Default] ~= nil then
            table.insert(Defaults, Info.Default)
        end

        if next(Defaults) then
            for i = 1, #Defaults do
                local Index = Defaults[i]
                if Info.Multi then
                    Dropdown.Value[Dropdown.Values[Index]] = true
                else
                    Dropdown.Value = Dropdown.Values[Index]
                end

                if not Info.Multi then
                    break
                end
            end

            Dropdown:Display()
        end

        Groupbox:AddBlank(Info.BlankSize or 2)
        Groupbox:Resize()

        if Info.SpecialType == 'Player' then
            Library.PlayerDropdowns = Library.PlayerDropdowns or setmetatable({}, { __mode = 'k' })
            Library.PlayerDropdowns[Dropdown] = ListOuter
        end
        Options[Idx] = Dropdown
        Library:RegisterControl(Idx, Dropdown, Groupbox, Info.Text, DropdownOuter)

        return Dropdown
    end

