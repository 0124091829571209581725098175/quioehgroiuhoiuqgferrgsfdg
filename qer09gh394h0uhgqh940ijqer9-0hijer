        local cur = Options.whitelist_select.Value or {}
        local dict = {}
        for k,v in pairs(cur) do if k ~= player.Name then dict[k] = v end end
        Options.whitelist_select:SetValue(dict)
    end
    if Options and Options.israel_whitelist_select then
        local cur = Options.israel_whitelist_select.Value or {}
        local dict = {}
        for k,v in pairs(cur) do if k ~= player.Name then dict[k] = v end end
        Options.israel_whitelist_select:SetValue(dict)
    end
    if Library.ScriptData and Library.ScriptData.IsraelWhitelist then Library.ScriptData.IsraelWhitelist[player] = nil end
    local pd = Library.PhongData or (getgenv and (getgenv().PhowgData or getgenv().Data)) or nil
    if pd then
        if pd.FullWhitelist then pd.FullWhitelist[player] = nil end
        if pd.RageWhitelist then pd.RageWhitelist[player] = nil end
        if pd.IsraelWhitelist then pd.IsraelWhitelist[player] = nil end
        if pd.SilentAimStickyTargets then pd.SilentAimStickyTargets[player] = nil end
        if pd.SilentAimStickyTarget == player then pd.SilentAimStickyTarget = nil end
        if pd.SilentAimTarget == player then pd.SilentAimTarget = nil pd.SilentAimPos = nil pd.SilentAimHitPart = nil end
        if pd.LockedTargets then pd.LockedTargets[player] = nil end
        if pd.DropdownTargets then pd.DropdownTargets[player] = nil end
        if pd.AssistLockedTarget == player then pd.AssistLockedTarget = nil pd.AssistAimPos = nil pd.AssistAimPart = nil end
        if pd.SingleLockedTarget == player then pd.SingleLockedTarget = nil end
        if pd.CurrentActionTarget == player then pd.CurrentActionTarget = nil end
        if pd.CurrentMainTarget == player then pd.CurrentMainTarget = nil end
        pd.TargetListCache = nil
    end
    if Library.OnSilentWhitelist then pcall(Library.OnSilentWhitelist, player) end
    if Library.OnStickyWhitelist then pcall(Library.OnStickyWhitelist, player) end
    local pf = getgenv and getgenv().PhowgFunc or nil
    if pf then
        if pf.purgesilentwhitelisted then pcall(pf.purgesilentwhitelisted) end
        if pf.updatetargetlabel then pcall(pf.updatetargetlabel) end
        if pf.updatetracers then pcall(pf.updatetracers) end
    end
    if not quiet then Library:Notify("unwhitelisted " .. player.Name, 2) end
end
function Library:UnwhitelistCrew(player)
    Options = Options or (getgenv and getgenv().Options) or nil
    Toggles = Toggles or (getgenv and getgenv().Toggles) or nil
    local cid = Library:GetCrewName(player)
    if not cid then Library:UnwhitelistFully(player) return end
    local pd = Library.PhongData or (getgenv and (getgenv().PhowgData or getgenv().Data)) or nil
    if pd and pd.WhitelistedCrews then
        pd.WhitelistedCrews[tostring(cid)] = nil
        pd.TargetListCache = nil
    end
    local members = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if Library:GetCrewName(p) == cid then members[#members + 1] = p end
    end
    for _, p in ipairs(members) do
        Library:UnwhitelistFully(p, #members > 1)
    end
    if #members > 1 then
        Library:Notify("unwhitelisted crew " .. tostring(Library:GetCrewGroupName(cid)), 2)
    end
end
function Library:ShowPlayerContextMenu(target, position)
    self:ClosePopups()
    if self.PlayerContextMenu then self.PlayerContextMenu:Destroy() end
    local menu = self:Create('Frame', {Name = 'PlayerContext', Parent = ScreenGui, BackgroundColor3 = self.BackgroundColor, BorderColor3 = self.OutlineColor, BorderSizePixel = 0, Size = UDim2.fromOffset(208, 0), ZIndex = 90})
    self:AddToRegistry(menu, {BackgroundColor3 = 'BackgroundColor', BorderColor3 = 'OutlineColor'})
    self:StyleControl(menu, menu, 1)
    self:ApplyScaleTo(menu)
    local connection
    local function close() if menu.Parent then menu:Destroy() end end
    menu.Destroying:Connect(function()
        if connection then connection:Disconnect(); connection = nil end
        if self.PlayerContextMenu == menu then self.PlayerContextMenu = nil end
        self.OpenedFrames[menu] = nil
        if self.PopupClosers then self.PopupClosers[menu] = nil end
    end)
    local title = self:CreateLabel({Parent = menu, Text = self:PlayerDisplayName(target), TextSize = 12, TextTruncate = Enum.TextTruncate.AtEnd, TextXAlignment = Enum.TextXAlignment.Left, Position = UDim2.fromOffset(8, 4), Size = UDim2.new(1, -16, 0, 20), ZIndex = 92})
    title.TextTransparency = 0.3
    local count = 0
    local function action(name, callback)
        count = count + 1
        local button = self:Create('TextButton', {Name = name, Parent = menu, Text = name, Font = self.Font, TextSize = 12, TextColor3 = self.FontColor, TextXAlignment = Enum.TextXAlignment.Left, BackgroundColor3 = self.MainColor, BorderColor3 = self.OutlineColor, BorderSizePixel = 0, AutoButtonColor = false, Position = UDim2.fromOffset(4, 26 + (count - 1) * 28), Size = UDim2.new(1, -8, 0, 26), ZIndex = 92})
        self:Create('UIPadding', {Parent = button, PaddingLeft = UDim.new(0, 7)})
        self:AddToRegistry(button, {BackgroundColor3 = 'MainColor', BorderColor3 = 'OutlineColor', TextColor3 = 'FontColor'})
        self:StyleControl(button, button, 1)
        button.Activated:Connect(function() close(); self:SafeCallback(callback) end)
    end
    action('Teleport', function() self:TeleportToPlayer(target) end)
    action('Copy username', function() pcall(setclipboard, target.Name); self:Notify('Copied @' .. target.Name, 2) end)
    action('Copy display name', function() pcall(setclipboard, target.DisplayName); self:Notify('Copied ' .. target.DisplayName, 2) end)
    local whitelisted = self:IsFullyWhitelisted(target)
    local crew = self:GetCrewName(target)
    if not whitelisted and crew and self.PhongData and self.PhongData.WhitelistedCrews then whitelisted = self.PhongData.WhitelistedCrews[tostring(crew)] == true end
    if whitelisted then
        action('Unwhitelist player', function() self:UnwhitelistFully(target) end)
        action('Unwhitelist crew', function() self:UnwhitelistCrew(target) end)
    else
        action('Whitelist player', function() self:WhitelistFully(target) end)
        action('Whitelist crew', function() self:WhitelistCrew(target) end)
    end
    menu.Size = UDim2.fromOffset(208, 30 + count * 28)
    local scale, viewport = math.max(self.UIScale or 1, 0.01), ScreenGui.AbsoluteSize
    menu.Position = UDim2.fromOffset(math.clamp(position.X, 8, math.max(8, viewport.X - 208 * scale - 8)), math.clamp(position.Y, 8, math.max(8, viewport.Y - menu.Size.Y.Offset * scale - 8)))
    self.PlayerContextMenu, self.OpenedFrames[menu] = menu, true
    self.PopupClosers = self.PopupClosers or {}
    self.PopupClosers[menu] = close
    connection = InputService.InputBegan:Connect(function(input)
        if not self:IsClickInput(input) and input.UserInputType ~= Enum.UserInputType.MouseButton2 then return end
        local point, origin, size = input.Position, menu.AbsolutePosition, menu.AbsoluteSize
        if point.X < origin.X or point.X > origin.X + size.X or point.Y < origin.Y or point.Y > origin.Y + size.Y then close() end
    end)
    task.delay(5, function() if self.PlayerContextMenu == menu then close() end end)
end

