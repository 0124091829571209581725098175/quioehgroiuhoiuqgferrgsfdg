local function SplitNotifyWords(Text)
    local Safe = Text:gsub('&', '&amp;'):gsub('<', '&lt;'):gsub('>', '&gt;');
    local Words = {};

    for Word in Safe:gmatch('%S+') do
        table.insert(Words, Word);
    end;

    return Words;
end;

