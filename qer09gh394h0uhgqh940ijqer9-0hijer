function Library:PumpThumbs()
    while Library.ThumbActive < 6 and #Library.ThumbQueue > 0 do
        local job = table.remove(Library.ThumbQueue, 1)
        Library.ThumbActive = Library.ThumbActive + 1
        task.spawn(function()
            local ok, th = pcall(function()
                return Players:GetUserThumbnailAsync(job[1], Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size48x48)
            end)
            if ok and th and th ~= '' then
                Library.ThumbnailCache[job[1]] = th
                if job[2].Parent then
                    job[2].Image = th
                end
            end
            Library.ThumbActive = Library.ThumbActive - 1
            Library:PumpThumbs()
        end)
    end
end
function Library:FetchThumbnail(userId, avatar)
    if Library.ThumbnailCache[userId] then
        if avatar.Parent then
            avatar.Image = Library.ThumbnailCache[userId]
