Library.ControlTweens = {};
Library.ControlTweenGoals = {};
function Library:AnimateControl(Target, Properties)
    local Previous = Library.ControlTweens[Target];
    local Goal = Library.ControlTweenGoals[Target];
    if Previous and Goal and not Library.ReducedMotion then
        local SameGoal = true;
        for Property, Value in pairs(Properties) do
            if Goal[Property] ~= Value then SameGoal = false; break end;
        end;
        if SameGoal then
            for Property in pairs(Goal) do
                if Properties[Property] == nil then SameGoal = false; break end;
            end;
        end;
        if SameGoal then return end;
    end;
    if Previous then Previous:Cancel(); Library.ControlTweens[Target] = nil end;
    Library.ControlTweenGoals[Target] = nil;
    local Changed = false;
    for Property, Value in pairs(Properties) do
        if Target[Property] ~= Value then Changed = true; break end;
    end;
    if not Changed then return end;
    if Library.ReducedMotion then
        for Property, Value in pairs(Properties) do Target[Property] = Value end;
        return;
    end;
    local Tween = TweenService:Create(Target, TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), Properties);
    Library.ControlTweens[Target] = Tween;
    Library.ControlTweenGoals[Target] = table.clone(Properties);
    Tween.Completed:Once(function()
        if Library.ControlTweens[Target] == Tween then
            Library.ControlTweens[Target] = nil;
            Library.ControlTweenGoals[Target] = nil;
        end;
    end);
    Tween:Play();
end;
function Library:StyleControl(Outer, Inner, Radius, Region)
    if Inner:FindFirstChild('ControlStroke') then return end;
    Outer.BorderSizePixel = 0;
    Inner.BorderSizePixel = 0;
    if Outer ~= Inner then Outer.BackgroundTransparency = 1 end;
    for _, Surface in ipairs(Outer == Inner and {Inner} or {Outer, Inner}) do
        if not Surface:FindFirstChildOfClass('UICorner') then
            Library:Create('UICorner', {CornerRadius = UDim.new(0, math.min(Radius or 7, Library.ClassicEnabled and 1 or 14)); Parent = Surface;});
        end;
    end;
    local Stroke = Library:Create('UIStroke', {
        Name = 'ControlStroke';
        Color = Inner.BorderColor3;
        Thickness = 1;
        Transparency = 0.25;
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border;
        Parent = Inner;
    });
    local Hovered, Focused, Pressed = false, false, false;
    local function CurrentColor()
        local IdleColor = Inner.BorderColor3 == Library.Black and Library.OutlineColor or Inner.BorderColor3;
        return (Hovered or Focused or Outer.BorderColor3 == Library.AccentColor) and Library.AccentColor or IdleColor;
    end;
    Library:AddToRegistry(Stroke, {Color = CurrentColor;});
    local function UpdateColor()
        Stroke.Color = CurrentColor();
    end;
    local function UpdateInteraction()
        UpdateColor();
        Library:AnimateControl(Stroke, {Transparency = Pressed and 0 or ((Hovered or Focused) and 0.05 or 0.25); Thickness = Pressed and 1.4 or 1;});
    end;
    Inner:GetPropertyChangedSignal('BorderColor3'):Connect(UpdateColor);
    if Outer ~= Inner then Outer:GetPropertyChangedSignal('BorderColor3'):Connect(UpdateColor) end;
    local HitRegion = Region or Outer;
    HitRegion.MouseEnter:Connect(function() Hovered = true; UpdateInteraction() end);
    HitRegion.MouseLeave:Connect(function() Hovered = false; Pressed = false; UpdateInteraction() end);
    HitRegion.InputBegan:Connect(function(Input)
        if Library:IsClickInput(Input) then Pressed = true; UpdateInteraction() end;
    end);
    HitRegion.InputEnded:Connect(function(Input)
        if Library:IsClickInput(Input, true) then Pressed = false; UpdateInteraction() end;
    end);
    local function HookTextBox(Box)
        if not Box:IsA('TextBox') then return end;
        Box.Focused:Connect(function() Focused = true; UpdateInteraction() end);
        Box.FocusLost:Connect(function() Focused = false; UpdateInteraction() end);
    end;
    for _, Child in ipairs(Inner:GetDescendants()) do HookTextBox(Child) end;
    Inner.DescendantAdded:Connect(HookTextBox);
    Inner.Destroying:Connect(function()
        local Tween = Library.ControlTweens[Stroke];
        if Tween then Tween:Cancel(); Library.ControlTweens[Stroke] = nil end;
        Library.ControlTweenGoals[Stroke] = nil;
    end);
    UpdateColor();
    return Stroke;
end;
