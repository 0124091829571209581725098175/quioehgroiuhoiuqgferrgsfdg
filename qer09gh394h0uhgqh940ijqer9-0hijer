    end
    self.WorkspaceRows[row] = reflow
    local lastWidth
    row:GetPropertyChangedSignal('AbsoluteSize'):Connect(function()
        local width = row.AbsoluteSize.X
        if lastWidth == width then return end
        lastWidth = width
        reflow()
    end)
    reflow()
    if owner.Resize then owner:Resize() end
    return row
end

do
    local originalButton, originalLabel = BaseGroupbox.__index.AddButton, BaseGroupbox.__index.AddLabel
