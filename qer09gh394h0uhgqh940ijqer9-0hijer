    local function selectNav(object, selected)
        if memberships[object] then
            local key = selected and 'AccentColor' or 'FontColor'
            Library:AnimateControl(object, { TextTransparency = selected and 0 or 0.2 })
            object.TextColor3 = Library[key]
            Library.RegistryMap[object].Properties.TextColor3 = key
            return
        end
        if selected then
            local scale = math.max(Library.UIScale or 1, 0.01)
            local x = (object.AbsolutePosition.X - nav.AbsolutePosition.X) / scale + nav.CanvasPosition.X
            local width, visibleWidth = object.AbsoluteSize.X / scale, nav.AbsoluteSize.X / scale
            if x < nav.CanvasPosition.X then
                nav.CanvasPosition = Vector2.new(math.max(0, x - 4), 0)
            elseif x + width > nav.CanvasPosition.X + visibleWidth then
                nav.CanvasPosition = Vector2.new(math.max(0, x + width - visibleWidth + 4), 0)
            end
        end
        local key = selected and 'AccentColor' or 'FontColor'
        local caption = object:FindFirstChild('NavigationLabel')
        if caption then
            Library:AnimateControl(caption, { TextTransparency = selected and 0 or 0.2 })
            caption.TextColor3 = Library[key]
            Library.RegistryMap[caption].Properties.TextColor3 = key
        end
        local icon = object:FindFirstChild('NavigationIcon')
        if icon then
            for _, child in ipairs(icon:GetDescendants()) do
                local property = child:IsA('UIStroke') and 'Color'
                    or child:IsA('ImageLabel') and 'ImageColor3'
                    or child:IsA('Frame') and child.BackgroundTransparency == 0 and 'BackgroundColor3'
                if property and Library.RegistryMap[child] then
                    child[property] = Library[key]
                    Library.RegistryMap[child].Properties[property] = key
                end
            end
        end
    end
