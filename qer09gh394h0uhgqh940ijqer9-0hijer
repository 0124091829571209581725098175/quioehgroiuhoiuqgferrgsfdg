Library.NotificationEntries = {}
Library.NotificationSequence = 0
local function NotificationText(Text, Style)
    local Plain = Library:NotificationMessage(Text)
    if Style == 'Simple' or Style == 'Gamesensical' then
        local index, hex = 0, NotifyAccentHex()
        local rich = Plain:gsub('%S+', function(word)
            index += 1
            local safe = word:gsub('&', '&amp;'):gsub('<', '&lt;'):gsub('>', '&gt;')
            local colored = Style == 'Simple' and index % 2 == 0
                or Style == 'Gamesensical' and (index == 2 or index == 5 or index == 7)
            return colored and ('<font color="#' .. hex .. '">' .. safe .. '</font>') or safe
        end)
        return rich, Plain
    end
    local Safe = Plain:gsub('&', '&amp;'):gsub('<', '&lt;'):gsub('>', '&gt;')
    local Prefix, Body = Safe:match('^(%[[^%]]+%])%s*(.*)$')
    Prefix, Body = Prefix or '', Body or Safe
    Body = Body:gsub('UNSYNCED', '<font color="#C86173">UNSYNCED</font>')
    Body = Body:gsub('(landed on )(.+)( for [%d%.]+ damage)', '%1<font color="#83BD80">%2</font>%3')
    Body = Body:gsub('^(hit )(.+)( for [%d%.]+ damage)', '%1<font color="#83BD80">%2</font>%3')
    return '<font color="#A0A0A8">' .. Prefix .. '</font> ' .. Body, Plain
end
function Library:RefreshNotifications()
    if self.Unloaded or self.NotificationReflowing or not self.NotificationArea then
        return
    end
    self.NotificationReflowing = true
    local screen = ScreenGui.AbsoluteSize
    if screen.X < 100 or screen.Y < 100 then
        screen = workspace.CurrentCamera and workspace.CurrentCamera.ViewportSize or Vector2.new(1280, 720)
    end
    local scale = math.max(self.UIScale or 1, 0.01)
    local position = self.NotificationPosition or 'Bottom'
    local top = position:find('Top', 1, true) ~= nil
    local margin = top and math.min(60, screen.Y * 0.1) or math.min(200, screen.Y * 0.25)
    local maxWidth = math.max(80, math.min(720, (screen.X - 32) / scale))
    local maxHeight = math.max(40, (screen.Y - margin - 16) / scale)
    local left, right = position:find('Left', 1, true), position:find('Right', 1, true)
    local area, layout = self.NotificationArea, self.NotificationLayout
    area.AnchorPoint = Vector2.new(left and 0 or right and 1 or 0.5, top and 0 or 1)
    area.Position = UDim2.new(
        left and 0 or right and 1 or 0.5,
        left and 16 or right and -16 or 0,
        top and 0 or 1,
        top and margin or -margin
    )
    area.Size = UDim2.fromOffset(maxWidth, maxHeight)
    layout.HorizontalAlignment = left and Enum.HorizontalAlignment.Left
        or right and Enum.HorizontalAlignment.Right
        or Enum.HorizontalAlignment.Center
    layout.VerticalAlignment = top and Enum.VerticalAlignment.Top or Enum.VerticalAlignment.Bottom
    layout.Padding = UDim.new(0, 4)
    local entries = {}
    for entry in pairs(self.NotificationEntries) do
        if entry.Closed or not entry.Frame.Parent then
            self.NotificationEntries[entry] = nil
        else
            entries[#entries + 1] = entry
        end
    end
    table.sort(entries, function(a, b)
        return a.Order > b.Order
    end)
    local transient = 0
    for _, entry in ipairs(entries) do
        if not entry.Persistent then
            transient += 1
            if transient > 32 then
                entry:Destroy()
            end
        end
    end
    local used, visible = 0, 0
    for _, entry in ipairs(entries) do
        if not entry.Closed then
            local hasProgress = type(entry.Fraction) == 'number'
            if
                entry.Dirty
                or entry.LayoutWidth ~= maxWidth
                or entry.LayoutHeight ~= maxHeight
                or entry.MeasuredFont ~= entry.Label.Font
                or entry.MeasuredSize ~= entry.Label.TextSize
            then
                local extra = entry.CanDismiss and 20 or 0
                local natural = self:GetTextBounds(entry.Plain, entry.Label.Font, entry.Label.TextSize)
                local minimum = entry.Actions and 240 or 100
                local width = math.clamp(math.ceil(natural) + 16 + extra, math.min(minimum, maxWidth), maxWidth)
                local footer = (hasProgress and 4 or 0) + (entry.Actions and 26 or 0)
                local body = math.max(16, math.ceil(entry.Label.TextSize) + 4)
                local height = body + 8 + footer
                entry.Frame.Size = UDim2.fromOffset(width, height)
                entry.Label.Position, entry.Label.Size = UDim2.fromOffset(8, 4), UDim2.new(1, -16 - extra, 0, body)
                if entry.Track then
                    entry.Track.Visible = hasProgress
                    entry.Track.Position = UDim2.fromOffset(8, body + 7)
                end
                if entry.Actions then
                    entry.Actions.Position = UDim2.fromOffset(8, body + 8 + (hasProgress and 4 or 0))
                end
                entry.Height, entry.LayoutWidth, entry.LayoutHeight, entry.MeasuredFont, entry.MeasuredSize, entry.Dirty =
                    height, maxWidth, maxHeight, entry.Label.Font, entry.Label.TextSize, false
            end
            if hasProgress then
                entry.Fill.Size = UDim2.fromScale(entry.Fraction, 1)
            end
            local gap = visible > 0 and 4 or 0
            local show = visible < 6 and used + gap + entry.Height <= maxHeight
            entry.Frame.Visible = show
            if show then
                used += entry.Height + gap
                visible += 1
            end
        end
    end
    self.NotificationReflowing = false
end
