                self:StyleControl(row, row, 1)
                local current = server.id == game.JobId
                local details = server.playing
                    .. '/'
                    .. server.maxPlayers
                    .. ' players | '
                    .. (server.ping and math.floor(server.ping) .. ' ms' or 'Ping unavailable')
                    .. (server.fps and ' | ' .. math.floor(server.fps) .. ' FPS' or '')
                    .. (current and ' | Current' or '')
                text(row, 'Details', details, UDim2.fromOffset(8, 0), UDim2.new(1, -116, 1, 0))
                button(row, 'CopyId', 'ID', UDim2.new(1, -102, 0, 7), UDim2.fromOffset(40, 26), function()
                    pcall(setclipboard, server.id)
                    self:Notify('Copied JobId', 2)
                end)
                if not current then
                    button(row, 'Join', 'Join', UDim2.new(1, -56, 0, 7), UDim2.fromOffset(48, 26), function()
                        doTeleport(server.id)
                    end)
                end
            end
            if #rows == 0 then
                text(
                    serverList,
                    'EmptyServers',
                    state.Loaded and 'No public servers returned' or 'No server results yet',
                    UDim2.fromOffset(0, 0),
                    UDim2.new(1, 0, 0, 28)
                )
            end
            more.Visible = state.Cursor ~= nil and not state.Requesting
            resizeServers()
        end
        start = function(append)
            if state.Requesting or self.Unloaded then
                return
            end
            state.Token = state.Token + 1
            local token, cursor = state.Token, append and state.Cursor or nil
            state.Requesting, state.Error = true, nil
            scan.Text, status.Text, more.Visible = 'Cancel', 'Scanning public servers...', false
            task.spawn(function()
                local rows, seen, cursors =
                    append and table.clone(state.Rows) or {}, append and table.clone(state.Seen) or {}, {}
                if cursor then
                    cursors[cursor] = true
                end
                for page = 1, 5 do
                    if token ~= state.Token or self.Unloaded then
                        return
                    end
                    local url = 'https://games.roblox.com/v1/games/'
                        .. game.PlaceId
                        .. '/servers/Public?sortOrder=Desc&limit=100'
                    if cursor then
                        url = url .. '&cursor=' .. http:UrlEncode(cursor)
                    end
                    local data, problem
                    for attempt = 1, 3 do
                        if token ~= state.Token or self.Unloaded then
                            return
                        end
                        local ok, result = pcall(function()
                            local response = game:HttpGet(url)
                            local decoded = http:JSONDecode(response)
                            assert(
                                type(decoded) == 'table' and type(decoded.data) == 'table',
                                'Invalid server response'
                            )
                            return decoded
                        end)
                        if ok then
                            data = result
                            break
                        end
                        problem = tostring(result)
                        if attempt < 3 then
                            task.wait(attempt * 0.5)
                        end
                    end
                    if token ~= state.Token or self.Unloaded then
                        return
                    end
                    if not data then
                        state.Requesting, state.Error = false, problem
                        scan.Text = 'retry'
                        status.Text = 'scan failed; select retry'
                            .. (#state.Rows > 0 and ' | Previous results kept' or '')
                        more.Visible = state.Cursor ~= nil
                        return
                    end
                    for _, server in ipairs(data.data) do
                        if
                            type(server) == 'table'
                            and type(server.id) == 'string'
                            and server.id ~= ''
                            and type(server.playing) == 'number'
                            and type(server.maxPlayers) == 'number'
                            and server.playing >= 0
                            and server.maxPlayers > 0
                            and not seen[server.id]
                        then
                            seen[server.id] = true
                            rows[#rows + 1] = {
                                id = server.id,
                                playing = server.playing,
                                maxPlayers = server.maxPlayers,
                                ping = type(server.ping) == 'number' and server.ping >= 0 and server.ping or nil,
                                fps = type(server.fps) == 'number' and server.fps >= 0 and server.fps or nil,
                            }
                        end
                    end
                    cursor = type(data.nextPageCursor) == 'string' and data.nextPageCursor ~= '' and data.nextPageCursor
                        or nil
                    if cursor and cursors[cursor] then
                        cursor = nil
                    end
                    if cursor then
                        cursors[cursor] = true
                    end
                    state.Rows, state.Seen, state.Cursor, state.Loaded = rows, seen, cursor, true
                    render()
                    status.Text = 'scanning... ' .. #rows .. ' servers'
                    if not cursor then
                        break
                    end
                end
                if token ~= state.Token or self.Unloaded then
                    return
                end
                state.Requesting = false
                scan.Text, status.Text =
                    'scan', #state.Rows .. ' servers' .. (state.Cursor and ' | More available' or ' | Scan complete')
                render()
            end)
        end
        Window.ScanServers, Window.RenderServers = start, render
        Window.RefreshCustom.Servers = function()
            serverCount.Text = 'current server: '
