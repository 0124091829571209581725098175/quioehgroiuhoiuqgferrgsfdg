function Library:QueueUIWork(key, callback, slot)
    if self.Unloaded then
        return
    end
    slot = slot or 'default'
    local queue = self.UIWork
    if not queue then
        queue = { Items = {}, Keys = {}, Head = 1, Tail = 0 }
        self.UIWork = queue
    end
    local slots = queue.Keys[key]
    if not slots then
        slots = {}
        queue.Keys[key] = slots
    end
    if slots[slot] then
        slots[slot].Callback = callback
        slots[slot].Revision += 1
        return
    end
    local item = { Key = key, Slot = slot, Callback = callback, Revision = 1 }
    slots[slot] = item
    queue.Tail += 1
    queue.Items[queue.Tail] = item
    if queue.Worker then
        return
    end
    queue.Worker = task.defer(function()
        while queue.Head <= queue.Tail and not self.Unloaded do
            task.wait()
            local started, count = os.clock(), 0
            while queue.Head <= queue.Tail and count < 4 and os.clock() - started < 0.002 and not self.Unloaded do
                local entry = queue.Items[queue.Head]
                queue.Items[queue.Head] = nil
                queue.Head += 1
                local fields = queue.Keys[entry.Key]
                count += 1
                local callback = entry.Callback
                local revision = entry.Revision
                entry.Running = true
                local ok, problem = pcall(callback)
                entry.Running = false
                if not ok and not self.Unloaded then
                    warn('[phowg] interface work: ' .. tostring(problem))
                end
                if self.Unloaded then
                    break
                end
                if entry.Revision ~= revision then
                    queue.Tail += 1
                    queue.Items[queue.Tail] = entry
                elseif fields then
                    fields[entry.Slot] = nil
                    if not next(fields) then
                        queue.Keys[entry.Key] = nil
                    end
                end
            end
        end
        table.clear(queue.Items)
        table.clear(queue.Keys)
        queue.Head, queue.Tail, queue.Worker = 1, 0, nil
    end)
end
function Library:RunCallback(callback, ...)
    if not callback then
        return true
    end
    local result = table.pack(pcall(callback, ...))
    if not result[1] then
        local problem = tostring(result[2])
        if self.CallbackErrorSink then
            self.CallbackErrorSink(problem)
        end
        return false, problem
    end
    return true, table.unpack(result, 2, result.n)
end
function Library:FlushDeferredLayouts(immediate)
    local pending = self.PendingLayouts
    self.PendingLayouts = nil
    for owner in pairs(pending or {}) do
        local function resize()
            if owner.Container and not owner.Container.Parent then
                return
            end
            owner.LayoutFlushing = true
            local ok, problem = pcall(owner.Resize, owner)
            owner.LayoutFlushing = false
            if not ok then
                error(problem)
            end
        end
        if immediate then
            local ok, problem = pcall(resize)
            if not ok then
                warn('[phowg] config layout: ' .. tostring(problem))
            end
        else
            self:QueueUIWork(owner, resize, 'layout')
        end
    end
end
function Library:RefreshVisiblePlayerDropdowns()
    local dirty = false
    for control, frame in pairs(self.PlayerDropdowns or {}) do
        if control.ListDirty then
            dirty = true
            if frame.Parent and self.IsControlVisible and self:IsControlVisible(frame) and control.BuildList then
                self:QueueUIWork(control, function()
                    if frame.Parent and self:IsControlVisible(frame) then
                        control:BuildList()
                    end
                end, 'roster')
            end
        end
    end
    if dirty and self.MainVisible and not self.ConfigLoading and not self.PlayerListTimer and not self.Unloaded then
        self.PlayerListTimer = task.delay(0.2, function()
            self.PlayerListTimer = nil
            if not self.Unloaded and self.MainVisible then
                self:RefreshVisiblePlayerDropdowns()
            end
        end)
    end
end
function Library:SafeCallback(f, ...)
    if not f then
        return
    end

    if not Library.NotifyOnError then
        return f(...)
    end

    local success, event = self:RunCallback(f, ...)

    if not success then
        local _, i = event:find(':%d+: ')

        if not i then
            return Library:Notify(event)
        end

        return Library:Notify(event:sub(i + 1), 3)
    end
    return nil
end

