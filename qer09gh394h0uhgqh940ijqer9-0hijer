    local function positionResults()
        local scale = math.max(Library.UIScale or 1, 0.01)
        local screen = ScreenGui.AbsoluteSize
        local width = math.min(430, math.max(140, (screen.X - 24) / scale))
        local height = math.min(results.CanvasSize.Y.Offset, math.max(60, (screen.Y - 32) / scale), 300)
        results.Size = UDim2.fromOffset(width, height)
        local point = searchOuter.AbsolutePosition - ScreenGui.AbsolutePosition
        results.Position = UDim2.fromOffset(math.clamp(point.X, 8, math.max(8, screen.X - width * scale - 8)), math.clamp(point.Y + searchOuter.AbsoluteSize.Y + 8, 8, math.max(8, screen.Y - height * scale - 8)))
