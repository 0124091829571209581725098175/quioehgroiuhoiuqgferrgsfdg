                text(row, 'Name', display, UDim2.fromOffset(57, 6), UDim2.new(1, -68, 0, 20))
                local crew = self:GetCrewName(player)
                local crewName = crew and self:GetCrewGroupName(crew) .. ' (' .. tostring(members[crew]) .. ')' or 'No crew'
                text(row, 'Details', crewName .. ' | ' .. self:FormatJoinedTime(player), UDim2.fromOffset(57, 28), UDim2.new(1, -68, 0, 16)).TextTransparency = 0.3
                local hit = self:Create('TextButton', {Parent = row, BackgroundTransparency = 1, Text = '', Size = UDim2.fromScale(1, 1), ZIndex = 9})
                hit.InputBegan:Connect(function(event)
                    if self:MouseIsOverOpenedFrame(row) then return end
                    if event.UserInputType == Enum.UserInputType.MouseButton2 then self:ShowPlayerContextMenu(player, Vector2.new(event.Position.X, event.Position.Y))
                    elseif self:IsClickInput(event) then self:TeleportToPlayer(player) end
                end)
            end
        end
        count.Text = 'Players: ' .. shown .. ' / ' .. #rows
        if shown == 0 then text(playerList, 'EmptyPlayers', 'No matching players', UDim2.fromOffset(0, 0), UDim2.new(1, 0, 0, 28)) end
        resizePlayers()
    end
    for _, player in ipairs(Players:GetPlayers()) do
        self.PlayerJoinTimes[player] = self.PlayerJoinTimes[player] or tick()
        self.PlayerJoinTimes[player.UserId] = self.PlayerJoinTimes[player.UserId] or self.PlayerJoinTimes[player]
    end
    self:AddToolTip('Click a player to teleport. Right-click for player actions.', playerList)
    Window.RefreshCustom.Players = refreshPlayers
    local pending = false
    local function queuePlayers()
        if pending or self.Unloaded then return end
        pending = true
        task.delay(0.1, function() pending = false; if playersPanel.Visible and not self.Unloaded then refreshPlayers() end end)
    end
    search:GetPropertyChangedSignal('Text'):Connect(queuePlayers)
    self.PlayerRefreshFns = self.PlayerRefreshFns or {}
    table.insert(self.PlayerRefreshFns, queuePlayers)
    self:GiveSignal(Players.PlayerAdded:Connect(function(player)
        self.PlayerJoinTimes[player], self.PlayerJoinTimes[player.UserId] = tick(), tick()
        queuePlayers()
    end))
    self:GiveSignal(Players.PlayerRemoving:Connect(function(player)
        if self.Spectating == player then
            self.Spectating = nil
            local humanoid = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass('Humanoid')
            if workspace.CurrentCamera and humanoid then workspace.CurrentCamera.CameraSubject = humanoid end
        end
        queuePlayers()
    end))
    local serversPanel = panel('Servers')
    local serverCount = text(serversPanel, 'ServerCount', 'Public server browser', UDim2.fromOffset(0, 0), UDim2.new(1, 0, 0, 24))
    local state = {Rows = {}, Seen = {}, Token = 0, Requesting = false, Cursor = nil, Loaded = false}
    Window.ServerBrowser = state
    local serverList, resizeServers = list(serversPanel, 'ServerList', 118, 0, 4)
    local status = text(serversPanel, 'ScanStatus', 'Select Scan to load public servers', UDim2.fromOffset(0, 90), UDim2.new(1, -98, 0, 22))
    local scan, more, render, start
    button(serversPanel, 'Rejoin', 'Rejoin', UDim2.fromOffset(0, 30), UDim2.new(0.32, -4, 0, 28), function() doTeleport(game.JobId) end)
    button(serversPanel, 'Hop', 'Server hop', UDim2.new(0.32, 2, 0, 30), UDim2.new(0.34, -4, 0, 28), function() doTeleport() end)
    scan = button(serversPanel, 'Scan', 'Scan', UDim2.new(0.66, 2, 0, 30), UDim2.new(0.34, -2, 0, 28), function()
        if state.Requesting then state.Token = state.Token + 1; state.Requesting = false; scan.Text = 'Scan'; status.Text = 'Scan cancelled'; return end
        start(false)
    end)
    local sortMode, sortDirection
    sortMode = button(serversPanel, 'SortMode', 'Sort: Players', UDim2.fromOffset(0, 64), UDim2.new(0.5, -3, 0, 22), function()
        self.ServerSortMode = self.ServerSortMode == 'Players' and 'Ping' or 'Players'; render()
    end)
    sortDirection = button(serversPanel, 'SortDirection', 'Descending', UDim2.new(0.5, 3, 0, 64), UDim2.new(0.5, -3, 0, 22), function()
        self.ServerSortDesc = not self.ServerSortDesc; render()
    end)
    more = button(serversPanel, 'LoadMore', 'Load more', UDim2.new(1, -92, 0, 90), UDim2.fromOffset(92, 22), function() if not state.Requesting and state.Cursor then start(true) end end)
    more.Visible = false
    render = function()
        if self.Unloaded then return end
        clear(serverList)
        sortMode.Text = 'Sort: ' .. self.ServerSortMode
        sortDirection.Text = self.ServerSortDesc and 'Descending' or 'Ascending'
        local rows = table.clone(state.Rows)
        table.sort(rows, function(a, b)
            if self.ServerSortMode == 'Ping' and (a.ping == nil) ~= (b.ping == nil) then return a.ping ~= nil end
            local av = self.ServerSortMode == 'Ping' and (a.ping or math.huge) or a.playing
            local bv = self.ServerSortMode == 'Ping' and (b.ping or math.huge) or b.playing
            if av == bv then return a.id < b.id end
            return self.ServerSortDesc and av > bv or not self.ServerSortDesc and av < bv
        end)
        for _, server in ipairs(rows) do
            local row = self:Create('Frame', {Name = 'Server_' .. server.id, Parent = serverList, Size = UDim2.new(1, -6, 0, 40), BackgroundColor3 = self.MainColor, BorderColor3 = self.OutlineColor, BorderSizePixel = 0, ZIndex = 6})
            self:AddToRegistry(row, {BackgroundColor3 = 'MainColor', BorderColor3 = 'OutlineColor'}); self:StyleControl(row, row, 1)
            local current = server.id == game.JobId
            local details = server.playing .. '/' .. server.maxPlayers .. ' players | ' .. (server.ping and math.floor(server.ping) .. ' ms' or 'Ping unavailable') .. (server.fps and ' | ' .. math.floor(server.fps) .. ' FPS' or '') .. (current and ' | Current' or '')
            text(row, 'Details', details, UDim2.fromOffset(8, 0), UDim2.new(1, -116, 1, 0))
            button(row, 'CopyId', 'ID', UDim2.new(1, -102, 0, 7), UDim2.fromOffset(40, 26), function() pcall(setclipboard, server.id); self:Notify('Copied JobId', 2) end)
            if not current then button(row, 'Join', 'Join', UDim2.new(1, -56, 0, 7), UDim2.fromOffset(48, 26), function() doTeleport(server.id) end) end
        end
        if #rows == 0 then text(serverList, 'EmptyServers', state.Loaded and 'No public servers returned' or 'No server results yet', UDim2.fromOffset(0, 0), UDim2.new(1, 0, 0, 28)) end
        more.Visible = state.Cursor ~= nil and not state.Requesting
        resizeServers()
    end
    start = function(append)
        if state.Requesting or self.Unloaded then return end
        state.Token = state.Token + 1
        local token, cursor = state.Token, append and state.Cursor or nil
        state.Requesting, state.Error = true, nil
        scan.Text, status.Text, more.Visible = 'Cancel', 'Scanning public servers...', false
        task.spawn(function()
            local rows, seen, cursors = append and table.clone(state.Rows) or {}, append and table.clone(state.Seen) or {}, {}
            if cursor then cursors[cursor] = true end
            for page = 1, 5 do
                if token ~= state.Token or self.Unloaded then return end
                local url = 'https://games.roblox.com/v1/games/' .. game.PlaceId .. '/servers/Public?sortOrder=Desc&limit=100'
                if cursor then url = url .. '&cursor=' .. http:UrlEncode(cursor) end
                local data, problem
                for attempt = 1, 3 do
                    if token ~= state.Token or self.Unloaded then return end
                    local ok, result = pcall(function()
                        local response = game:HttpGet(url)
                        local decoded = http:JSONDecode(response)
                        assert(type(decoded) == 'table' and type(decoded.data) == 'table', 'Invalid server response')
                        return decoded
                    end)
                    if ok then data = result; break end
                    problem = tostring(result)
                    if attempt < 3 then task.wait(attempt * 0.5) end
                end
                if token ~= state.Token or self.Unloaded then return end
                if not data then
                    state.Requesting, state.Error = false, problem
                    scan.Text = 'Retry'
                    status.Text = 'Scan failed; select Retry' .. (#state.Rows > 0 and ' | Previous results kept' or '')
                    more.Visible = state.Cursor ~= nil
                    return
                end
                for _, server in ipairs(data.data) do
                    if type(server) == 'table' and type(server.id) == 'string' and server.id ~= '' and type(server.playing) == 'number' and type(server.maxPlayers) == 'number' and server.playing >= 0 and server.maxPlayers > 0 and not seen[server.id] then
                        seen[server.id] = true
                        rows[#rows + 1] = {id = server.id, playing = server.playing, maxPlayers = server.maxPlayers, ping = type(server.ping) == 'number' and server.ping >= 0 and server.ping or nil, fps = type(server.fps) == 'number' and server.fps >= 0 and server.fps or nil}
                    end
                end
                cursor = type(data.nextPageCursor) == 'string' and data.nextPageCursor ~= '' and data.nextPageCursor or nil
                if cursor and cursors[cursor] then cursor = nil end
                if cursor then cursors[cursor] = true end
                state.Rows, state.Seen, state.Cursor, state.Loaded = rows, seen, cursor, true
                render()
                status.Text = 'Scanning... ' .. #rows .. ' servers'
                if not cursor then break end
            end
            if token ~= state.Token or self.Unloaded then return end
            state.Requesting = false
            scan.Text, status.Text = 'Scan', #state.Rows .. ' servers' .. (state.Cursor and ' | More available' or ' | Scan complete')
            render()
        end)
    end
    Window.ScanServers, Window.RenderServers = start, render
    Window.RefreshCustom.Servers = function()
        serverCount.Text = 'Current server: ' .. #Players:GetPlayers() .. '/' .. tostring(Players.MaxPlayers or '?') .. ' players'
        render()
        if not state.Loaded and not state.Requesting then start(false) end
    end
    local executor = panel('Executor')
    local info, resizeInfo = list(executor, 'ExecutorInfo', 0, 0, 5)
    local gameName = game.Name
    pcall(function() gameName = game:GetService('MarketplaceService'):GetProductInfo(game.PlaceId).Name end)
    local function infoRow(name, value)
        local label = text(info, name, value, UDim2.fromOffset(0, 0), UDim2.new(1, -6, 0, 26))
        label.TextWrapped = true
        return label
    end
    infoRow('Game', 'Game: ' .. gameName)
    infoRow('PlaceId', 'Place ID: ' .. game.PlaceId)
    local job = infoRow('JobId', 'Job ID: ' .. tostring(game.JobId)); job.Size = UDim2.new(1, -6, 0, 42)
    local playerCount = infoRow('PlayerCount', 'Players: ...')
    local executorName = 'Unknown'
    pcall(function() if identifyexecutor then executorName = tostring(identifyexecutor()) end end)
    infoRow('ExecutorName', 'Executor: ' .. executorName)
    local fps, ping = infoRow('FPS', 'FPS: ...'), infoRow('Ping', 'Ping: ...')
    button(info, 'CopyPlaceId', 'Copy Place ID', UDim2.fromOffset(0, 0), UDim2.new(1, -6, 0, 28), function() pcall(setclipboard, tostring(game.PlaceId)); self:Notify('Copied PlaceId', 2) end)
    button(info, 'CopyJobId', 'Copy Job ID', UDim2.fromOffset(0, 0), UDim2.new(1, -6, 0, 28), function() pcall(setclipboard, tostring(game.JobId)); self:Notify('Copied JobId', 2) end)
    local join = input(info, 'JoinJobId', 'Paste Job ID...', UDim2.fromOffset(0, 0), UDim2.new(1, -6, 0, 30))
    button(info, 'JoinJobIdButton', 'Join Job ID', UDim2.fromOffset(0, 0), UDim2.new(1, -6, 0, 28), function()
        local id = join.Text:match('^%s*(.-)%s*$')
        if id == '' then self:Notify('Paste a JobId first', 2) else doTeleport(id) end
    end)
    Window.RefreshCustom.Executor = function() playerCount.Text = 'Players: ' .. #Players:GetPlayers() .. '/' .. tostring(Players.MaxPlayers or '?'); resizeInfo() end
    local statsConnection, elapsed, frames = nil, 0, 0
    executor:GetPropertyChangedSignal('Visible'):Connect(function()
        if statsConnection then statsConnection:Disconnect(); statsConnection = nil end
        elapsed, frames = 0, 0
        if not executor.Visible or self.Unloaded then return end
        statsConnection = RunService.RenderStepped:Connect(function(delta)
            elapsed, frames = elapsed + delta, frames + 1
            if elapsed < 0.5 then return end
            fps.Text = 'FPS: ' .. math.floor(frames / elapsed)
            local value
            pcall(function() value = game:GetService('Stats').Network.ServerStatsItem['Data Ping']:GetValue() end)
