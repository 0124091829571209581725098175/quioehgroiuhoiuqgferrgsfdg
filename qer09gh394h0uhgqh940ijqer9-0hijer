    if not humanoid or not workspace.CurrentCamera then
        self:Notify('Player has no character to view', 2)
        return
    end
    self:StopPlayerView()
    self.Spectating = target
    workspace.CurrentCamera.CameraSubject = humanoid
    local elapsed = 0
    self.PlayerViewConnections = {
        RunService.Heartbeat:Connect(function(delta)
            elapsed = elapsed + delta
            if elapsed < 0.25 then
                return
            end
            elapsed = 0
            if self.Unloaded or target.Parent ~= Players then
                self:StopPlayerView()
                return
            end
            local subject = target.Character and target.Character:FindFirstChildOfClass('Humanoid')
            local camera = workspace.CurrentCamera
            if camera and subject and camera.CameraSubject ~= subject then
                camera.CameraSubject = subject
            end
        end),
        Players.PlayerRemoving:Connect(function(player)
            if player == target then
                self:StopPlayerView()
            end
        end),
    }
end
