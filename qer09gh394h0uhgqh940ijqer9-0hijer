            Parent = parent,
            AnchorPoint = Vector2.new(0.5, 0.5),
            Position = UDim2.fromOffset((x + nx) * 0.5, (y + ny) * 0.5),
            Size = UDim2.fromOffset(math.sqrt(dx * dx + dy * dy), width),
            Rotation = math.deg(math.atan2(dy, dx)),
            BackgroundColor3 = color or Color3.new(1, 1, 1),
            BackgroundTransparency = 1 - alpha,
            BorderSizePixel = 0,
            ZIndex = z,
        })
        state.Tinted[#state.Tinted + 1] = { Object = object, Property = 'BackgroundColor3', Heat = 0.25 }
        return object
    end
    local function ellipse(radius, flatten, angle)
        local x, y = math.cos(angle) * radius, math.sin(angle) * radius * flatten
        return 480 + x * 0.985 + y * 0.169, 365 - x * 0.169 + y * 0.985
    end
    local accent = self.AccentColor or Color3.new(1, 1, 1)
    local function tint(doppler)
        local whiteness = math.clamp(doppler, 0, 1)
        return Color3.new(
            accent.R + (1 - accent.R) * whiteness,
            accent.G + (1 - accent.G) * whiteness,
            accent.B + (1 - accent.B) * whiteness
        )
    end
    for i = 1, 32 do
        create('Frame', {
            Parent = overlay,
            Position = UDim2.fromScale(noise(i + 1), noise(i + 401)),
            Size = UDim2.fromOffset(i % 13 == 0 and 2 or 1, i % 13 == 0 and 2 or 1),
            BackgroundColor3 = Color3.new(1, 1, 1),
            BackgroundTransparency = 0.55 + noise(i + 801) * 0.35,
            BorderSizePixel = 0,
            ZIndex = 2,
        })
    end
    state.Bands = {}
    for band = 1, 4 do
        local radius = 78 * (1.13 + band * 0.5)
        local holder = create('Frame', {
            Name = 'band ' .. band,
            Parent = scene,
            Position = UDim2.fromOffset(480, 360),
            Size = UDim2.fromOffset(0, 0),
            BackgroundTransparency = 1,
            BorderSizePixel = 0,
            ZIndex = 12,
        })
        state.Bands[band] = { Holder = holder, Speed = 0.17 / band ^ 1.4 }
        for segment = 0, 31 do
            local angle = segment * math.pi / 16
            local x, y = ellipse(radius, 0.205, angle)
            local nx, ny = ellipse(radius, 0.205, angle + math.pi / 16)
            local doppler = (0.5 + 0.5 * math.cos(angle - 0.4)) ^ 2
            line(
                holder,
                x - 480,
                y - 360,
                nx - 480,
                ny - 360,
                band < 3 and 1.6 or 0.8,
                math.clamp(
                    (0.5 - band * 0.09) * (0.6 + noise(segment + band * 41) * 0.4) * (0.75 + 0.75 * doppler),
                    0,
                    1
                ),
                12,
                tint(doppler)
            )
            state.Tinted[#state.Tinted].Heat = doppler
        end
    end
    for band = 1, 2 do
        for segment = 0, 23 do
            local angle = math.pi * (1.02 + segment * 0.96 / 24)
            local nextAngle = angle + math.pi * 0.96 / 24
            local rx, ry = 78 * (1.13 + band * 0.026), 78 * (1.17 + band * 0.028)
            line(
                scene,
                480 + math.cos(angle) * rx,
                356 + math.sin(angle) * ry,
                480 + math.cos(nextAngle) * rx,
                356 + math.sin(nextAngle) * ry,
                band == 1 and 1.7 or 3,
                band == 1 and 0.7 or 0.15,
                13
            )
        end
    end
    for i = 1, 28 do
        local radius = 78 * (1.17 + noise(i + 220) ^ 1.5 * 2.45)
        local width = 0.7 + noise(i + 88)
        state.Grains[i] = {
            Object = line(scene, 0, 0, 4, 0, width, 0.35 + noise(i + 21) * 0.5, 13),
            Tail = line(scene, 0, 0, 3, 0, width * 0.75, 0.45, 12),
            Radius = radius,
            Speed = 0.45 / (radius / 78) ^ 1.3,
            Phase = noise(i + 900) * math.pi * 2,
        }
    end
    for i = 1, 12 do
        state.Dust[i] = {
            Object = line(scene, 0, 0, 4, 0, 0.8, 0.2, 11),
            Seed = noise(i + 2401),
            Phase = noise(i + 2701) * math.pi * 2,
        }
    end
    local disk = create('Frame', {
        Name = 'event horizon',
        Parent = scene,
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.fromOffset(480, 360),
        Size = UDim2.fromOffset(156, 156),
        BackgroundColor3 = Color3.new(),
        BorderSizePixel = 0,
        ZIndex = 14,
    })
    create('UICorner', { Parent = disk, CornerRadius = UDim.new(1, 0) })
    state.GlowStrokes = {}
    for i = 1, 4 do
        local glow = create('Frame', {
            Parent = scene,
            AnchorPoint = Vector2.new(0.5, 0.5),
            Position = UDim2.fromOffset(480, 360),
            Size = UDim2.fromOffset(156 + i * 5, 156 + i * 5),
            BackgroundTransparency = 1,
            BorderSizePixel = 0,
            ZIndex = 15,
        })
        create('UICorner', { Parent = glow, CornerRadius = UDim.new(1, 0) })
        state.GlowStrokes[i] = create('UIStroke', {
            Parent = glow,
            Color = tint(0.35),
            Thickness = i == 1 and 1.2 or 3,
            Transparency = i == 1 and 0.18 or 0.86 + i * 0.025,
        })
    end
    local label = self:CreateLabel({
        Parent = overlay,
        Text = '',
        AnchorPoint = Vector2.new(0.5, 0),
        Position = UDim2.new(0.5, 0, 0.46, 174),
        Size = UDim2.fromOffset(320, 28),
        TextXAlignment = Enum.TextXAlignment.Center,
        TextSize = 20,
        ZIndex = 20,
    })
    state.Label = label
    label.Text = 'phowg host'
    label.MaxVisibleGraphemes = self.ReducedMotion and -1 or 0
    label.TextStrokeTransparency = 0.8
    state.RevealSweep = create('UIGradient', {
        Parent = label,
        Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0, Color3.fromRGB(170, 170, 170)),
            ColorSequenceKeypoint.new(0.5, Color3.new(1, 1, 1)),
            ColorSequenceKeypoint.new(1, Color3.fromRGB(170, 170, 170)),
        }),
        Offset = Vector2.new(-1, 0),
    })
    for _, grain in ipairs(state.Grains) do
        create('UIGradient', {
            Parent = grain.Tail,
            Transparency = NumberSequence.new(1, 0.25),
        })
    end
    local function draw(elapsed)
        local target = state.Progress or 0
        local delta = math.clamp(elapsed - (state.LastElapsed or elapsed), 0, 0.1)
        state.LastElapsed = elapsed
        state.DisplayProgress = self.ReducedMotion and target
            or state.DisplayProgress + (target - state.DisplayProgress) * (1 - math.exp(-delta * 14))
        if math.abs(target - state.DisplayProgress) < 0.002 then
            state.DisplayProgress = target
        end
        local status = state.StatusText .. '  ' .. tostring(math.round(state.DisplayProgress * 100)) .. '%'
        if state.Status.Text ~= status then
            state.Status.Text = status
        end
        label.MaxVisibleGraphemes = self.ReducedMotion and -1 or math.min(10, math.floor(elapsed / 0.052))
        state.RevealSweep.Enabled = not self.ReducedMotion and elapsed < 1.2
        if state.RevealSweep.Enabled then
            state.RevealSweep.Offset = Vector2.new(math.clamp(elapsed / 0.6 - 1, -1, 1), 0)
        end
        local currentAccent = self.AccentColor or accent
        if state.Accent ~= currentAccent then
            accent, state.Accent = currentAccent, currentAccent
            for _, item in ipairs(state.Tinted) do
                item.Object[item.Property] = tint(item.Heat)
            end
            state.Fill.BackgroundColor3, fillGlow.BackgroundColor3 = accent, tint(0.65)
            for _, stroke in ipairs(state.GlowStrokes) do
                stroke.Color = tint(0.35)
            end
            label.TextStrokeColor3 = accent
        end
        local size = overlay.AbsoluteSize
        local resized = state.ViewportSize ~= size
        if resized then
            state.ViewportSize = size
            if not state.Emitting then
                sceneScale.Scale = math.clamp(math.min(size.X / 960, size.Y / 720), 0.35, 1.25)
            end
        end
        if self.ReducedMotion then
            if state.Drawn and not resized then
                return
            end
            elapsed = 0
        end
        state.Drawn = true
        for _, band in ipairs(state.Bands) do
            band.Holder.Rotation = math.deg(elapsed * band.Speed)
        end
        local pulse = 0.5 + 0.5 * math.sin(elapsed * 1.35)
        for index, stroke in ipairs(state.GlowStrokes) do
            stroke.Thickness = (index == 1 and 1.2 or 3) + pulse * (index == 1 and 0.4 or 1.1)
            stroke.Transparency = (index == 1 and 0.18 or 0.86 + index * 0.025) - pulse * 0.05
        end
        fillGlow.BackgroundTransparency = self.ReducedMotion and 0.65 or 0.4 + pulse * 0.25
        for _, grain in ipairs(state.Grains) do
            local phase = grain.Phase + elapsed * grain.Speed
            local x, y = ellipse(grain.Radius, 0.205, phase)
            grain.Object.Position = UDim2.fromOffset(x, y)
            grain.Object.Rotation = math.deg(phase) + 80
            local tailPhase = phase - grain.Speed * 0.22
            local tx, ty = ellipse(grain.Radius, 0.205, tailPhase)
            local dx, dy = x - tx, y - ty
            grain.Tail.Position = UDim2.fromOffset((x + tx) * 0.5, (y + ty) * 0.5)
            grain.Tail.Size = UDim2.fromOffset(math.max(1, math.sqrt(dx * dx + dy * dy)), 0.8)
            grain.Tail.Rotation = math.deg(math.atan2(dy, dx))
            grain.Tail.BackgroundTransparency = self.ReducedMotion and 1 or 0.72 + 0.18 * (0.5 + 0.5 * math.sin(phase))
        end
        for _, dust in ipairs(state.Dust) do
            local travel = (dust.Seed + elapsed * 0.032) % 1
            local radius = 110 + (1 - travel) * 310
            local angle = dust.Phase + elapsed * 0.11 + math.log(radius / 78) * 1.7
            dust.Object.Position =
                UDim2.fromOffset(480 + math.cos(angle) * radius, 360 + math.sin(angle) * radius * 0.58)
            dust.Object.Rotation = math.deg(angle) + 65
            dust.Object.BackgroundTransparency = 1 - math.sin(travel * math.pi) * 0.3
        end
    end
    state.Connection = RunService.RenderStepped:Connect(function()
        if self.Unloaded or self.StartupIntro ~= state or not root.Parent then
            return
        end
        local now = os.clock()
        if now - state.RenderAt < 1 / 30 then
            return
        end
        state.RenderAt = now
        draw(now - state.At)
        local entry = state.WindowEntry
        if entry and entry.Object.Parent then
            local progress = self.ReducedMotion and 1 or math.clamp((now - entry.At) / 0.9, 0, 1)
            local t = 1 - (1 - progress) ^ 3
            local u = 1 - t
            local x = u * u * entry.Origin.X + 2 * u * t * entry.Control.X + t * t * entry.Destination.X
            local y = u * u * entry.Origin.Y + 2 * u * t * entry.Control.Y + t * t * entry.Destination.Y
            local scale = entry.Scale.Scale
            entry.Object.Position = UDim2.fromOffset(
                x - entry.Object.Size.X.Offset * scale * 0.5,
                y - entry.Object.Size.Y.Offset * scale * 0.5
            )
        end
    end)
    draw(0)
    state.Timeout = task.delay(120, function()
        if self.StartupIntro == state then
            self:CancelStartupIntro()
        end
    end)
end
function Library:FinishStartupIntro()
    if self.Unloaded or self.StartupIntroPlayed then
        return
    end
    if not self.StartupIntro and self.StartupWindow then
        self:BeginStartupIntro(self.StartupWindow)
    end
    local state = self.StartupIntro
    if not state or state.Finishing then
        return
    end
    state.Finishing = true
    if state.Timeout then
        pcall(task.cancel, state.Timeout)
    end
    state.Timeout = task.delay(75, function()
        if self.StartupIntro == state then
            self:CancelStartupIntro()
        end
    end)
    state.Worker = task.defer(function()
        local untilAt = os.clock() + 60
        local ready = false
        repeat
            if self.Unloaded or self.StartupIntro ~= state then
                return
            end
            ready = self.ControlsReady ~= false and not self.ConfigLoading and not next(self.ConfigCallbackJobs or {})
            if self.StartupProgressProvider then
                local complete, text, progress = self.StartupProgressProvider()
                ready = ready and complete
                self:SetStartupProgress(text, progress)
            end
            if not ready then
                task.wait(0.1)
            end
        until ready or os.clock() >= untilAt
        self:SetStartupProgress(ready and 'ready' or 'ready; remaining assets continue in background', 1)
        self.StartupProgressProvider = nil
        while
            not self.Unloaded
            and self.StartupIntro == state
            and os.clock() - state.At < (self.ReducedMotion and 0.15 or 0.35)
        do
            task.wait()
        end
        if self.Unloaded or self.StartupIntro ~= state then
            return
        end
        self.StartupIntroPlayed = true
        state.Emitting = true
        state.ProgressPanel.Visible = false
        local function tween(object, duration, goals, delay, style)
            if self.ReducedMotion then
                for property, value in pairs(goals) do
                    object[property] = value
                end
                return
            end
            local animation = TweenService:Create(
                object,
                TweenInfo.new(duration, style or Enum.EasingStyle.Quint, Enum.EasingDirection.Out, 0, false, delay or 0),
                goals
            )
            state.Tweens[#state.Tweens + 1] = animation
            animation:Play()
        end
        local holder, scaleObject = state.Holder, state.Window and state.Window.ScaleObject
        if holder and holder.Parent and holder.Visible and scaleObject and not self.ReducedMotion then
            local create = state.Create
            local scale = scaleObject.Scale
            local proxy = create('CanvasGroup', {
                Name = 'startup window',
                Parent = ScreenGui,
                Size = holder.Size,
                Position = holder.Position,
                BackgroundColor3 = self.BackgroundColor,
                BorderSizePixel = 0,
                GroupTransparency = 1,
                ZIndex = 1000,
            })
            state.Proxy = proxy
            local proxyScale = create('UIScale', { Parent = proxy, Scale = scale * 0.015 })
            create('UIStroke', { Parent = proxy, Color = self.FontColor, Thickness = 1, Transparency = 0.15 })
            create('TextLabel', {
                Parent = proxy,
                Text = state.Window.Title,
                Font = self.Font,
                TextSize = 12,
                TextColor3 = self.FontColor,
                BackgroundTransparency = 1,
                Size = UDim2.new(1, 0, 0, 26),
                ZIndex = 1001,
            })
            for index = 1, 5 do
                create('Frame', {
                    Parent = proxy,
                    Position = UDim2.new((index - 1) / 5, 12, 0, 32),
                    Size = UDim2.new(0.2, -24, 0, 14),
                    BackgroundColor3 = self.MainColor,
                    BorderSizePixel = 0,
                    ZIndex = 1001,
                })
            end
            for column = 0, 1 do
                create('Frame', {
                    Parent = proxy,
                    Position = UDim2.new(column * 0.5, 12, 0, 64),
                    Size = UDim2.new(0.5, -24, 0, 1),
                    BackgroundColor3 = self.FontColor,
                    BorderSizePixel = 0,
                    ZIndex = 1001,
                })
                for row = 1, 9 do
                    create('Frame', {
                        Parent = proxy,
                        Position = UDim2.new(column * 0.5, 16, 0, 68 + row * 24),
                        Size = UDim2.new(0.5, -40 - row % 3 * 14, 0, row % 3 == 0 and 8 or 2),
                        BackgroundColor3 = row % 3 == 0 and self.MainColor or self.OutlineColor,
                        BorderSizePixel = 0,
                        ZIndex = 1001,
                    })
                end
            end
            local entry = {
                Object = proxy,
                Position = holder.Position,
                Rotation = holder.Rotation,
                Scale = proxyScale,
                Holder = holder,
                Visible = holder.Visible,
            }
            state.WindowEntry = entry
            local origin = Vector2.new(state.Overlay.AbsoluteSize.X * 0.5, state.Overlay.AbsoluteSize.Y * 0.46)
            pcall(function()
                if not ScreenGui.IgnoreGuiInset then
                    origin -= game:GetService('GuiService'):GetGuiInset()
                end
            end)
            local screen = ScreenGui.AbsoluteSize
            local destination = Vector2.new(
                entry.Position.X.Scale * screen.X + entry.Position.X.Offset + holder.Size.X.Offset * scale * 0.5,
                entry.Position.Y.Scale * screen.Y + entry.Position.Y.Offset + holder.Size.Y.Offset * scale * 0.5
            )
            local dx, dy = destination.X - origin.X, destination.Y - origin.Y
            local distance = math.max(1, math.sqrt(dx * dx + dy * dy))
            local curl = math.min(160, distance * 0.28)
            entry.Origin, entry.Destination, entry.At = origin, destination, os.clock()
            entry.Control = Vector2.new(
                (origin.X + destination.X) * 0.5 - dy / distance * curl,
                (origin.Y + destination.Y) * 0.5 + dx / distance * curl
            )
            local puff = create('CanvasGroup', {
                Name = 'emergence ring',
                Parent = state.Root,
                AnchorPoint = Vector2.new(0.5, 0.5),
                Position = UDim2.fromScale(0.5, 0.46),
                Size = UDim2.fromOffset(120, 120),
                BackgroundTransparency = 1,
                ZIndex = 999,
            })
            state.Puff = puff
            for ring = 1, 3 do
                local size = 16 + ring * 6
                local spark = create('Frame', {
                    Parent = puff,
                    AnchorPoint = Vector2.new(0.5, 0.5),
                    Position = UDim2.fromScale(0.5, 0.5),
                    Size = UDim2.fromOffset(size, size),
                    BackgroundTransparency = 1,
                    BorderSizePixel = 0,
                    ZIndex = 999,
                })
                create('UICorner', { Parent = spark, CornerRadius = UDim.new(1, 0) })
                local sparkStroke = create('UIStroke', {
                    Parent = spark,
                    Color = self.AccentColor,
                    Thickness = ring == 1 and 1.4 or 0.9,
                    Transparency = 0.85,
                })
                tween(spark, 0.8, { Size = UDim2.fromOffset(size * 7 + 40, size * 7 + 40) })
                tween(sparkStroke, 0.8, { Transparency = 1 })
            end
            for index = 1, 10 do
                local angle = index * math.pi * 2 / 10
                local spark = create('Frame', {
                    Parent = puff,
                    Position = UDim2.fromScale(0.5, 0.5),
                    Size = UDim2.fromOffset(index % 2 + 1, 1),
                    Rotation = math.deg(angle),
                    BackgroundColor3 = self.AccentColor,
                    BackgroundTransparency = 0.3,
                    BorderSizePixel = 0,
                    ZIndex = 999,
                })
                tween(spark, 0.65, {
                    Position = UDim2.new(0.5, math.cos(angle) * 150, 0.5, math.sin(angle) * 100),
                    BackgroundTransparency = 1,
                })
            end
            tween(puff, 0.8, { GroupTransparency = 1 })
            holder.Visible = false
            proxy.Position = UDim2.fromOffset(
                origin.X - holder.Size.X.Offset * scale * 0.0075,
                origin.Y - holder.Size.Y.Offset * scale * 0.0075
            )
            proxy.Rotation = -55
            tween(proxy, 0.9, { Rotation = entry.Rotation, GroupTransparency = 0 })
            tween(proxyScale, 0.9, { Scale = scale }, nil, Enum.EasingStyle.Back)
        end
        tween(state.Vignette, self.ReducedMotion and 0 or 0.4, { GroupTransparency = 1 })
        tween(state.Overlay, self.ReducedMotion and 0.15 or 0.45, { BackgroundTransparency = 1 })
        tween(state.Label, self.ReducedMotion and 0.15 or 0.3, { TextTransparency = 1 })
        tween(
            state.Scene,
            self.ReducedMotion and 0.15 or 0.8,
            { GroupTransparency = 1 },
            self.ReducedMotion and 0 or 0.1
        )
        tween(
            state.SceneScale,
            self.ReducedMotion and 0.15 or 0.8,
            { Scale = state.SceneScale.Scale * 0.015 },
            self.ReducedMotion and 0 or 0.1
        )
        task.wait(self.ReducedMotion and 0.2 or 0.9)
        if self.StartupIntro ~= state then
            return
        end
        local entry = state.WindowEntry
        if entry and entry.Holder.Parent then
            entry.Holder.GroupTransparency = 1
            entry.Holder.Visible = entry.Visible
            state.WindowEntry = nil
            tween(entry.Holder, 0.25, { GroupTransparency = 0 })
            tween(entry.Object, 0.25, { GroupTransparency = 1 })
            task.wait(0.3)
        end
        if self.StartupIntro == state then
            self:CancelStartupIntro()
        end
    end)
end

function Library:BindWindowMovement(window, header, resizeButton, fit)
    local outer = window.Holder
    local action, connection
    local update
    local function stop(commit)
        if commit and action then
            update()
        end
        action = nil
        self.WindowInteracting = false
        if connection then
            connection:Disconnect()
            connection = nil
        end
    end
    function window:StopMovement()
        stop(false)
    end
    update = function()
        if not action then
            return
        end
        if self.Unloaded or not self.MainVisible or not outer.Parent then
            stop(false)
            return
        end
        if not action.Dirty then
            return
        end
        action.Dirty = false
        local delta = action.Latest - action.Pointer
        if action.Resize then
            local scale = math.max(window.ScaleObject.Scale, 0.01)
            outer.Size =
                UDim2.fromOffset(action.Size.X.Offset + delta.X / scale, action.Size.Y.Offset + delta.Y / scale)
            fit()
        else
            local screen = ScreenGui.AbsoluteSize
            local scale = math.max(window.ScaleObject.Scale, 0.01)
            local x = action.Position.X.Scale * screen.X + action.Position.X.Offset + delta.X
            local y = action.Position.Y.Scale * screen.Y + action.Position.Y.Offset + delta.Y
            local position = UDim2.fromOffset(
                math.clamp(x, 8, math.max(8, screen.X - outer.Size.X.Offset * scale - 8)),
                math.clamp(y, 8, math.max(8, screen.Y - outer.Size.Y.Offset * scale - 8))
            )
            if outer.Position ~= position then
                outer.Position = position
            end
        end
    end
    local function begin(input, resizing)
        if not self:IsClickInput(input) or self:MouseIsOverOpenedFrame() or InputService:GetFocusedTextBox() then
            return
        end
        stop(false)
        action = {
            Input = input,
            Pointer = input.Position,
            Latest = input.Position,
            Position = outer.Position,
            Size = outer.Size,
            Resize = resizing,
        }
        self.WindowInteracting = true
        self:ConsumeInput(input)
        connection = RenderStepped:Connect(update)
    end
    header.InputBegan:Connect(function(input)
        begin(input, false)
    end)
    resizeButton.InputBegan:Connect(function(input)
        begin(input, true)
    end)
    self:GiveSignal(InputService.InputChanged:Connect(function(input)
        if
            not action
            or input ~= action.Input
                and (action.Input.UserInputType == Enum.UserInputType.Touch or input.UserInputType ~= Enum.UserInputType.MouseMovement)
        then
            return
        end
        action.Latest, action.Dirty = input.Position, true
    end))
    self:GiveSignal(InputService.InputEnded:Connect(function(input)
        if action and input == action.Input then
            stop(true)
        end
    end))
    self:GiveSignal(InputService.WindowFocusReleased:Connect(function()
        stop(true)
    end))
end

function Library:CreateWindow(...)
    local args = { ... }
    local config = type(args[1]) == 'table' and table.clone(args[1]) or { Title = args[1], AutoShow = args[2] }
    local window: { [string]: any } =
        { Tabs = {}, TabSequence = 0, Title = tostring(config.Title or 'phowg host'), Workspace = true, Classic = true }
    Library.WorkspaceWindow = window
    local function frame(class, properties, colors)
        local object = Library:Create(class, properties)
        if colors then
            Library:AddToRegistry(object, colors)
        end
        return object
    end
    local function label(parent, text, position, size, textSize)
        return Library:CreateLabel({
            Parent = parent,
            Text = tostring(text):lower(),
            Position = position,
            Size = size,
            TextSize = textSize or 14,
            TextXAlignment = Enum.TextXAlignment.Left,
            TextTruncate = Enum.TextTruncate.AtEnd,
            ZIndex = 5,
        })
    end
    local function button(parent, text, size, callback)
        local object = frame('TextButton', {
            Parent = parent,
            Text = tostring(text):lower(),
            Size = size,
            BackgroundColor3 = Library.MainColor,
            BorderSizePixel = 0,
            TextColor3 = Library.FontColor,
