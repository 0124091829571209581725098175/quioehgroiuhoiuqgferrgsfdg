            BackgroundTransparency = 1,
            BorderSizePixel = 0,
            Size = UDim2.new(1, -16, 0, 24),
            ZIndex = 103,
        })
    end
    function entry:Update(NewText, Fraction)
        if self.Closed or not outer.Parent or Library.Unloaded then
            return
        end
        local rich, plain = NotificationText(NewText, self.Style)
        local fraction = type(Fraction) == 'number'
                and Fraction == Fraction
                and math.abs(Fraction) < math.huge
                and math.clamp(Fraction, 0, 1)
            or nil
        self.Dirty = self.Dirty or self.Plain ~= plain or (self.Fraction ~= nil) ~= (fraction ~= nil)
        self.Label.RichText = self.Style ~= 'Progress'
        self.Label.Text, self.Plain, self.Fraction = self.Style == 'Progress' and plain or rich, plain, fraction
        Library:RefreshNotifications()
    end
    function entry:Destroy()
        if self.Closed then
            return
        end
        self.Closed = true
        if self.Timer and self.Timer ~= coroutine.running() then
            pcall(task.cancel, self.Timer)
        end
        self.Timer = nil
        outer:Destroy()
    end
    function entry:Close()
        if self.Closed or self.Closing then
            return
        end
        self.Closing = true
        if Library.ReducedMotion or not outer.Visible then
            self:Destroy()
            return
        end
        TweenService:Create(outer, TweenInfo.new(0.12), { BackgroundTransparency = 1 }):Play()
        TweenService:Create(self.Label, TweenInfo.new(0.12), { TextTransparency = 1 }):Play()
        TweenService:Create(self.Edge, TweenInfo.new(0.12), { Transparency = 1 }):Play()
        self.Timer = task.delay(0.12, function()
            self.Timer = nil
            self:Destroy()
        end)
    end
    function entry:Expire(Time)
        local seconds = tonumber(Time) or Library.NotifyDuration or 5
        if seconds ~= seconds or math.abs(seconds) == math.huge then
            seconds = 5
        end
        self.Timer = task.delay(math.clamp(seconds, 0.2, 120), function()
            self.Timer = nil
            self:Close()
        end)
    end
    if entry.CanDismiss then
        entry.CloseButton = self:Create('TextButton', {
            Name = 'Dismiss',
            Parent = outer,
            Position = UDim2.new(1, -20, 0, 4),
            Size = UDim2.fromOffset(16, 16),
