Library.ControlTweens = {}
Library.ControlTweenGoals = {}
function Library:AnimateControl(Target, Properties, Duration, Delay)
    local Previous = Library.ControlTweens[Target]
    local Goal = Library.ControlTweenGoals[Target]
    if Previous and Goal and not Library.ReducedMotion then
        local SameGoal = true
        for Property, Value in pairs(Properties) do
            if Goal[Property] ~= Value then
                SameGoal = false
                break
            end
        end
        if SameGoal then
            for Property in pairs(Goal) do
                if Properties[Property] == nil then
                    SameGoal = false
                    break
                end
            end
        end
        if SameGoal then
            return
        end
    end
    if Previous then
        Previous:Cancel()
        Library.ControlTweens[Target] = nil
    end
    Library.ControlTweenGoals[Target] = nil
    local Changed = false
    for Property, Value in pairs(Properties) do
        if Target[Property] ~= Value then
            Changed = true
            break
        end
    end
    if not Changed then
        return
    end
    if Library.ReducedMotion then
        for Property, Value in pairs(Properties) do
            Target[Property] = Value
        end
        return
    end
    local Tween = TweenService:Create(
        Target,
        TweenInfo.new(Duration or 0.16, Enum.EasingStyle.Quart, Enum.EasingDirection.Out, 0, false, Delay or 0),
        Properties
    )
    Library.ControlTweens[Target] = Tween
    Library.ControlTweenGoals[Target] = table.clone(Properties)
    Tween.Completed:Once(function()
        if Library.ControlTweens[Target] == Tween then
            Library.ControlTweens[Target] = nil
            Library.ControlTweenGoals[Target] = nil
        end
    end)
    Tween:Play()
end
function Library:AnimateTabPage(page, button)
    if self.ReducedMotion or self.ConfigLoading or self.ControlsReady == false or not self.MainVisible then
        page.GroupTransparency = 0
        return
    end
    page.GroupTransparency = 0.18
    self:AnimateControl(page, { GroupTransparency = 0 }, 0.08)
    if button then
        local sweep = button:FindFirstChild('TabSweep')
        if not sweep then
            sweep = self:Create('UIGradient', {
                Name = 'TabSweep',
                Parent = button,
                Color = ColorSequence.new({
                    ColorSequenceKeypoint.new(0, Color3.fromRGB(185, 185, 185)),
                    ColorSequenceKeypoint.new(0.5, Color3.new(1, 1, 1)),
                    ColorSequenceKeypoint.new(1, Color3.fromRGB(185, 185, 185)),
                }),
            })
        end
        sweep.Offset = Vector2.new(-1, 0)
        self:AnimateControl(sweep, { Offset = Vector2.new(1, 0) }, 0.2)
    end
end
function Library:StyleControl(Outer, Inner, Radius, Region)
    if Inner:FindFirstChild('ControlStroke') then
        return
    end
    Outer.BorderSizePixel = 0
    Inner.BorderSizePixel = 0
    if Outer ~= Inner then
        Outer.BackgroundTransparency = 1
    end
    for _, Surface in ipairs(Outer == Inner and { Inner } or { Outer, Inner }) do
        if not Surface:FindFirstChildOfClass('UICorner') then
            Library:Create('UICorner', { CornerRadius = UDim.new(0, 0), Parent = Surface })
        end
    end
    local Stroke = Library:Create('UIStroke', {
        Name = 'ControlStroke',
        Color = Inner.BorderColor3,
        Thickness = 1,
        Transparency = 0.25,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
        Parent = Inner,
    })
    if Library.ReferenceStyle and Inner.BackgroundTransparency < 1 and Inner.ClassName ~= 'CanvasGroup' then
        Library:Create('UIGradient', {
            Name = 'ReferenceShading',
            Rotation = 90,
            Color = ColorSequence.new(Color3.fromRGB(255, 255, 255), Color3.fromRGB(210, 210, 210)),
            Parent = Inner,
        })
    end
    local Hovered, Focused, Pressed = false, false, false
    local function CurrentColor()
        local IdleColor = Inner.BorderColor3 == Library.Black and Library.OutlineColor or Inner.BorderColor3
        return (Hovered or Focused or Outer.BorderColor3 == Library.AccentColor) and Library.AccentColor or IdleColor
    end
    Library:AddToRegistry(Stroke, { Color = CurrentColor })
    local function UpdateColor()
        Stroke.Color = CurrentColor()
    end
    local function UpdateInteraction()
        UpdateColor()
        Library:AnimateControl(Stroke, {
            Transparency = Pressed and 0 or ((Hovered or Focused) and 0.05 or 0.25),
            Thickness = Pressed and 1.4 or 1,
        })
    end
    Inner:GetPropertyChangedSignal('BorderColor3'):Connect(UpdateColor)
    if Outer ~= Inner then
        Outer:GetPropertyChangedSignal('BorderColor3'):Connect(UpdateColor)
    end
    local HitRegion = Region or Outer
    HitRegion.MouseEnter:Connect(function()
        Hovered = true
        UpdateInteraction()
    end)
    HitRegion.MouseLeave:Connect(function()
        Hovered = false
        Pressed = false
        UpdateInteraction()
    end)
    HitRegion.InputBegan:Connect(function(Input)
        if Library:IsClickInput(Input) then
            Pressed = true
            UpdateInteraction()
        end
    end)
    HitRegion.InputEnded:Connect(function(Input)
        if Library:IsClickInput(Input, true) then
            Pressed = false
            UpdateInteraction()
        end
    end)
    local function HookTextBox(Box)
        if not Box:IsA('TextBox') then
            return
        end
        Box.Focused:Connect(function()
            Focused = true
            UpdateInteraction()
        end)
        Box.FocusLost:Connect(function()
            Focused = false
            UpdateInteraction()
        end)
    end
    for _, Child in ipairs(Inner:GetDescendants()) do
        HookTextBox(Child)
    end
    Inner.DescendantAdded:Connect(HookTextBox)
    Inner.Destroying:Connect(function()
        local Tween = Library.ControlTweens[Stroke]
        if Tween then
            Tween:Cancel()
            Library.ControlTweens[Stroke] = nil
        end
        Library.ControlTweenGoals[Stroke] = nil
    end)
    UpdateColor()
    return Stroke
end
function Library:GetReadableText(Background)
    local function linear(value)
        return value <= 0.04045 and value / 12.92 or ((value + 0.055) / 1.055) ^ 2.4
    end
    local luminance = 0.2126 * linear(Background.R) + 0.7152 * linear(Background.G) + 0.0722 * linear(Background.B)
    return (luminance + 0.05) / 0.05 >= 1.05 / (luminance + 0.05) and Color3.new(0, 0, 0) or Color3.new(1, 1, 1)
end
function Library:BindChoiceStyle(Button, Label, Marker, IsSelected, Dangerous)
    local hovered, initialized = false, false
    local function selectionColor()
        return Dangerous and self.RiskColor or self.AccentColor
    end
    local function background()
        if IsSelected() then
            return selectionColor()
        end
        return hovered and self.MainColor:Lerp(self.FontColor, 0.09) or self.MainColor
    end
    local function foreground()
        if IsSelected() then
            return self:GetReadableText(selectionColor())
        end
        return Dangerous and self.RiskColor or self.FontColor
    end
    local function update(animate)
        Marker.Visible = not not IsSelected()
        if animate and initialized then
            self:AnimateControl(Button, { BackgroundColor3 = background() })
            self:AnimateControl(Label, { TextColor3 = foreground() })
        else
            Button.BackgroundColor3, Label.TextColor3 = background(), foreground()
        end
        Marker.BackgroundColor3 = foreground()
        initialized = true
    end
    self.RegistryMap[Button].Properties.BackgroundColor3 = background
    self.RegistryMap[Label].Properties.TextColor3 = foreground
    self.RegistryMap[Marker].Properties.BackgroundColor3 = foreground
    Label.Position, Label.Size = UDim2.fromOffset(10, 0), UDim2.new(1, -20, 1, 0)
    Marker.Position, Marker.Size = UDim2.fromOffset(3, 4), UDim2.new(0, 2, 1, -8)
    Button.MouseEnter:Connect(function()
        hovered = true
        update(true)
    end)
    Button.MouseLeave:Connect(function()
        hovered = false
        update(true)
    end)
    Button.Destroying:Connect(function()
        for _, object in ipairs({ Button, Label }) do
            local tween = self.ControlTweens[object]
            if tween then
                tween:Cancel()
            end
            self.ControlTweens[object], self.ControlTweenGoals[object] = nil, nil
        end
    end)
    return function()
        update(true)
    end
end
function Library:StyleActionButton(Outer, Inner)
    local hovered, pressed = false, false
    local function color()
        return self.MainColor:Lerp(self.FontColor, pressed and 0.13 or hovered and 0.065 or 0)
    end
    local function update()
        self:AnimateControl(Inner, { BackgroundColor3 = color() })
    end
    self.RegistryMap[Inner].Properties.BackgroundColor3 = color
    Outer.MouseEnter:Connect(function()
        hovered = true
        update()
    end)
    Outer.MouseLeave:Connect(function()
        hovered = false
        pressed = false
        update()
    end)
    Outer.InputBegan:Connect(function(input)
        if self:IsClickInput(input) then
            pressed = true
            update()
        end
    end)
    Outer.InputEnded:Connect(function(input)
        if self:IsClickInput(input) then
            pressed = false
            update()
        end
    end)
    Outer.Destroying:Connect(function()
        local tween = self.ControlTweens[Inner]
        if tween then
            tween:Cancel()
        end
        self.ControlTweens[Inner], self.ControlTweenGoals[Inner] = nil, nil
    end)
end
