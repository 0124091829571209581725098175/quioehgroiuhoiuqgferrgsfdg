function Library:TrackTouch(Input)
    local Touch = nil
    local EndConn = nil

    if Input.UserInputType == Enum.UserInputType.Touch then
        Touch = Input

        EndConn = InputService.TouchEnded:Connect(function(Ended)
            if Ended == Touch then
                Touch = nil
            end
        end)
    end

    local function GetTouch()
        return Touch
    end

    local function StopTouch()
        if EndConn then
            EndConn:Disconnect()
            EndConn = nil
        end
    end

    return GetTouch, StopTouch
end

