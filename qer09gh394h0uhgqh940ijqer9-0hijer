function Library:GetCrewName(player)
    local ok, crew = pcall(function()
        local df = player:FindFirstChild("DataFolder")
        if not df then return nil end
        local info = df:FindFirstChild("Information")
        local c = (info and info:FindFirstChild("Crew")) or df:FindFirstChild("Crew")
        return c and c.Value or nil
    end)
    if not ok or not crew or tostring(crew) == "" or tostring(crew) == "0" then return nil end
    return tostring(crew)
end
function Library:GetCrewGroupName(crewId)
    local num = tonumber(crewId)
    if not num then return tostring(crewId) end
    Library.CrewNameCache = Library.CrewNameCache or {}
    if Library.CrewNameCache[num] then return Library.CrewNameCache[num] end
    local pd = Library.PhongData or (getgenv and getgenv().PhowgData) or nil
    if pd and pd.CrewNameCache and pd.CrewNameCache[num] then
        Library.CrewNameCache[num] = pd.CrewNameCache[num]
        return pd.CrewNameCache[num]
    end
    Library.CrewResolving = Library.CrewResolving or {}
    if not Library.CrewResolving[num] then
        Library.CrewResolving[num] = true
        task.spawn(function()
            local ok, info = pcall(function()
                return game:GetService('GroupService'):GetGroupInfoAsync(num)
            end)
            if ok and info and info.Name then
                Library.CrewNameCache[num] = info.Name
                if pd and pd.CrewNameCache then pd.CrewNameCache[num] = info.Name end
            else
                Library.CrewNameCache[num] = tostring(num)
            end
            Library.CrewResolving[num] = nil
            Library:SchedulePlayerRefresh()
        end)
    end
    return tostring(crewId)
end
function Library:GetCrewDisplayWithCount(player)
    local crewId = Library:GetCrewName(player)
    if not crewId then return "No Crew" end
    local count = 0
    for _,p in ipairs(Players:GetPlayers()) do
        local cid = Library:GetCrewName(p)
        if cid == crewId then count = count + 1 end
    end
    return Library:GetCrewGroupName(crewId) .. " (" .. tostring(count) .. ")"
end
function Library:FormatJoinedTime(plr)
    local joinAt = Library.PlayerJoinTimes[plr] or Library.PlayerJoinTimes[plr.UserId]
    if not joinAt then
        local pd = Library.PhongData or (getgenv and getgenv().PhowgData) or (getgenv and getgenv().Data) or nil
        if pd and pd.PlayerJoinAt and pd.PlayerJoinAt[plr] then joinAt = pd.PlayerJoinAt[plr] end
    end
    if not joinAt then return "Joined just now" end
    local elapsed = math.max(0, math.floor(tick() - joinAt))
    local h = math.floor(elapsed / 3600)
    local m = math.floor((elapsed % 3600) / 60)
    local s = elapsed % 60
    return string.format("Joined %02d:%02d:%02d ago", h, m, s)
end
function Library:IsRageWhitelisted(player)
