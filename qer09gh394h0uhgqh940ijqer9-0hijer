        if part:IsA('BasePart') and part.Transparency<1 then
            local cf,size=part.CFrame,part.Size
            local radius=((cf.XVector*size.X):Abs()+(cf.YVector*size.Y):Abs()+(cf.ZVector*size.Z):Abs())/2
            local first,last=part.Position-radius,part.Position+radius
            if lower then lower=lower:Min(first);upper=upper:Max(last) else lower,upper=first,last end
        end
    end
    if not lower then return nil,nil end
    return (lower+upper)/2,upper-lower
end
function Library:CreateWeaponWorkspace(owner, provider, selected, choose, summary)
    local state: {[string]: any} = {Connections = {}, Angle = 0, Zoom = 1, Elapsed = 0, Views = {}}
