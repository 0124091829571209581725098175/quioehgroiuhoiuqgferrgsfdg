            entry.Loading, entry.RetryAt = false, tick() + 10
            entry.Failed = not ok or not loaded
        end)
    end
    local flags, seen = {}, {}
    local function add(value) if not seen[value] then seen[value] = true; flags[#flags + 1] = value end end
    if pd.Shield.MarkedIds and pd.Shield.MarkedIds[player.UserId] then add('Marked reporter') end
    for id, group in pairs(pd.Shield.KickGroups or {}) do
        if record.Memberships[tonumber(id)] then add(tostring(type(group) == 'table' and group.Name or id)) end
    end
    for id, group in pairs(pd.Shield.ModGroups or {}) do
        if type(group) == 'table' and record.Memberships[tonumber(id)] then
            local role = record.Roles[tonumber(id)]
            if group.Kick or type(group.Forbidden) == 'table' and table.find(group.Forbidden, role) then
                add(tostring(group.Name or id) .. (role and ' / ' .. role or ''))
            end
        end
    end
    if #flags > 0 then return table.concat(flags, '\n') end
    return record.GroupsLoaded and 'No protection flags' or entry.Failed and 'Group check unavailable' or 'Checking staff roles...'
end
