    function Library:ShowToolbarPanel(Name)
        if Library.OpenToolbarPanel == Name then
            FadePanel(Library.ToolbarPanels[Name], false, Name);
            Library.OpenToolbarPanel = nil;
            SetToolbarActive(nil);
            return;
        end;

        for Key, Frame in next, Library.ToolbarPanels do
            FadePanel(Frame, false, Key);
        end;

        local Frame = Library.ToolbarPanels[Name];

        if Frame then
            if Name == 'Players' then
                RefreshPlayerList();
            elseif Name == 'Servers' then
                RefreshServerInfo();
            elseif Name == 'Executor' then
                RefreshInfo();
            elseif Name == 'Settings' then
                RefreshSettings();
            end;

            FadePanel(Frame, true, Name);
            Library.OpenToolbarPanel = Name;
            SetToolbarActive(Name);
        end;
    end;

    function Library:HideToolbarPanels()
        if Library._DockedPanelKind then
            local _dp = Library.ToolbarPanels[Library._DockedPanelKind];
            if _dp then
                local _do = Library._PanelOrig[Library._DockedPanelKind];
                if _do then _dp.AnchorPoint = _do.AnchorPoint; _dp.Position = _do.Position; _dp.Size = _do.Size; _dp.Parent = _do.Parent; end;
                for _, _dg in next, _dp:GetDescendants() do
                    if _dg:IsA('Frame') and _dg.Size == UDim2.new(0, 10, 0, 10) then _dg.Visible = true; end;
                end;
                _dp.Visible = false;
            end;
            Library._DockedPanelKind = nil;
        end;
        for Key, Frame in next, Library.ToolbarPanels do
            Frame.Visible = false;
        end;
        Library.OpenToolbarPanel = nil;
        SetToolbarActive(nil);
    end;

