        box:SetupDependencies({ { toggle, true } })
        toggle.Settings = box
        return box
    end

    function Funcs:AddDependencyBox()
        local Depbox: { [string]: any } = {
            Dependencies = {},
            DependencyDepth = (self.DependencyDepth or 0) + 1,
        }
        local Groupbox = self
        local Holder = Library:Create('Frame', {
            BackgroundTransparency = 1,
            Size = UDim2.new(1, 0, 0, 0),
            Visible = false,
            ClipsDescendants = true,
            Parent = Groupbox.Container,
        })
        local Frame = Library:Create('Frame', {
            BackgroundTransparency = 1,
            Size = UDim2.new(1, 0, 0, 0),
            Parent = Holder,
        })
        local Layout = Library:Create('UIListLayout', {
            FillDirection = Enum.FillDirection.Vertical,
            SortOrder = Enum.SortOrder.LayoutOrder,
            Parent = Frame,
        })
        function Depbox:Resize(immediate)
            local height = Layout.AbsoluteContentSize.Y / math.max(Library.UIScale or 1, 0.01)
            Frame.Size = UDim2.new(1, 0, 0, height)
            local target = self.Expanded and height or 0
            if self.TargetHeight == target and not immediate then
                return
            end
            self.TargetHeight = target
            self.Revision = (self.Revision or 0) + 1
            local revision = self.Revision
            if self.Tween then
                self.Tween:Cancel()
                self.Tween = nil
            end
            local visible = Holder.Visible and Library.MainVisible and Library.ControlsReady ~= false
            local animate = not immediate and not Library.ReducedMotion and visible and not Library.ConfigLoading
            if not animate or Holder.Size.Y.Offset == target then
                Holder.Size = UDim2.new(1, 0, 0, target)
                Holder.Visible = self.Expanded
                Groupbox:Resize()
                return
            end
            local delay = self.Expanded and math.min(0.04, (self.DependencyDepth - 1) * 0.018) or 0
            local animation = TweenService:Create(
                Holder,
                TweenInfo.new(0.18, Enum.EasingStyle.Quart, Enum.EasingDirection.Out, 0, false, delay),
                { Size = UDim2.new(1, 0, 0, target) }
            )
            self.Tween = animation
            animation.Completed:Once(function()
                if self.Revision ~= revision or Library.Unloaded then
                    return
                end
                self.Tween = nil
                Holder.Visible = self.Expanded
                Groupbox:Resize()
            end)
            animation:Play()
        end
        Library:GiveSignal(Layout:GetPropertyChangedSignal('AbsoluteContentSize'):Connect(function()
            Depbox:Resize()
        end))
        Library:GiveSignal(Holder:GetPropertyChangedSignal('Size'):Connect(function()
            Groupbox:Resize()
        end))
        Library:GiveSignal(Holder:GetPropertyChangedSignal('Visible'):Connect(function()
            if not Holder.Visible then
                for popup in pairs(table.clone(Library.OpenedFrames)) do
                    local anchor = Library.PopupAnchors[popup]
                    if anchor and anchor:IsDescendantOf(Holder) then
                        local close = Library.PopupClosers and Library.PopupClosers[popup]
                        if close then
                            close()
                        elseif popup.Parent then
                            popup.Visible = false
                        end
                        Library.OpenedFrames[popup] = nil
                    end
                end
            end
            if Library.PrunePopups then
                Library:PrunePopups()
            end
        end))
        function Depbox:Update(immediate)
            local expanded = true
            for _, dependency in ipairs(self.Dependencies) do
                local element, value = dependency[1], dependency[2]
                if element.Type == 'Toggle' and element.Value ~= value then
                    expanded = false
                    break
                end
            end
            self.Expanded = expanded
            if expanded then
                Holder.Visible = true
            end
            self:Resize(immediate)
        end
        function Depbox:SetupDependencies(dependencies)
            for _, dependency in ipairs(dependencies) do
                assert(type(dependency) == 'table', 'SetupDependencies: invalid dependency')
                assert(dependency[1], 'SetupDependencies: missing control')
                assert(dependency[2] ~= nil, 'SetupDependencies: missing value')
            end
            self.Dependencies = dependencies
            self:Update(true)
        end
        Depbox.Container, Depbox.Holder = Frame, Holder
        Library.DependencyHolders[Holder] = Depbox
        Depbox.ControlGroup, Depbox.RootTab = self.ControlGroup or self, self.RootTab
        setmetatable(Depbox, BaseGroupbox)
        table.insert(Library.DependencyBoxes, Depbox)
        return Depbox
    end

    BaseGroupbox.__index = Funcs
    BaseGroupbox.__namecall = function(Table, Key, ...)
        return Funcs[Key](...)
    end
