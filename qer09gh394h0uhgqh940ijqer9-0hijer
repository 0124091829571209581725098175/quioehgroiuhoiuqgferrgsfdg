function Library:NotificationMessage(text)
    local plain = tostring(text or '')
        :gsub('[%c%s]+', ' ')
        :match('^%s*(.-)%s*$')
        :gsub('^%[neuro%.net%]%s*', '')
        :gsub('^%[phowg host%]%s*', '')
    return '[phowg host] ' .. plain
