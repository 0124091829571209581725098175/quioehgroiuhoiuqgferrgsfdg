        function tab:AddTabbox(info)
            local box = {Tabs = {}, RootTab = self, TabSequence = 0}
            local holder = frame('Frame', {Name = 'ClassicTabbox', Parent = info.Side == 2 and right or left, BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 30), ZIndex = 4})
            local bar = frame('ScrollingFrame', {Name = 'Subtabs', Parent = holder, Size = UDim2.new(1, 0, 0, 28), BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 2, ScrollingDirection = Enum.ScrollingDirection.X, CanvasSize = UDim2.fromOffset(0, 0), ZIndex = 5})
