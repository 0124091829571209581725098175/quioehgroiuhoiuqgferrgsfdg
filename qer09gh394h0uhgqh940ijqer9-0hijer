    if WithActions then entry.Actions=self:Create('Frame',{Name='Actions'; Parent=outer; BackgroundTransparency=1; BorderSizePixel=0; Size=UDim2.new(1,-24,0,28); ZIndex=103;}) end;
    function entry:Update(NewText, Fraction)
        if self.Closed or not outer.Parent or Library.Unloaded then return end;
        local rich, plain = NotificationText(NewText,self.Style);
        local fraction = type(Fraction)=='number' and Fraction==Fraction and math.abs(Fraction)<math.huge and math.clamp(Fraction,0,1) or nil;
        self.Dirty = self.Dirty or self.Plain~=plain or (self.Fraction~=nil)~=(fraction~=nil);
