            entry.FocusLost:Connect(function()
                local value = tonumber(entry.Text)
                if value and value == value and math.abs(value) ~= math.huge then
                    value = tonumber(string.format('%.' .. math.clamp(control.Rounding or 0, 0, 10) .. 'f', value))
                    control:SetValue(value); Library:AttemptSave()
                end
                entry.Text = tostring(control.Value)
            end)
            control.NumericEntry = entry
        end
    end
    local separator = self:Create('Frame', {Parent = row, Position = UDim2.new(0, 0, 1, -1), Size = UDim2.new(1, 0, 0, 1), BackgroundColor3 = self.OutlineColor, BackgroundTransparency = 0.55, BorderSizePixel = 0, ZIndex = 4})
    self:AddToRegistry(separator, {BackgroundColor3 = 'OutlineColor'})
    separator.Visible = not Library.ClassicEnabled
    self.WorkspaceRows = self.WorkspaceRows or setmetatable({}, {__mode = 'k'})
    local function reflow()
        local scale = math.max(Library.UIScale or 1, 0.01)
        local compact = row.AbsoluteSize.X / scale < (Library.ClassicEnabled and 270 or 360)
        row.Size = UDim2.new(1, 0, 0, compact and (searchList and 96 or control.Type == 'Slider' and 76 or 66) or (searchList and 78 or control.Type == 'Slider' and 54 or 44))
        caption.Size = compact and UDim2.new(1, 0, 0, 22) or UDim2.new(0.43, -12, 1, -1)
