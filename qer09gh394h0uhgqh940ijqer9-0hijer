    local FadeCache = {};
    local PanelOrigPos = {};

    local function FadeProps(Desc)
        if Desc:IsA('ImageLabel') then
            return { 'ImageTransparency', 'BackgroundTransparency' };
        elseif Desc:IsA('TextLabel') or Desc:IsA('TextBox') then
            return { 'TextTransparency' };
        elseif Desc:IsA('ScrollingFrame') then
            return { 'BackgroundTransparency', 'ScrollBarImageTransparency' };
        elseif Desc:IsA('Frame') then
            return { 'BackgroundTransparency' };
        elseif Desc:IsA('UIStroke') then
            return { 'Transparency' };
        end;

        return {};
    end;

    local function FadePanel(Frame, Show, Name)
        local Time = Library.ReducedMotion and 0 or (Library.MenuFadeTime or 0.2);
        local Cache = FadeCache[Frame];

        if not Cache then
            Cache = {};
            FadeCache[Frame] = Cache;
        end;

        if Time <= 0 then
            Frame.Visible = Show;
            return;
        end;

        if Show then
            local Orig = PanelOrigPos[Frame];

            if not Orig then
                Orig = Frame.Position;
                PanelOrigPos[Frame] = Orig;
            end;

            Frame.Position = UDim2.new(Orig.X.Scale, Orig.X.Offset - 16, Orig.Y.Scale, Orig.Y.Offset);
            Frame.Visible = true;
            TweenService:Create(Frame, TweenInfo.new(Time, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Position = Orig }):Play();
        end;

        for _, Desc in next, Frame:GetDescendants() do
            local Props = FadeProps(Desc);

            if #Props > 0 then
                local C = Cache[Desc];

                if not C then
                    C = {};
                    Cache[Desc] = C;
                end;

                for _, Prop in next, Props do
                    if C[Prop] == nil then
                        C[Prop] = Desc[Prop];
                    end;

                    if C[Prop] ~= 1 then
                        TweenService:Create(Desc, TweenInfo.new(Time, Enum.EasingStyle.Linear), { [Prop] = Show and C[Prop] or 1 }):Play();
                    end;
                end;
            end;
        end;

        if not Show then
            task.delay(Time, function()
                if Library.OpenToolbarPanel ~= Name then
                    Frame.Visible = false;
                end;
            end);
        end;
    end;

