function Library:BindPopupPosition(Anchor, Popup, Update)
    self.PopupAnchors[Popup] = Anchor
    self.PopupOwners = self.PopupOwners or {}
    self.PopupClosers = self.PopupClosers or {}
    self.PopupOwners[Popup] = Anchor
    self.PopupClosers[Popup] = self.PopupClosers[Popup] or function()
        Popup.Visible = false
    end
    Popup:GetPropertyChangedSignal('Visible'):Connect(function()
        self.OpenedFrames[Popup] = Popup.Visible and true or nil
        local box = self.SettingsBoxes[Popup]
        if box and not Popup.Visible then
            box:Close()
        end
    end)
    local Connections = {}
    local function Disconnect()
        for _, Connection in ipairs(Connections) do
            Connection:Disconnect()
        end
        table.clear(Connections)
    end
    local function Refresh()
        if not Popup.Visible or not Popup.Parent or not Anchor.Parent or Library.Unloaded then
            return
        end
        local Current = Anchor
        local Position, Size = Anchor.AbsolutePosition, Anchor.AbsoluteSize
        while Current do
            if Current:IsA('GuiObject') then
                local Clipped = false
                if Current:IsA('ScrollingFrame') then
                    local Bounds, BoundsSize = Current.AbsolutePosition, Current.AbsoluteSize
                    Clipped = Position.X + Size.X <= Bounds.X
                        or Position.X >= Bounds.X + BoundsSize.X
                        or Position.Y + Size.Y <= Bounds.Y
                        or Position.Y >= Bounds.Y + BoundsSize.Y
                end
                if not Current.Visible or Clipped then
                    Popup.Visible = false
                    Library.OpenedFrames[Popup] = nil
                    return
                end
            end
            Current = Current.Parent
        end
        Update()
    end
    local function Sync()
        Disconnect()
        if Popup.Visible then
            Connections[1] = Anchor:GetPropertyChangedSignal('AbsolutePosition'):Connect(Refresh)
            Connections[2] = Anchor:GetPropertyChangedSignal('AbsoluteSize'):Connect(Refresh)
            Refresh()
        end
    end
    Popup:GetPropertyChangedSignal('Visible'):Connect(Sync)
    Popup.Destroying:Once(Disconnect)
    Anchor.Destroying:Once(function()
        Disconnect()
        Popup.Visible = false
        Library.OpenedFrames[Popup] = nil
    end)
    Sync()
end
