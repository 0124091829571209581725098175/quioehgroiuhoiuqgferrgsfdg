function Library:BuildCustomPanels(Window, TabContainer)
    Window.CustomPanels, Window.RefreshCustom = {}, {}
    local teleport, http = game:GetService('TeleportService'), game:GetService('HttpService')
    local function panel(name)
        local object = self:Create('Frame', {
            Name = 'Classic' .. name,
            Parent = TabContainer,
            Size = UDim2.fromScale(1, 1),
            BackgroundTransparency = 1,
            Visible = false,
            ZIndex = 4,
        })
        Window.CustomPanels[name] = object
        return object
    end
    local function text(parent, name, value, position, size)
        return self:CreateLabel({
            Name = name,
            Parent = parent,
            Text = name == 'Name' and value or tostring(value):lower(),
            TextSize = 13,
            TextXAlignment = Enum.TextXAlignment.Left,
            TextTruncate = Enum.TextTruncate.AtEnd,
            Position = position,
            Size = size,
            ZIndex = 7,
        })
    end
    local function button(parent, name, value, position, size, callback)
        local object = self:Create('TextButton', {
            Name = name,
            Parent = parent,
            Text = tostring(value):lower(),
            Font = self.Font,
            TextSize = 12,
            TextColor3 = self.FontColor,
            BackgroundColor3 = self.MainColor,
            BorderColor3 = self.OutlineColor,
            BorderSizePixel = 0,
            AutoButtonColor = false,
            Position = position,
            Size = size,
            ZIndex = 8,
        })
        self:AddToRegistry(
            object,
            { TextColor3 = 'FontColor', BackgroundColor3 = 'MainColor', BorderColor3 = 'OutlineColor' }
        )
        self:StyleControl(object, object, 1)
        object.Activated:Connect(function()
            if not self.Unloaded and not self:MouseIsOverOpenedFrame(object) then
                self:SafeCallback(callback)
            end
        end)
        return object
    end
    local function input(parent, name, placeholder, position, size)
        local object = self:Create('TextBox', {
            Name = name,
            Parent = parent,
            Text = '',
            PlaceholderText = tostring(placeholder):lower(),
            ClearTextOnFocus = false,
