    local unavailable = self:CreateLabel({Parent = main.Viewport, Text = '', Size = UDim2.fromScale(1, 1), TextSize = 12, TextWrapped = true, ZIndex = 8})
    local function cameraFit(record, angle, zoom)
        if not record.Size then return end
        local size = record.Size
        local aspect = math.max(0.2, record.Viewport.AbsoluteSize.X / math.max(1, record.Viewport.AbsoluteSize.Y))
        local halfFov = math.rad(record.Camera.FieldOfView / 2)
        local distance = math.max(size.Y, size.X / aspect, size.Z) / (2 * math.tan(halfFov)) + size.Magnitude * 0.4
        if record == main then distance = distance * 1.6 end
        local eye = Vector3.new(math.sin(angle) * distance, distance * 0.16, math.cos(angle) * distance) * zoom
        record.Camera.CFrame = CFrame.lookAt(eye, Vector3.zero)
    end
    local function load(record, weapon, skin)
        record.World:ClearAllChildren()
