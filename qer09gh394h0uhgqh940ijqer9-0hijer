function Library:RegisterAnimatedGradient(Gradient, Surface, Border)
    self.AnimatedGradients[Gradient] = { Surface = Surface, Border = Border == true }
    Gradient.Color = self.GradientColors
    if self.GradientConnection then
        return Gradient
    end
    local elapsed, sampleTime, sampleFrames = 0, 0, 0
    self.GradientConnection = RenderStepped:Connect(function(delta)
        if Library.Unloaded then
            return
        end
        if Library.TrackIndicatorFPS then
            sampleTime += delta
            sampleFrames += 1
            if sampleTime >= 0.5 then
                Library.IndicatorFPS = sampleFrames / sampleTime
                sampleTime, sampleFrames = 0, 0
            end
        else
            sampleTime, sampleFrames = 0, 0
        end
        if Library.WindowInteracting or Library.StartupIntro then
            return
        end
        elapsed += delta
        if elapsed < 1 / 30 then
            return
        end
        elapsed = 0
        local phase = os.clock() * (Library.GradientSpeed or 0.35)
        for gradient, entry in pairs(Library.AnimatedGradients) do
            local surface = entry.Surface
            if not gradient.Parent or not surface.Parent then
                Library.AnimatedGradients[gradient] = nil
            else
                local visible, ancestor = true, surface
                while ancestor and ancestor ~= ScreenGui do
                    if ancestor:IsA('GuiObject') and not ancestor.Visible then
                        visible = false
                        break
                    end
                    ancestor = ancestor.Parent
                end
                if visible then
                    local animate = not Library.ReducedMotion and Library.GradientAnimation ~= false
                    if entry.Border then
                        local rotation = animate and (phase * 45) % 360 or 0
                        if gradient.Rotation ~= rotation then
                            gradient.Rotation = rotation
                        end
                    else
                        local offset = Vector2.new(animate and math.sin(phase) * 0.45 or 0, 0)
                        if gradient.Offset ~= offset then
                            gradient.Offset = offset
                        end
                    end
                end
            end
        end
    end)
    self:GiveSignal(self.GradientConnection)
    return Gradient
end
