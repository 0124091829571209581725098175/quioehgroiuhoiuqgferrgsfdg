        if self.Unloaded then return end
        clear(playerList)
        local query = search.Text:lower():match('^%s*(.-)%s*$')
        local rows, members = Players:GetPlayers(), {}
        table.sort(rows, function(a, b) return a.Name:lower() < b.Name:lower() end)
        self.StreamerNames = {}
        for i, player in ipairs(rows) do
            self.StreamerNames[player.UserId] = 'Player' .. i
