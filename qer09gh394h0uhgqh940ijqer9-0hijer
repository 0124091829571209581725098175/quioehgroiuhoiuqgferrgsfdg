        unavailable.Text, unavailable.Visible = tostring(reason or 'Model not available in this client'), not ok
        state.Angle, state.Zoom = 0.35, 1
        local index = table.find(names or {}, skin) or 1
        local choices = { 1, index > 1 and index or 2, index + 1 }
        local seen = {}
        for i, tile in ipairs(tiles) do
            local name = names and names[choices[i]]
            if name and seen[name] then
                name = nil
            end
            if name then
                seen[name] = true
            end
            tile.Skin, tile.Button.Visible = name, name ~= nil
            tile.Caption.Text = name or ''
            tile.Caption.TextColor3 = name == skin and self.AccentColor or self.FontColor
            self.RegistryMap[tile.Caption].Properties.TextColor3 = name == skin and 'AccentColor' or 'FontColor'
            tile.View.World:ClearAllChildren()
            tile.View.Size = nil
            if name then
                load(tile.View, weapon, name)
            end
        end
        main.Viewport.BackgroundTransparency = self.ReducedMotion and 0.15 or 0.65
        self:AnimateControl(main.Viewport, { BackgroundTransparency = 0.15 })
    end
