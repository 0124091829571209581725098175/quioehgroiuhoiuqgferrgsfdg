    function BaseGroupbox.__index:AddSectionButton(...)
        local owner = self
        local holder = self.Holder or self.Container and self.Container.Parent
        assert(holder, 'AddSectionButton: section holder is unavailable.')
        if not self.HeaderActions then
            self.HeaderActions = Library:Create('Frame', {
                Name = 'SectionActions',
                Parent = holder,
                AnchorPoint = Vector2.new(1, 0),
                Position = UDim2.new(1, -8, 0, 4),
                Size = UDim2.fromOffset(0, 22),
                BackgroundTransparency = 1,
                BorderSizePixel = 0,
                ZIndex = 8,
            })
            self.HeaderButtons = {}
            local reflowing = false
            self.ReflowHeaderButtons = function()
                if reflowing then
                    return
                end
                reflowing = true
                local available = math.max(40, holder.AbsoluteSize.X / math.max(Library.UIScale or 1, 0.01) - 110)
                local total = 0
                for _, item in ipairs(owner.HeaderButtons) do
                    item.HeaderWidth =
                        math.clamp(select(1, Library:GetTextBounds(item.Label.Text, Library.Font, 12)) + 24, 48, 120)
                    total += item.HeaderWidth
                end
                local gaps = math.max(0, #owner.HeaderButtons - 1) * 5
                local ratio = math.min(1, math.max(1, available - gaps) / math.max(total, 1))
                local x = 0
                for _, item in ipairs(owner.HeaderButtons) do
                    local width = item.HeaderWidth * ratio
                    item.Outer.Position = UDim2.fromOffset(x, 0)
                    item.Outer.Size = UDim2.fromOffset(width, 22)
                    x += width + 5
                end
                owner.HeaderActionsWidth = math.max(0, x - 5)
                owner.HeaderActions.Size = UDim2.fromOffset(owner.HeaderActionsWidth, 22)
                reflowing = false
                owner:Resize()
            end
            Library:GiveSignal(holder:GetPropertyChangedSignal('AbsoluteSize'):Connect(self.ReflowHeaderButtons))
        end
        local proxy = setmetatable(
            { Container = self.HeaderActions, AddBlank = function() end, Resize = function() end },
            { __index = self }
        )
        local result = BaseGroupbox.__index.AddButton(proxy, ...)
        result.Outer.Name = 'SectionActionButton'
        result.Label.TextSize = Library.UIFontSize
        self.HeaderButtons[#self.HeaderButtons + 1] = result
        result.AddButton = function(_, ...)
            return owner:AddSectionButton(...)
        end
        function result:SetText(text)
            self.Text = tostring(text)
            self.Label.Text = self.Text
            owner.ReflowHeaderButtons()
            return self
        end
        self.ReflowHeaderButtons()
        return result
    end
    BaseGroupbox.__index.AddHeaderButton = BaseGroupbox.__index.AddSectionButton
    function BaseGroupbox.__index:AddLabel(text, wrap)
