                    })
                    item.Outer.Parent = row
                    row:SetAttribute('Buttons', 1)
                    item.ButtonRow = row
                end
                local second = originalButton(self, ...)
                second.Outer.Parent, second.ButtonRow = row, row
                second.Label.TextSize = Library.UIFontSize + (Library.ClassicEnabled and 1 or 2)
                second.AddButton = item.AddButton
                local buttons = {}
                for _, child in ipairs(row:GetChildren()) do
                    if child:IsA('Frame') then
                        buttons[#buttons + 1] = child
                    end
                end
                local count = #buttons
                for index, child in ipairs(buttons) do
                    child.Position = UDim2.new((index - 1) / count, (index - 1) * 4 / count, 0, 0)
                    child.Size = UDim2.new(1 / count, -4 * (count - 1) / count, 1, 0)
