function Library:StopSliderDrag(save)
    local drag = self.ActiveSliderDrag
    self.ActiveSliderDrag = nil
    if drag and save and drag.Changed then
        self:AttemptSave(drag.Control.ControlIndex, drag.Control)
    end
end
function Library:UpdateSliderDrag(input)
    local drag = self.ActiveSliderDrag
    if not drag then
        return
    end
    if self.Unloaded or not self.MainVisible or not drag.Track.Parent then
        self:StopSliderDrag(false)
        return
    end
    if drag.Input.UserInputType == Enum.UserInputType.Touch and input ~= drag.Input then
        return
    end
    local x = input.Position and input.Position.X or Mouse.X
    if math.abs(x - drag.StartX) > 3 then
        drag.Control.LastNumericClick = nil
        drag.DeferUntilMoved = false
    end
    if drag.DeferUntilMoved then
        return
    end
    local track = drag.Track
    local width = math.max(1, track.AbsoluteSize.X)
    local value
    if drag.Precision then
        value = drag.StartValue + (x - drag.StartX) / width * (drag.Control.Max - drag.Control.Min) * 0.1
        value = tonumber(string.format('%.' .. math.clamp(drag.Control.Rounding or 0, 0, 10) .. 'f', value))
        value = math.clamp(value, drag.Control.Min, drag.Control.Max)
    else
        value = drag.Control:GetValueFromXOffset(math.clamp(x - track.AbsolutePosition.X, 0, width))
    end
    if value ~= drag.Control.Value then
        drag.Changed = true
        drag.Control:SetValue(value)
    end
end
function Library:BindSliderEditor(control, entry)
    control.NumericEntry, control.NumericRestingZ = entry, entry.ZIndex
    entry.TextEditable, entry.Active = false, false
    entry.Focused:Connect(function()
        if not control.NumericEditing then
            entry:ReleaseFocus()
            return
        end
        self.FocusedSlider = control
    end)
    entry.FocusLost:Connect(function()
        control.NumericEditing, control.LastNumericClick = nil, nil
        entry.TextEditable, entry.Active, entry.ZIndex = false, false, control.NumericRestingZ
        if self.FocusedSlider == control then
            self.FocusedSlider = nil
        end
    end)
end
function Library:BeginSliderEdit(control)
    local entry = control.NumericEntry
    if not entry or not entry.Parent or self.Unloaded then
        return
    end
    self:StopSliderDrag(true)
    control.NumericEditing, control.LastNumericClick = true, nil
    entry.TextEditable, entry.Active = true, true
    entry.ZIndex = math.max(control.NumericRestingZ, control.HitArea.ZIndex) + 1
    entry.Text = tostring(control.Value)
    task.defer(function()
        if control.NumericEditing and entry.Parent and not self.Unloaded and self.MainVisible then
            entry:CaptureFocus()
        end
    end)
end
function Library:PairSliderRows(first, second)
    if first.SliderPair or not first.WorkspaceRow or not second.WorkspaceRow then
        return second
    end
    local left, right = first.WorkspaceRow, second.WorkspaceRow
    local container, owner = left.Parent, first.Groupbox
    if not container or right.Parent ~= container then
        return second
    end
    local ordered, lastOrder = {}, 0
    local children = container:GetChildren()
    for _, child in ipairs(children) do
        if child:IsA('GuiObject') then
            lastOrder = math.max(lastOrder, child.LayoutOrder)
        end
    end
    for index, child in ipairs(children) do
        if child:IsA('GuiObject') then
            local order = child.LayoutOrder == 0 and lastOrder + index or child.LayoutOrder
            ordered[#ordered + 1] = { Object = child, Index = index, Order = order }
        end
    end
    table.sort(ordered, function(a, b)
        return a.Order == b.Order and a.Index < b.Index or a.Order < b.Order
    end)
    for index, item in ipairs(ordered) do
        item.Object.LayoutOrder = index
    end
    local pair = self:Create('Frame', {
        Name = 'SliderRow',
        Parent = container,
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        Size = UDim2.new(1, 0, 0, 36),
        LayoutOrder = left.LayoutOrder,
        ZIndex = left.ZIndex,
    })
    first.SliderPair, second.SliderPair = pair, pair
    left.Parent, right.Parent = pair, pair
    left.Position, right.Position = UDim2.fromOffset(0, 0), UDim2.new(0.5, 4, 0, 0)
    left.Size, right.Size = UDim2.new(0.5, -4, 0, left.Size.Y.Offset), UDim2.new(0.5, -4, 0, right.Size.Y.Offset)
    for _, row in ipairs({ left, right }) do
        local reflow = self.WorkspaceRows and self.WorkspaceRows[row]
        if reflow then
            reflow()
        end
    end
    pair.Size = UDim2.new(1, 0, 0, math.max(left.Size.Y.Offset, right.Size.Y.Offset))
    if owner and owner.Resize then
        owner:Resize()
    end
    return second
end

function Library:BindSliderInput(control, track)
    control.Track = track
    local hit = self:Create('TextButton', {
        Name = 'SliderHitArea',
        Parent = track.Parent,
        BackgroundTransparency = 1,
        Text = '',
        AutoButtonColor = false,
        Active = true,
        Position = UDim2.fromOffset(0, 0),
        Size = UDim2.new(track.Size.X.Scale, track.Size.X.Offset, 1, 0),
        ZIndex = 13,
    })
    control.HitArea = hit
    track:GetPropertyChangedSignal('Size'):Connect(function()
        hit.Size = UDim2.new(track.Size.X.Scale, track.Size.X.Offset, 1, 0)
    end)
    hit.InputBegan:Connect(function(input)
        if not self:IsClickInput(input) or self.Unloaded or self:MouseIsOverOpenedFrame(hit) then
            return
        end
        local point = input.Position or Vector2.new(Mouse.X, Mouse.Y)
        local entry = control.NumericEntry
        local overNumber = entry
            and point.X >= entry.AbsolutePosition.X
            and point.X <= entry.AbsolutePosition.X + entry.AbsoluteSize.X
            and point.Y >= entry.AbsolutePosition.Y
            and point.Y <= entry.AbsolutePosition.Y + entry.AbsoluteSize.Y
        local last = control.LastNumericClick
        if
            overNumber
            and last
            and last.Kind == input.UserInputType
            and os.clock() - last.At <= 0.3
            and math.abs(point.X - last.X) <= 6
            and math.abs(point.Y - last.Y) <= 6
        then
            self:BeginSliderEdit(control)
            return
        end
        control.LastNumericClick = overNumber
                and { At = os.clock(), X = point.X, Y = point.Y, Kind = input.UserInputType }
            or nil
        self:StopSliderDrag(true)
        local focused = InputService:GetFocusedTextBox()
        if focused then
            focused:ReleaseFocus()
        end
        local precision = InputService:IsKeyDown(Enum.KeyCode.LeftShift)
            or InputService:IsKeyDown(Enum.KeyCode.RightShift)
        self.ActiveSliderDrag = {
            Control = control,
            Track = track,
            Input = input,
            StartX = input.Position and input.Position.X or Mouse.X,
            StartValue = control.Value,
            Precision = precision,
            Changed = false,
            DeferUntilMoved = overNumber == true,
        }
        self:UpdateSliderDrag(input)
    end)
    if self.SliderInputBound then
        return
    end
    self.SliderInputBound = true
    self:GiveSignal(InputService.InputChanged:Connect(function(input)
        if
            input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch
        then
            self:UpdateSliderDrag(input)
        end
    end))
    self:GiveSignal(InputService.InputEnded:Connect(function(input)
        local drag = self.ActiveSliderDrag
        if
            drag
            and (
                input == drag.Input
                or input.UserInputType == Enum.UserInputType.MouseButton1
                    and drag.Input.UserInputType == Enum.UserInputType.MouseButton1
            )
        then
            self:StopSliderDrag(true)
        end
    end))
    self:GiveSignal(InputService.InputBegan:Connect(function(input)
        local slider = self.FocusedSlider
        local entry = slider and slider.NumericEntry
        if not entry or not entry:IsFocused() or self.Unloaded then
            return
        end
        local key, direction = input.KeyCode, nil
        if key == Enum.KeyCode.Up then
            direction = 1
        elseif key == Enum.KeyCode.Down then
            direction = -1
        end
        if key == Enum.KeyCode.Escape then
            entry.Text = tostring(slider.Value)
            entry:ReleaseFocus()
            return
        end
        local value = tonumber(entry.Text) or slider.Value
        if direction then
            local multiplier = InputService:IsKeyDown(Enum.KeyCode.LeftShift)
                or InputService:IsKeyDown(Enum.KeyCode.RightShift)
            value = value + direction * (slider.Step or 10 ^ -(slider.Rounding or 0)) * (multiplier and 10 or 1)
        elseif key == Enum.KeyCode.Home then
            value = slider.Min
        elseif key == Enum.KeyCode.End then
            value = slider.Max
        else
            return
        end
        slider:SetValue(value)
        entry.Text = tostring(slider.Value)
        self:AttemptSave(slider.ControlIndex, slider)
    end))
end

