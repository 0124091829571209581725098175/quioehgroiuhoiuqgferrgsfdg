function Library:GetPlayerInspectorProtection(player)
    self.PlayerProtectionCache = self.PlayerProtectionCache or setmetatable({}, { __mode = 'k' })
    local entry = self.PlayerProtectionCache[player]
    local pd = self.PhongData
    local pf = getgenv and getgenv().PhowgFunc
    if not pd or not pd.Shield or not pf or not pf.LoadProtectionGroups then
        return 'Protection unavailable'
    end
    if not entry then
        entry = { Record = { Memberships = {}, Roles = {} }, RetryAt = 0, Loading = false }
        self.PlayerProtectionCache[player] = entry
    end
    local record = pd.ShieldChecks and pd.ShieldChecks[player] or entry.Record
    if not record.GroupsLoaded and not entry.Loading and tick() >= entry.RetryAt then
        entry.Loading = true
        task.spawn(function()
            local ok, loaded = pcall(pf.LoadProtectionGroups, player, record)
            entry.Loading, entry.RetryAt = false, tick() + 10
            entry.Failed = not ok or not loaded
        end)
    end
    local flags, seen = {}, {}
    local function add(value)
        if not seen[value] then
            seen[value] = true
            flags[#flags + 1] = value
        end
    end
    if pd.Shield.MarkedIds and pd.Shield.MarkedIds[player.UserId] then
        add('Marked reporter')
    end
    for id, group in pairs(pd.Shield.KickGroups or {}) do
        if record.Memberships[tonumber(id)] then
            add(tostring(type(group) == 'table' and group.Name or id))
        end
    end
    for id, group in pairs(pd.Shield.ModGroups or {}) do
        if type(group) == 'table' and record.Memberships[tonumber(id)] then
            local role = record.Roles[tonumber(id)]
            if group.Kick or type(group.Forbidden) == 'table' and table.find(group.Forbidden, role) then
                add(tostring(group.Name or id) .. (role and ' / ' .. role or ''))
            end
        end
    end
    if #flags > 0 then
        return table.concat(flags, '\n')
    end
    return record.GroupsLoaded and 'No protection flags'
        or entry.Failed and 'Group check unavailable'
        or 'Checking staff roles...'
end
function Library:GetPlayerIntelligenceRows(player)
    local rows, full = {}, {}
    local function display(value)
        if value == nil then
            return 'not replicated'
        end
        if type(value) == 'boolean' then
            return value and 'on' or 'off'
        end
        if typeof(value) == 'Instance' then
            return value:GetFullName()
        end
        local text = tostring(value)
        if not utf8.len(text) then
            text = text:gsub('[^%w%p%s]', function(byte)
                return ('\\x%02X'):format(string.byte(byte))
            end)
        end
        return text
    end
    local function add(key, value)
        local text = key .. ': ' .. display(value)
        full[#full + 1] = text
        local boundary = utf8.offset(text, 513)
        rows[#rows + 1] = boundary and text:sub(1, boundary - 1) .. ' [copy info for full value]' or text
    end
    local function heading(text)
        rows[#rows + 1] = ''
        rows[#rows + 1] = text
        full[#full + 1] = '\n' .. text
    end
    heading('IDENTITY')
    add('username', player.Name)
    add('display name', player.DisplayName)
    add('user id', player.UserId)
    add('account age (days)', player.AccountAge)
    add('team', player.Team and player.Team.Name or 'none')
    heading('GAME SETTINGS')
    for _, name in ipairs({
        'AutoShoot',
        'Slide',
        'AutoReload',
        'AutoRun',
        'LegacyShooting',
        'LegacyWalk',
        'MacroHold',
        'MacroKey',
        'MacroSpeed',
        'AimSensitivity',
        'TouchSensitivity',
        'FOV',
        'GunFX',
        'GunSounds',
        'SkinAnimations',
        'ExplosionShake',
        'LowGFX',
        'Shadows',
        'BoomBox',
        'Vehicles',
        'FlamePitch',
        'AntiFling',
        'NoSeat',
        'Passenger',
        'KeybindHints',
        'HitMarkers',
        'CooldownIndicators',
        'PartyInvites',
        'TeamPings',
        'EloDisplay',
        'Stats',
        'NameEmoji',
        'LowerKnife',
    }) do
        local value = player:GetAttribute(name)
        if value == nil and name == 'LowGFX' then
            value = player:GetAttribute('LOWGFX')
        end
        add(name, value)
    end
    local character = player.Character
    local humanoid = character and character:FindFirstChildOfClass('Humanoid')
    if humanoid then
        heading('CHARACTER STATE')
        for _, name in ipairs({
            'Health',
            'MaxHealth',
            'WalkSpeed',
            'JumpPower',
            'JumpHeight',
            'HipHeight',
            'Sit',
            'PlatformStand',
            'AutoRotate',
            'MoveDirection',
            'FloorMaterial',
            'RigType',
        }) do
            add(name, humanoid[name])
        end
        add('state', humanoid:GetState())
    end
    local function attributes(node, name)
        if not node then
            return
        end
        heading(name)
        local values, names = node:GetAttributes(), {}
        for key in pairs(values) do
            names[#names + 1] = key
        end
        table.sort(names)
        if #names == 0 then
            rows[#rows + 1] = 'none replicated'
        end
        for _, key in ipairs(names) do
            add(key, values[key])
        end
    end
    attributes(player, 'PLAYER ATTRIBUTES')
    attributes(character, 'CHARACTER ATTRIBUTES')
    attributes(humanoid, 'HUMANOID ATTRIBUTES')
    local function values(node, prefix, depth)
        if not node or depth > 3 then
            return
        end
        local children = node:GetChildren()
        table.sort(children, function(a, b)
            return a.Name < b.Name
        end)
        for _, child in ipairs(children) do
            local key = prefix == '' and child.Name or prefix .. '.' .. child.Name
            if child:IsA('ValueBase') then
                add(key, child.Value)
            elseif child:IsA('Folder') then
                values(child, key, depth + 1)
            end
        end
    end
    heading('BODY EFFECTS')
    values(character and character:FindFirstChild('BodyEffects'), '', 0)
    heading('REPLICATED PLAYER DATA')
    values(player:FindFirstChild('DataFolder'), '', 0)
    return rows, table.concat(full, '\n')
end
function Library:CreateInspectorInventory(state, target, inventory, controls, body, title, label)
    local controller = { Records = {}, ContainerConnections = {}, LayoutDirty = true, Sequence = 0 }
    local function disconnect(connections)
        for _, connection in pairs(connections) do
            connection:Disconnect()
        end
        table.clear(connections)
    end
    local function listen(connections, signal, callback)
        local connection = signal:Connect(callback)
        connections[#connections + 1] = connection
        return connection
    end
    local function destroyRow(record)
        if not record.Row then
            return
        end
        self:RemoveFromRegistry(record.Row)
        self:RemoveFromRegistry(record.NameLabel)
        self:RemoveFromRegistry(record.AmmoLabel)
        record.Row:Destroy()
        record.Row, record.NameLabel, record.AmmoLabel = nil, nil, nil
        controller.LayoutDirty = true
    end
    local function bindValues(record)
        local tool = record.Tool
        local ammo, maximum = tool:FindFirstChild('Ammo'), tool:FindFirstChild('MaxAmmo')
        if ammo and not ammo:IsA('ValueBase') then
            ammo = nil
        end
        if maximum and not maximum:IsA('ValueBase') then
            maximum = nil
        end
        if record.Ammo == ammo and record.Maximum == maximum then
            return
        end
        disconnect(record.ValueConnections)
        record.Ammo, record.Maximum, record.Dirty = ammo, maximum, true
        controller.LayoutDirty = true
        for _, value in pairs({ ammo, maximum }) do
            listen(record.ValueConnections, value:GetPropertyChangedSignal('Value'), function()
                record.Dirty = true
            end)
        end
    end
    local function observe(tool)
        if not tool:IsA('Tool') then
            return
        end
        local record = controller.Records[tool]
        if record then
            record.Dirty = true
            return
        end
        controller.Sequence += 1
        record = { Tool = tool, Connections = {}, ValueConnections = {}, Dirty = true, Sequence = controller.Sequence }
        controller.Records[tool] = record
        listen(record.Connections, tool.ChildAdded, function(child)
            if child.Name == 'Ammo' or child.Name == 'MaxAmmo' then
                bindValues(record)
            end
        end)
        listen(record.Connections, tool.ChildRemoved, function(child)
            if child == record.Ammo or child == record.Maximum then
                bindValues(record)
            end
        end)
        listen(record.Connections, tool:GetPropertyChangedSignal('Name'), function()
            record.Dirty = true
            controller.LayoutDirty = true
        end)
        listen(record.Connections, tool:GetAttributeChangedSignal('MaxAmmo'), function()
            record.Dirty = true
        end)
        bindValues(record)
        controller.LayoutDirty = true
    end
    local function remove(record)
        disconnect(record.Connections)
        disconnect(record.ValueConnections)
        destroyRow(record)
        controller.Records[record.Tool] = nil
    end
    local function bindContainers()
        local character, backpack = target.Character, target:FindFirstChildOfClass('Backpack')
        if controller.Character == character and controller.Backpack == backpack then
            return
        end
        disconnect(controller.ContainerConnections)
        controller.Character, controller.Backpack = character, backpack
        for _, container in pairs({ character, backpack }) do
            listen(controller.ContainerConnections, container.ChildAdded, observe)
            listen(controller.ContainerConnections, container.ChildRemoved, function(tool)
                local record = controller.Records[tool]
                if record then
                    record.Dirty = true
                    controller.LayoutDirty = true
                end
            end)
            for _, tool in ipairs(container:GetChildren()) do
                observe(tool)
            end
        end
        controller.LayoutDirty = true
    end
    function controller:Refresh()
        if self.Closed or state.Closing then
            return
        end
        bindContainers()
        local data = Library.PhongData
        local esp = data and data.ESPInstance or getgenv and getgenv().ESP
        local themeChanged = self.Accent ~= Library.AccentColor
            or self.Font ~= Library.FontColor
            or self.Outline ~= Library.OutlineColor
            or self.ESP ~= esp
        self.Accent, self.Font, self.Outline, self.ESP =
            Library.AccentColor, Library.FontColor, Library.OutlineColor, esp
        for tool, record in pairs(self.Records) do
            if not tool.Parent or tool.Parent ~= self.Character and tool.Parent ~= self.Backpack then
                remove(record)
            elseif not record.Ammo then
                destroyRow(record)
            elseif record.Dirty or themeChanged or not record.Row then
                record.Dirty = false
                local equipped = tool.Parent == self.Character
                local amount = tonumber(record.Ammo.Value) or 0
                local maximum = record.Maximum and record.Maximum.Value or tool:GetAttribute('MaxAmmo')
                local text = tostring(record.Ammo.Value) .. ' / ' .. tostring(maximum or '?')
                local fraction = math.clamp(amount / math.max(1, tonumber(maximum) or 1), 0, 1)
                if not record.Row then
                    local row = Library:Create('Frame', {
                        Parent = inventory,
                        BackgroundColor3 = Library.MainColor,
                        BorderSizePixel = 0,
                        Size = UDim2.new(1, 0, 0, 54),
                        ZIndex = 313,
                    })
                    Library:AddToRegistry(row, { BackgroundColor3 = 'MainColor' })
                    record.Row = row
                    record.Bar = Library:Create(
                        'Frame',
                        { Parent = row, BorderSizePixel = 0, Position = UDim2.fromOffset(90, 49), ZIndex = 314 }
                    )
                    record.Edge = Library:Create('Frame', {
                        Parent = row,
                        BorderSizePixel = 0,
                        Position = UDim2.fromOffset(0, 7),
                        Size = UDim2.new(0, 2, 1, -14),
                        ZIndex = 314,
                    })
                    record.Icon = Library:Create('ImageLabel', {
                        Parent = row,
                        BackgroundTransparency = 1,
                        ScaleType = Enum.ScaleType.Fit,
                        Position = UDim2.fromOffset(9, 10),
                        Size = UDim2.fromOffset(70, 34),
                        ZIndex = 314,
                    })
                    record.NameLabel = label(row, '', 7, 18, 12)
                    record.NameLabel.Position, record.NameLabel.Size = UDim2.fromOffset(90, 7), UDim2.new(1, -98, 0, 18)
                    record.AmmoLabel = label(row, '', 29, 16, 11)
                    record.AmmoLabel.Position, record.AmmoLabel.Size, record.AmmoLabel.TextTransparency =
                        UDim2.fromOffset(90, 29), UDim2.new(1, -98, 0, 16), 0.35
                    self.LayoutDirty = true
                end
                if record.DisplayName ~= tool.Name or themeChanged then
                    record.DisplayName = tool.Name
                    record.Icon.Image = esp and esp.GetWeaponIconAsset and esp:GetWeaponIconAsset(tool.Name) or ''
                end
                local name = tool.Name .. (equipped and '  / held' or '')
                if record.NameLabel.Text ~= name then
                    record.NameLabel.Text = name
                end
                if record.AmmoLabel.Text ~= text then
                    record.AmmoLabel.Text = text
                end
                local size = UDim2.new(fraction, -98 * fraction, 0, 2)
                if record.Bar.Size ~= size then
                    record.Bar.Size = size
                end
                record.Bar.BackgroundColor3 = equipped and Library.AccentColor or Library.FontColor
                record.Bar.BackgroundTransparency = equipped and 0.1 or 0.65
                record.Edge.BackgroundColor3 = equipped and Library.AccentColor or Library.OutlineColor
            end
        end
        if not self.LayoutDirty then
            return
        end
        self.LayoutDirty = false
        local rows = {}
        for _, record in pairs(self.Records) do
            if record.Row then
                rows[#rows + 1] = record
            end
        end
        table.sort(rows, function(a, b)
            if a.Tool.Name ~= b.Tool.Name then
                return a.Tool.Name < b.Tool.Name
            end
            return a.Sequence < b.Sequence
        end)
        for index, record in ipairs(rows) do
            record.Row.Position = UDim2.fromOffset(0, (index - 1) * 60)
        end
        title.Text = 'weapon inventory  /  ' .. #rows .. ' weapons'
        if not self.Empty then
            self.Empty = label(inventory, 'No replicated weapons', 0, 24)
            self.Empty.TextTransparency = 0.4
        end
        self.Empty.Visible = #rows == 0
        local height = math.max(38, #rows * 60)
        if state.InventoryHeight ~= height then
            state.InventoryHeight = height
            inventory.Size = UDim2.new(1, -28, 0, height)
            controls.Position = UDim2.fromOffset(0, 290 + height)
            body.CanvasSize = UDim2.fromOffset(0, 538 + height)
        end
    end
    function controller:Destroy()
        if self.Closed then
            return
        end
        self.Closed = true
        disconnect(self.ContainerConnections)
        for _, record in pairs(self.Records) do
            remove(record)
        end
        if self.Empty then
            Library:RemoveFromRegistry(self.Empty)
            self.Empty:Destroy()
        end
    end
    return controller
end

