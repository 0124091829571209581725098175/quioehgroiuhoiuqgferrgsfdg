        for _, player in ipairs(rows) do
            if query == '' or player.Name:lower():find(query, 1, true) or player.DisplayName:lower():find(query, 1, true) then
                shown = shown + 1
                local row = self:Create('Frame', {Name = 'Player_' .. player.UserId, Parent = playerList, Size = UDim2.new(1, -6, 0, 52), BackgroundColor3 = self.MainColor, BorderColor3 = self.OutlineColor, BorderSizePixel = 0, ZIndex = 6})
