Library.ControlRegistry = {}
function Library:RegisterControl(index, control, owner, label, row)
    local group = owner and (owner.ControlGroup or owner)
    control.ControlGroup = group
    local tab = group and group.RootTab
    local category = tab and tostring(tab.Name):lower() or 'other'
    if category == 'character' then category = 'movement'
    elseif category == 'world' then category = 'visuals'
    elseif category == 'ui settings' then category = 'interface'
    elseif category ~= 'visuals' and category ~= 'protection' then category = 'other' end
    local workspaceRow = self.FormatWorkspaceControl and self:FormatWorkspaceControl(control, owner, label, row)
    row = workspaceRow or row
    self.ControlRegistry[index] = {Index = index, Control = control, Label = tostring(label or index):lower(), Group = group, Tab = tab, Category = category, Row = row or control.TextLabel or control.Label or control.Container, Settings = self:GetSettingsBox(owner and owner.Container)}
    control.ControlIndex = index;
    if self.SaveManager and self.SaveManager.ObserveControl then self.SaveManager:ObserveControl(index, control) end;
end
function Library:JumpToControl(index)
    local entry = self.ControlRegistry[index]
    if not entry then return false end
    if entry.Tab and entry.Tab.ShowTab then entry.Tab:ShowTab() end
    if entry.ItemPage and self.WorkspaceWindow.SelectItemWorkspace then self.WorkspaceWindow:SelectItemWorkspace(entry.ItemPage) end
    if entry.Group and entry.Group.Show then entry.Group:Show() end
    local chain, settings = {}, entry.Settings
    while settings do chain[#chain + 1] = settings; settings = settings.ParentSettings end
    for i = #chain, 1, -1 do chain[i]:Open() end
    local row = entry.Row
    if typeof(row) ~= 'Instance' or not row.Parent then return false end
    local ancestor, hidden = row.Parent, nil
    while ancestor do
        if self.DependencyHolders[ancestor] and not ancestor.Visible then hidden = self.DependencyHolders[ancestor] end
        ancestor = ancestor.Parent
    end
    if hidden then
        for _, dependency in ipairs(hidden.Dependencies) do
            local control, value = dependency[1], dependency[2]
            if control.Type == 'Toggle' and control.Value ~= value and control.TextLabel then
                row = control.TextLabel
                self:Notify('This setting is hidden by "' .. row.Text .. '".', 3)
                break
            end
        end
    end
    local parent = row.Parent
    while parent do
        if parent:IsA('ScrollingFrame') then
            parent.CanvasPosition = Vector2.new(parent.CanvasPosition.X, math.max(0, parent.CanvasPosition.Y + (row.AbsolutePosition.Y - parent.AbsolutePosition.Y) / math.max(self.UIScale or 1, 0.01) - 20))
            break
        end
        parent = parent.Parent
    end
    local highlight = self:Create('Frame', {Name = 'SearchHighlight', Parent = row, Size = UDim2.fromScale(1, 1), BackgroundColor3 = self.AccentColor, BackgroundTransparency = 0.8, BorderSizePixel = 0, ZIndex = 20, Active = false})
    task.delay(0.5, function()
        if not highlight.Parent then return end
        self:AnimateControl(highlight, {BackgroundTransparency = 1})
        task.delay(0.2, function() if highlight.Parent then highlight:Destroy() end end)
    end)
    return true
end
