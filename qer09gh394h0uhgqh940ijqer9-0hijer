function Library:RefreshNotifications()
    if self.Unloaded or self.NotificationReflowing or not self.NotificationArea then return end;
    self.NotificationReflowing = true;
    local screen = ScreenGui.AbsoluteSize;
    if screen.X < 100 or screen.Y < 100 then screen = workspace.CurrentCamera and workspace.CurrentCamera.ViewportSize or Vector2.new(1280,720) end;
    local scale = math.max(self.UIScale or 1, 0.01);
    local position = self.NotificationPosition or 'Bottom';
    local top = position:find('Top',1,true) ~= nil;
    local margin = top and math.min(60,screen.Y*0.1) or math.min(200,screen.Y*0.25);
    local maxWidth = math.max(80, math.min(480, (screen.X-32)/scale));
    local maxHeight = math.max(40, (screen.Y-margin-16)/scale);
    local left, right = position:find('Left',1,true), position:find('Right',1,true);
    local area, layout = self.NotificationArea, self.NotificationLayout;
    area.AnchorPoint = Vector2.new(left and 0 or right and 1 or 0.5, top and 0 or 1);
    area.Position = UDim2.new(left and 0 or right and 1 or 0.5, left and 16 or right and -16 or 0, top and 0 or 1, top and margin or -margin);
    area.Size = UDim2.fromOffset(maxWidth, maxHeight);
    layout.HorizontalAlignment = left and Enum.HorizontalAlignment.Left or right and Enum.HorizontalAlignment.Right or Enum.HorizontalAlignment.Center;
    layout.VerticalAlignment = top and Enum.VerticalAlignment.Top or Enum.VerticalAlignment.Bottom;
    layout.Padding = UDim.new(0,8);
    local entries = {};
    for entry in pairs(self.NotificationEntries) do
        if entry.Closed or not entry.Frame.Parent then self.NotificationEntries[entry] = nil;
        else entries[#entries+1] = entry end;
    end;
    table.sort(entries,function(a,b)return a.Order>b.Order end);
    local transient = 0;
    for _, entry in ipairs(entries) do
        if not entry.Persistent then
            transient += 1;
            if transient > 32 then entry:Destroy() end;
        end;
    end;
    local used, visible = 0, 0;
    for _, entry in ipairs(entries) do
        if not entry.Closed then
            local hasProgress = type(entry.Fraction)=='number';
            if entry.Dirty or entry.LayoutWidth~=maxWidth or entry.LayoutHeight~=maxHeight or entry.MeasuredFont~=entry.Label.Font or entry.MeasuredSize~=entry.Label.TextSize then
                local extra = entry.CanDismiss and 24 or 0;
                local natural = self:GetTextBounds(entry.Plain, entry.Label.Font, entry.Label.TextSize);
                local width = math.clamp(math.ceil(natural)+24+extra, math.min(220,maxWidth), maxWidth);
                local footer = (hasProgress and 10 or 0) + (entry.Actions and 36 or 0);
                local _, measured = self:GetTextBounds(entry.Plain, entry.Label.Font, entry.Label.TextSize, Vector2.new(math.max(20,width-24-extra),100000));
                local body = math.clamp(math.ceil(measured)+2, 20, math.max(20,maxHeight-footer-16));
                local height = body+16+footer;
                entry.Frame.Size = UDim2.fromOffset(width,height);
                entry.Label.Position, entry.Label.Size = UDim2.fromOffset(12,8), UDim2.new(1,-24-extra,0,body);
                if entry.Track then
                    entry.Track.Visible = hasProgress;
                    entry.Track.Position = UDim2.fromOffset(12,body+14);
                end;
                if entry.Actions then entry.Actions.Position = UDim2.fromOffset(12,body+16+(hasProgress and 10 or 0)) end;
                entry.Height,entry.LayoutWidth,entry.LayoutHeight,entry.MeasuredFont,entry.MeasuredSize,entry.Dirty=height,maxWidth,maxHeight,entry.Label.Font,entry.Label.TextSize,false;
            end;
            if hasProgress then entry.Fill.Size = UDim2.fromScale(entry.Fraction,1) end;
            local gap = visible>0 and 8 or 0;
            local show = visible<6 and used+gap+entry.Height<=maxHeight;
            entry.Frame.Visible = show;
            if show then used += entry.Height+gap; visible += 1 end;
        end;
    end;
    self.NotificationReflowing = false;
end;
function Library:BuildNotification(Text, Style, CanDismiss, WithActions)
