    Library:UpdateGroupChromaDisplay(groupbox, enabled)
end
function Library:RefreshGroupChroma(groupbox)
    local enabled = groupbox.ColorPickers and #groupbox.ColorPickers > 0 or false
    for _, picker in ipairs(groupbox.ColorPickers or {}) do
        if not picker.RgbEnabled then enabled = false; break end
    end
    Library:UpdateGroupChromaDisplay(groupbox, enabled)
end
function Library:UpdateGroupChromaDisplay(groupbox, enabled)
    if groupbox.ChromaBtn then
        groupbox.ChromaOn = enabled
        local inner = groupbox.ChromaBtnInner
        local label = groupbox.ChromaBtnLabel
        if enabled then
