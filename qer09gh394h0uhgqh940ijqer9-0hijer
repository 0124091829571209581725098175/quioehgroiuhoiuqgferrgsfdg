        function Dropdown:BuildList()
            Dropdown.ListDirty = false
            local previous = RowByValue
            RowTables, RowByValue = {}, {}
            Dropdown.Filtered = {}

            local Query = SearchBox.Text:lower()
            local Count = 0

            for _, Value in next, Dropdown.Values do
                if Query == '' or tostring(Value):lower():find(Query, 1, true) then
