local function NotificationText(Text, Style)
    local Plain = Library:NotificationMessage(Text);
    if Style == 'Simple' or Style == 'Gamesensical' then
        local index, hex = 0, NotifyAccentHex();
        local rich = Plain:gsub('%S+',function(word)
            index += 1;
            local safe = word:gsub('&','&amp;'):gsub('<','&lt;'):gsub('>','&gt;');
            local colored = Style == 'Simple' and index % 2 == 0 or Style == 'Gamesensical' and (index == 2 or index == 5 or index == 7);
            return colored and ('<font color="#' .. hex .. '">' .. safe .. '</font>') or safe;
        end);
        return rich, Plain;
    end;
    local Safe = Plain:gsub('&', '&amp;'):gsub('<', '&lt;'):gsub('>', '&gt;');
    local Prefix, Body = Safe:match('^(%[[^%]]+%])%s*(.*)$');
    Prefix, Body = Prefix or '', Body or Safe;
    Body = Body:gsub('UNSYNCED', '<font color="#C86173">UNSYNCED</font>');
    Body = Body:gsub('(landed on )(.+)( for [%d%.]+ damage)', '%1<font color="#83BD80">%2</font>%3');
    Body = Body:gsub('^(hit )(.+)( for [%d%.]+ damage)', '%1<font color="#83BD80">%2</font>%3');
    return '<font color="#8C8C94">' .. Prefix .. '</font> ' .. Body, Plain;
