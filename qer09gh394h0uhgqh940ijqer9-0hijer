        entry.Accent = self:Create('Frame',{Parent=outer; Position=UDim2.fromOffset(1,1); Size=UDim2.new(1,-2,0,2); BorderSizePixel=0; BackgroundColor3=self.AccentColor; ZIndex=101;});
