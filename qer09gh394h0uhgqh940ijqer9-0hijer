function Library:MakeDraggable(GuiObject, Cutoff)
    GuiObject.Active = true;

    GuiObject.InputBegan:Connect(function(Input)
        if Library:IsClickInput(Input) and not Library:MouseIsOverOpenedFrame() and not InputService:GetFocusedTextBox() then
            local StartPos = Input.Position;
            local ObjPos = Vector2.new(
                StartPos.X - GuiObject.AbsolutePosition.X,
                StartPos.Y - GuiObject.AbsolutePosition.Y
            );

            if ObjPos.Y > (Cutoff or 40) then
                return;
            end;

            local GetTouch, StopTouch = Library:TrackTouch(Input);
            local StartPointerX = GetTouch() and StartPos.X or Mouse.X;
            local StartPointerY = GetTouch() and StartPos.Y or Mouse.Y;
            local function Held()
                return InputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) or GetTouch() ~= nil;
            end;
            while Held() and not Library.Unloaded and Library:IsClickInput(Input) do
                local Active = GetTouch();
                local PX, PY = Active and Active.Position.X or Mouse.X, Active and Active.Position.Y or Mouse.Y;
                if math.abs(PX - StartPointerX) + math.abs(PY - StartPointerY) > 4 then break end;
                RenderStepped:Wait();
            end;
            if not Held() or Library.Unloaded or not Library:IsClickInput(Input) or InputService:GetFocusedTextBox() then StopTouch(); return end;

            local dragScale = math.max(Library.UIScale or 1,0.01);
            local dragSize = GuiObject.AbsoluteSize / dragScale;
            local Ghost = Library:Create('Frame', {
                BackgroundTransparency = 1;
                BorderSizePixel = 0;
                Size = UDim2.fromOffset(dragSize.X,dragSize.Y);
                Position = GuiObject.Position;
                AnchorPoint = GuiObject.AnchorPoint;
                ZIndex = 1000;
                Parent = ScreenGui;
            });

            local GhostBorder = Library:CreateNeonBorder(Ghost, 1001);

            Library:Create('UIScale', {
                Scale = Library.UIScale or 1;
                Parent = Ghost;
            });

            GuiObject.Visible = false;

            local NewPos = GuiObject.Position;

            while Ghost.Parent and GuiObject.Parent and not Library.Unloaded and (InputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) or GetTouch() ~= nil) do
                local Active = GetTouch();
                local PX = Active and Active.Position.X or Mouse.X;
                local PY = Active and Active.Position.Y or Mouse.Y;

                NewPos = UDim2.new(
                    0,
                    PX - ObjPos.X + (dragSize.X * dragScale * GuiObject.AnchorPoint.X),
                    0,
                    PY - ObjPos.Y + (dragSize.Y * dragScale * GuiObject.AnchorPoint.Y)
                );

                Ghost.Position = NewPos;

                RenderStepped:Wait();
            end;

            StopTouch();
            if GuiObject.Parent and not Library.Unloaded then GuiObject.Position = NewPos end;
            Library:DestroyNeonBorder(GhostBorder);
            Ghost:Destroy();
            if GuiObject.Parent and not Library.Unloaded then GuiObject.Visible = true end;
        end;
    end)
end;

