Library.GameNameLabels = setmetatable({}, {__mode='k'});
local function GameNameIdentity()
    return tostring(game.GameId or 0) .. ':' .. tostring(game.PlaceId or 0);
end;
local function CleanGameName(Name)
    if type(Name)~='string' then return end;
    Name=Name:gsub('%c',' '):match('^%s*(.-)%s*$');
    local lower=Name:lower();
    if Name=='' or lower=='ugc' or lower=='game' or lower=='datamodel' or lower=='roblox' or lower=='loading game...' then return end;
    return Name;
end;
function Library:UpdateGameNameLabels(Name)
    for label,prefix in pairs(self.GameNameLabels) do
        if label.Parent then label.Text=prefix..Name else self.GameNameLabels[label]=nil end;
    end;
end;
function Library:GetGameName()
    local key=GameNameIdentity();
    local state=self.GameNameState;
    if not state or state.Key~=key then
        local name;
        if self.GameNameCacheKey==key or not self.GameNameCacheKey and not state then name=CleanGameName(self.GameNameCache) end;
        state={Key=key,Name=name,Priority=0,Attempts=0,RetryAt=0,Loading=false,Complete=false};
        self.GameNameState=state;
        self.GameNameCache,self.GameNameCacheKey,self.GameNameSource=name,key,nil;
    end;
    local function fallback()
        if state.Name then return state.Name end;
        if (tonumber(game.PlaceId) or 0)<=0 then return 'Roblox Studio' end;
        return (state.Attempts==0 or state.Loading and state.Attempts==1) and 'Loading game...' or ('Game #'..tostring(game.PlaceId));
    end;
    if self.Unloaded or state.Loading or state.Complete or state.Attempts>=3 or os.clock()<state.RetryAt then return fallback() end;
    local placeId,universeId=tonumber(game.PlaceId) or 0,tonumber(game.GameId) or 0;
    if placeId<=0 then state.Complete=true;return fallback() end;
    state.Loading=true;
    state.Attempts+=1;
    task.spawn(function()
        local function current()return not self.Unloaded and self.GameNameState==state and GameNameIdentity()==key end;
        local function publish(name,priority,source)
            name=CleanGameName(name);
            if not name or not current() or priority<state.Priority then return false end;
            state.Name,state.Priority=name,priority;
            self.GameNameCache,self.GameNameCacheKey,self.GameNameSource=name,key,source;
            self:UpdateGameNameLabels(name);
            return true;
        end;
        local function placeName(id)
            local market=game:GetService('MarketplaceService');
            for _,method in ipairs({'GetProductInfoAsync','GetProductInfo'}) do
                if not current() then return end;
                local ok,info=pcall(function()return market[method](market,id,Enum.InfoType.Asset)end);
                local name=ok and type(info)=='table' and CleanGameName(info.Name);
                if name then return name end;
            end;
        end;
        local ok,name=pcall(placeName,placeId);
        if ok then publish(name,1,'place') end;
        if universeId>0 and current() then
            local url='https://games.roblox.com/v1/games?universeIds='..string.format('%.0f',universeId);
            local fetched,body=pcall(function()return game:HttpGet(url)end);
            if not fetched or type(body)~='string' then
                local send=request or http_request or (syn and syn.request);
                if type(send)=='function' then
                    local sent,response=pcall(send,{Url=url,Method='GET'});
                    local status=sent and type(response)=='table' and tonumber(response.StatusCode or response.Status);
                    if status and status>=200 and status<300 and type(response.Body)=='string' then body=response.Body;fetched=true end;
                end;
            end;
            if fetched and type(body)=='string' and current() then
                local decoded,data=pcall(function()return game:GetService('HttpService'):JSONDecode(body)end);
                if decoded and type(data)=='table' and type(data.data)=='table' then
                    for _,experience in ipairs(data.data) do
                        if type(experience)=='table' and tonumber(experience.id)==universeId then
                            if publish(experience.name,2,'experience') then state.Complete=true;
                            else
                                local rootId=tonumber(experience.rootPlaceId) or (type(experience.rootPlace)=='table' and tonumber(experience.rootPlace.id));
                                if rootId and rootId>0 and rootId~=placeId then
                                    local rootOk,rootName=pcall(placeName,rootId);
                                    if rootOk and publish(rootName,2,'root place') then state.Complete=true end;
                                end;
                            end;
                            break;
                        end;
                    end;
                end;
            end;
        elseif state.Name then state.Complete=true end;
        if not current() then return end;
        state.Loading=false;
        state.RetryAt=os.clock()+(state.Attempts==1 and 5 or 20);
        self:UpdateGameNameLabels(fallback());
    end);
    return fallback();
