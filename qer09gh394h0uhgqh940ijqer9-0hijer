function Library:QueueKeybindLayout()
    if Library.KeybindLayoutPending or Library.Unloaded then return end;
    Library.KeybindLayoutPending = true;
    task.defer(function()
        Library.KeybindLayoutPending = false;
        if Library.Unloaded or not Library.KeybindFrame or not Library.KeybindFrame.Parent then return end;
        local Height, Width = 0, 0;
        for _, Row in ipairs(Library.KeybindContainer:GetChildren()) do
            if Row:IsA('Frame') and Row.Visible then
                Height = Height + 18;
                local RowWidth = 0;
                for _, Label in ipairs(Row:GetChildren()) do
                    if Label:IsA('TextLabel') then
                        RowWidth = RowWidth + Label.TextBounds.X;
                        if Label.Name == 'State' then
                            local StateWidth = math.ceil(Label.TextBounds.X) + 5;
                            Label.Position = UDim2.new(1, -StateWidth - 5, 0, 0);
                            Label.Size = UDim2.new(0, StateWidth, 1, 0);
                            local NameLabel = Row:FindFirstChild('Name');
                            if NameLabel then NameLabel.Size = UDim2.new(1, -StateWidth - 15, 1, 0) end;
                        end;
                    end;
                end;
                Width = math.max(Width, RowWidth);
            end;
        end;
        Library.KeybindFrame.Size = UDim2.new(0, math.max(Width + 20, 210), 0, Height + 22);
        Library:RefreshKeybindVisibility();
    end);
end;

