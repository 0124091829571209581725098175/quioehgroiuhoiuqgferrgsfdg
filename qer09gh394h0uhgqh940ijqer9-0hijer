function Library:ClosePopups(except)
    for frame in pairs(table.clone(self.OpenedFrames)) do
        if not self:IsPopupAncestor(frame, except) then
            local closer = self.PopupClosers and self.PopupClosers[frame]
            if closer then closer() elseif frame.Parent then frame.Visible = false end
            self.OpenedFrames[frame] = nil
        end
    end
end
table.insert(Library.Signals, InputService.InputBegan:Connect(function(input)
    if input.KeyCode == Enum.KeyCode.Escape then Library:ClosePopups(); return end
    if not Library:IsClickInput(input, true) or not next(Library.OpenedFrames) then return end
    local point = input.Position
    for frame in pairs(Library.OpenedFrames) do
        local position, size = frame.AbsolutePosition, frame.AbsoluteSize
        if point.X >= position.X and point.X <= position.X + size.X and point.Y >= position.Y and point.Y <= position.Y + size.Y then return end
        local box = Library.SettingsBoxes[frame]
        if box then
            position, size = box.Button.AbsolutePosition, box.Button.AbsoluteSize
            if point.X >= position.X and point.X <= position.X + size.X and point.Y >= position.Y and point.Y <= position.Y + size.Y then return end
        elseif Library.PopupAnchors[frame] then
            position, size = Library.PopupAnchors[frame].AbsolutePosition, Library.PopupAnchors[frame].AbsoluteSize
            if point.X >= position.X and point.X <= position.X + size.X and point.Y >= position.Y and point.Y <= position.Y + size.Y then return end
        end
    end
    Library:ClosePopups()
end))
Library.ControlRegistry = {}
function Library:RegisterControl(index, control, owner, label, row)
    local group = owner and (owner.ControlGroup or owner)
    control.ControlGroup = group
    local tab = group and group.RootTab
    local category = tab and tostring(tab.Name):lower() or 'other'
    if category == 'character' then category = 'movement'
    elseif category == 'world' then category = 'visuals'
    elseif category == 'ui settings' then category = 'interface'
    elseif category ~= 'visuals' and category ~= 'protection' then category = 'other' end
    local workspaceRow = self.FormatWorkspaceControl and self:FormatWorkspaceControl(control, owner, label, row)
    row = workspaceRow or row
    self.ControlRegistry[index] = {Index = index, Control = control, Label = tostring(label or index):lower(), Group = group, Tab = tab, Category = category, Row = row or control.TextLabel or control.Label or control.Container, Settings = self:GetSettingsBox(owner and owner.Container)}
end
function Library:JumpToControl(index)
    local entry = self.ControlRegistry[index]
    if not entry then return false end
    if entry.Tab and entry.Tab.ShowTab then entry.Tab:ShowTab() end
    if entry.Group and entry.Group.Show then entry.Group:Show() end
    local chain, settings = {}, entry.Settings
    while settings do chain[#chain + 1] = settings; settings = settings.ParentSettings end
    for i = #chain, 1, -1 do chain[i]:Open() end
    local row = entry.Row
    if typeof(row) ~= 'Instance' or not row.Parent then return false end
    local parent = row.Parent
    while parent do
        if parent:IsA('ScrollingFrame') then
            parent.CanvasPosition = Vector2.new(parent.CanvasPosition.X, math.max(0, parent.CanvasPosition.Y + row.AbsolutePosition.Y - parent.AbsolutePosition.Y - 20))
            break
        end
        parent = parent.Parent
    end
    return true
end
