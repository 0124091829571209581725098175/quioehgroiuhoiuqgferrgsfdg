            Num = math.clamp(tonumber(string.format('%.' .. math.clamp(Slider.Rounding or 0, 0, 10) .. 'f', Num)) or Num, Slider.Min, Slider.Max);

            Slider.Value = Num;
            Slider:Display();

            Library:SafeCallback(Slider.Callback, Slider.Value);
            Library:SafeCallback(Slider.Changed, Slider.Value);
