    local searchRevision = 0
    local function updateSearch()
        for _, child in ipairs(results:GetChildren()) do
            if child:IsA('GuiObject') then
                child:Destroy()
            end
        end
        local query = search.Text:lower():match('^%s*(.-)%s*$')
        if query == '' or not Library.MainVisible then
            results.Visible = false
            return
        end
        local matches = {}
        for index, entry in pairs(Library.ControlRegistry) do
            local text = tostring(entry.Tab and entry.Tab.Name or '')
                .. ' / '
                .. tostring(entry.Group and entry.Group.Name or '')
                .. ' / '
                .. entry.Label
            if
                entry.Searchable ~= false
                and (text:lower():find(query, 1, true) or tostring(index):lower():find(query, 1, true))
            then
                matches[#matches + 1] = {
                    Index = index,
                    Text = text,
                    Label = entry.Label,
                    Path = tostring(entry.Tab and entry.Tab.Name or 'other') .. ' / ' .. tostring(
                        entry.Group and entry.Group.Name or 'settings'
                    ),
                }
            end
        end
        table.sort(matches, function(a, b)
            return a.Text == b.Text and tostring(a.Index) < tostring(b.Index) or a.Text < b.Text
        end)
        for i = 1, math.min(#matches, 14) do
            local entry = matches[i]
            local hit = button(results, '', UDim2.new(1, -6, 0, 42), function()
                search.Text = ''
                search:ReleaseFocus()
                results.Visible = false
                Library:JumpToControl(entry.Index)
            end)
            hit.Name, hit.ZIndex, hit.LayoutOrder, hit.TextXAlignment, hit.TextTruncate =
                tostring(entry.Index), 301, i, Enum.TextXAlignment.Left, Enum.TextTruncate.AtEnd
            local settingName = label(hit, entry.Label, UDim2.fromOffset(10, 3), UDim2.new(1, -20, 0, 20), 14)
            settingName.Name, settingName.ZIndex, settingName.TextTransparency = 'SettingName', 302, 0
            local path = label(hit, entry.Path, UDim2.fromOffset(10, 24), UDim2.new(1, -20, 0, 15), 11)
            path.Name, path.ZIndex, path.TextTransparency = 'SettingPath', 302, 0.25
            Library:OnHighlight(hit, hit, { BackgroundColor3 = 'BackgroundColor' }, { BackgroundColor3 = 'MainColor' })
            frame('UIPadding', { Parent = hit, PaddingLeft = UDim.new(0, 10), PaddingRight = UDim.new(0, 10) })
            Library:AddToolTip(entry.Text, hit)
        end
        if #matches == 0 then
            local empty = label(results, 'No matching settings', UDim2.fromOffset(10, 0), UDim2.new(1, -20, 0, 36), 13)
            empty.ZIndex = 302
        end
        results.CanvasSize = UDim2.fromOffset(0, math.max(36, math.min(#matches, 14) * 44))
        Library:ClosePopups(results)
        results.Visible = true
        positionResults()
    end
