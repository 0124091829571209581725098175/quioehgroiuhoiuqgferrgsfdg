function Library:NotifySimple(Text, Time)
    local Words = SplitNotifyWords(Text);
    local Hex = NotifyAccentHex();
    local Rich = '';

    for i, Word in next, Words do
        if i % 2 == 0 then
            Rich = Rich .. '<font color="#' .. Hex .. '">' .. Word .. '</font>';
        else
            Rich = Rich .. Word;
        end;

        if i < #Words then
            Rich = Rich .. ' ';
        end;
    end;

    local XSize, YSize = Library:GetTextBounds(Text, Library.Font, 13);

    local Label = Library:CreateLabel({
        Size = UDim2.new(0, XSize + 8, 0, YSize + 4);
        TextSize = 13;
        Text = Rich;
        TextXAlignment = Enum.TextXAlignment.Center;
        ZIndex = 100;
        Parent = Library.NotificationArea;
    });

    Label.RichText = true;
    Label.TextTransparency = 1;

