    local function SetToolbarActive(Name)
        for Key, Btn in next, ToolbarButtons do
            local Data = Library.RegistryMap[Btn.Inner];

            if Key == Name then
                Btn.Inner.BorderColor3 = Library.AccentColor;

                if Data then
                    Data.Properties.BorderColor3 = 'AccentColor';
