            end
            clear(serverList)
            sortMode.Text = 'sort: ' .. self.ServerSortMode
            sortDirection.Text = self.ServerSortDesc and 'Descending' or 'Ascending'
            local rows = table.clone(state.Rows)
            table.sort(rows, function(a, b)
                if self.ServerSortMode == 'Ping' and (a.ping == nil) ~= (b.ping == nil) then
                    return a.ping ~= nil
                end
                local av = self.ServerSortMode == 'Ping' and (a.ping or math.huge) or a.playing
                local bv = self.ServerSortMode == 'Ping' and (b.ping or math.huge) or b.playing
                if av == bv then
                    return a.id < b.id
                end
                return self.ServerSortDesc and av > bv or not self.ServerSortDesc and av < bv
            end)
            for _, server in ipairs(rows) do
                local row = self:Create('Frame', {
