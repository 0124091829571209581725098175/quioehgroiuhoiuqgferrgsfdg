function Library:Create(Class, Properties)
    local _Instance = Class;

    if type(Class) == 'string' then
        _Instance = Instance.new(Class);
    end;

    local layer = Properties.SettingsLayer or self:GetSettingsLayer(Properties.Parent)
    if Properties.PopupAnchor then
        local anchorLayer = self:GetSettingsLayer(Properties.PopupAnchor)
        if anchorLayer > 0 then layer = anchorLayer + 50 end
        self.PopupAnchors[_Instance] = Properties.PopupAnchor
    end
    if layer > 0 then self.SettingsLayers[_Instance] = layer end
    for Property, Value in next, Properties do
        if Property == 'SettingsLayer' or Property == 'PopupAnchor' then
        elseif Property == 'ZIndex' and layer > 0 then
            _Instance.ZIndex = Value >= layer and Value or Value + layer
        else
        if Property == 'CornerRadius' and Value.Scale == 0 then Value = UDim.new(0, math.min(Library.ClassicEnabled and 8 or 14, Value.Offset)) end;
        _Instance[Property] = Value;
        end
    end;
    if layer > 0 and not Properties.ZIndex and _Instance:IsA('GuiObject') then _Instance.ZIndex = layer + 1 end

    if _Instance:IsA('TextLabel') or _Instance:IsA('TextButton') or _Instance:IsA('TextBox') then
        _Instance.TextSize=math.max(10,_Instance.TextSize <= 16 and math.min(12,_Instance.TextSize) or _Instance.TextSize)
        if Library.UIFontName=='JetBrains Mono Nerd' then
            _Instance.Font=Enum.Font.RobotoMono
            if Library.NerdFontFace then pcall(function()_Instance.FontFace=Library.NerdFontFace end) end
        else
            _Instance.Font=Library.Font
        end
    end
    return _Instance;
end;

