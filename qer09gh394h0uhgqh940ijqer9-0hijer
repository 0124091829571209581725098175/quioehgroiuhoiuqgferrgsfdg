function Library:SetUIFont(Name)
    local Ok, Font = pcall(function()
        return Enum.Font[Name];
    end);

    if not Ok or not Font then
        return;
    end;

    Library.Font = Font;
    Library.UIFontName = Name;

    for _, Desc in next, ScreenGui:GetDescendants() do
        if Desc:IsA('TextLabel') or Desc:IsA('TextButton') or Desc:IsA('TextBox') then
            Desc.Font = Font;
        end;
    end;
end;

function Library:SetUIScale(Scale)
    Library.UIScale = Scale;

    for _, S in next, Library.ScaleObjects do
        S.Scale = Scale;
    end;
end;

function Library:ApplyScaleTo(Gui)
    local S = Library:Create('UIScale', {
        Scale = Library.UIScale or 1;
        Parent = Gui;
    });

    table.insert(Library.ScaleObjects, S);

    return S;
end;

