                        local ButtonLabel = Library:CreateLabel({
                            Active = false,
                            Size = UDim2.new(1, -6, 1, 0),
                            Position = UDim2.new(0, 6, 0, 0),
                            TextSize = 14,
                            Text = Info.SpecialType == 'Player' and Value or tostring(Value):lower(),
                            TextXAlignment = Enum.TextXAlignment.Left,
                            ZIndex = 8,
                            Parent = Button,
                        })

                        Library:OnHighlight(
                            Button,
                            Button,
                            { BorderColor3 = 'AccentColor', ZIndex = 8 },
                            { BorderColor3 = 'OutlineColor', ZIndex = 7 }
                        )
                        if not Library.ClassicEnabled then
                            Library:StyleControl(Button, Button, 3)
                        else
                            Button.BorderSizePixel = 0
                        end
                        local SelectionMarker = Library:CreateSelectionMarker(Button)

                        local UpdateChoice = Library:BindChoiceStyle(Button, ButtonLabel, SelectionMarker, function()
                            return Selected
                        end, false)
                        function Table:UpdateButton()
                            Selected = Info.Multi and Dropdown.Value[Value]
                                or not Info.Multi and Dropdown.Value == Value
                            UpdateChoice()

                            if Dropdown.Highlight == Value and not Selected then
                                Button.BorderColor3 = Library.AccentColor
                                Library.RegistryMap[Button].Properties.BorderColor3 = 'AccentColor'
                            elseif not Selected then
                                Button.BorderColor3 = Library.OutlineColor
                                Library.RegistryMap[Button].Properties.BorderColor3 = 'OutlineColor'
                            end
                        end

                        function Table:Activate()
                            local Try = not Selected

                            if Dropdown:GetActiveValues() == 1 and not Try and not Info.AllowNull then
                                return
                            end

                            if Info.Multi then
                                Selected = Try

                                if Selected then
                                    Dropdown.Value[Value] = true
                                else
                                    Dropdown.Value[Value] = nil
                                end
                            else
                                Selected = Try

                                if Selected then
                                    Dropdown.Value = Value
                                else
                                    Dropdown.Value = nil
                                end
                            end

                            Table:UpdateButton()
                            Dropdown:Display()

                            Library:SafeCallback(Dropdown.Callback, Dropdown.Value)
                            Library:SafeCallback(Dropdown.Changed, Dropdown.Value)

                            Library:AttemptSave(Idx, Dropdown)
                        end

                        Button.Activated:Connect(function()
                            Table:Activate()
                        end)

                        Table:UpdateButton()

                        Table.Button = Button
                        Button.LayoutOrder = Count
                        RowTables[Button] = Table
                        RowByValue[Value] = Table
                    end
                end
