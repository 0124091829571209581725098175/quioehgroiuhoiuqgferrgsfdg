function Library:MakeDraggable(GuiObject, Cutoff)
    GuiObject.Active = true

    GuiObject.InputBegan:Connect(function(Input)
        if
            Library:IsClickInput(Input)
            and not Library:MouseIsOverOpenedFrame()
            and not InputService:GetFocusedTextBox()
        then
            local StartPos = Input.Position
            local ObjPos =
                Vector2.new(StartPos.X - GuiObject.AbsolutePosition.X, StartPos.Y - GuiObject.AbsolutePosition.Y)

            if ObjPos.Y > (Cutoff or 40) then
                return
            end

            local GetTouch, StopTouch = Library:TrackTouch(Input)
            local StartPointerX = GetTouch() and StartPos.X or Mouse.X
            local StartPointerY = GetTouch() and StartPos.Y or Mouse.Y
            local function Held()
                return InputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) or GetTouch() ~= nil
            end
            while Held() and not Library.Unloaded and Library:IsClickInput(Input) do
                local Active = GetTouch()
                local PX, PY = Active and Active.Position.X or Mouse.X, Active and Active.Position.Y or Mouse.Y
                if math.abs(PX - StartPointerX) + math.abs(PY - StartPointerY) > 4 then
                    break
                end
                RenderStepped:Wait()
            end
            if
                not Held()
                or Library.Unloaded
                or not Library:IsClickInput(Input)
                or InputService:GetFocusedTextBox()
            then
                StopTouch()
                return
            end

            local dragScale = math.max(Library.UIScale or 1, 0.01)
            local dragSize = GuiObject.AbsoluteSize / dragScale
            local Ghost = Library:Create('Frame', {
                BackgroundTransparency = 1,
                BorderSizePixel = 0,
                Size = UDim2.fromOffset(dragSize.X, dragSize.Y),
                Position = GuiObject.Position,
                AnchorPoint = GuiObject.AnchorPoint,
                ZIndex = 1000,
                Parent = ScreenGui,
            })

            local GhostBorder = Library:CreateNeonBorder(Ghost, 1001)

            Library:Create('UIScale', {
                Scale = Library.UIScale or 1,
                Parent = Ghost,
            })

            GuiObject.Visible = false

            local NewPos = GuiObject.Position

            while
                Ghost.Parent
                and GuiObject.Parent
                and not Library.Unloaded
                and (InputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) or GetTouch() ~= nil)
            do
                local Active = GetTouch()
                local PX = Active and Active.Position.X or Mouse.X
                local PY = Active and Active.Position.Y or Mouse.Y

                NewPos = UDim2.new(
                    0,
                    PX - ObjPos.X + (dragSize.X * dragScale * GuiObject.AnchorPoint.X),
                    0,
                    PY - ObjPos.Y + (dragSize.Y * dragScale * GuiObject.AnchorPoint.Y)
                )

                Ghost.Position = NewPos

                RenderStepped:Wait()
            end

            StopTouch()
            if GuiObject.Parent and not Library.Unloaded then
                GuiObject.Position = NewPos
            end
            Library:DestroyNeonBorder(GhostBorder)
            Ghost:Destroy()
            if GuiObject.Parent and not Library.Unloaded then
                GuiObject.Visible = true
            end
        end
    end)
end

function Library:HideTooltip()
    if self.TooltipConnection then
        self.TooltipConnection:Disconnect()
        self.TooltipConnection = nil
    end
    self.TooltipOwner = nil
    if self.TooltipContainer then
        self.TooltipContainer.Visible = false
    end
end

function Library:ResolveControlTooltip(index, info, owner)
    if type(info.Tooltip) == 'string' then
        return info.Tooltip
    end
    local text = self.ControlTooltips and self.ControlTooltips[index]
    if text then
        return text
    end
    local name = tostring(index):lower()
    local group = owner and (owner.ControlGroup or owner)
    local context = group and tostring(group.Name):lower() or ''
    local label = tostring(info.Text or ''):lower()
    if name:find('predict', 1, true) or label:find('predict', 1, true) or context == 'resolver' then
        return 'Controls motion prediction for '
            .. tostring(info.Text or index)
            .. '. More lead aims further ahead; abrupt turns and replication gaps can reduce accuracy.'
    end
    if name:find('strafe', 1, true) or label:find('strafe', 1, true) or context == 'strafe' then
        return 'Controls '
            .. tostring(info.Text or index)
            .. ' for the active strafe. These settings move your character and can be visible to other players.'
    end
    if info.Risky or info.Dangerous then
        return 'Enables '
            .. tostring(info.Text or index)
            .. '. This action can interrupt your session; review its dependent settings before enabling it.'
    end
    return nil
end
function Library:SetTooltipsEnabled(enabled)
    self.TooltipsEnabled = enabled == true
    if not self.TooltipsEnabled then
        self:HideTooltip()
    end
end

function Library:AddToolTip(InfoStr, HoverInstance)
    Library:GiveSignal(HoverInstance.MouseEnter:Connect(function()
        if
            not Library.TooltipsEnabled
            or Library.Unloaded
            or not HoverInstance.Parent
            or Library:MouseIsOverOpenedFrame(HoverInstance)
        then
            return
        end
        Library:HideTooltip()
        if not Library.TooltipContainer then
            Library.TooltipContainer = Library:Create('Frame', {
                Name = 'LibraryTooltip',
                BackgroundColor3 = Library.MainColor,
                BorderColor3 = Library.OutlineColor,
                ZIndex = 100,
                Parent = Library.ScreenGui,
                Visible = false,
            })
            Library.TooltipLabel = Library:CreateLabel({
                Position = UDim2.fromOffset(3, 1),
                TextSize = 14,
                TextXAlignment = Enum.TextXAlignment.Left,
                ZIndex = 101,
                Parent = Library.TooltipContainer,
            })
            Library:AddToRegistry(
                Library.TooltipContainer,
                { BackgroundColor3 = 'MainColor', BorderColor3 = 'OutlineColor' }
            )
        end
        local X, Y = Library:GetTextBounds(InfoStr, Library.Font, 14)
        local Tooltip = Library.TooltipContainer
        Tooltip.Size = UDim2.fromOffset(X + 5, Y + 4)
        Library.TooltipLabel.Size, Library.TooltipLabel.Text = UDim2.fromOffset(X, Y), InfoStr
        Library.TooltipOwner = HoverInstance
        Tooltip.Position, Tooltip.Visible = UDim2.fromOffset(Mouse.X + 15, Mouse.Y + 12), true
        Library.TooltipConnection = RunService.Heartbeat:Connect(function()
            if
                not Library.TooltipsEnabled
                or Library.Unloaded
                or not HoverInstance.Parent
                or Library.MainVisible == false
                or (Library.IsControlVisible and not Library:IsControlVisible(HoverInstance))
            then
                Library:HideTooltip()
                return
            end
            Tooltip.Position = UDim2.fromOffset(Mouse.X + 15, Mouse.Y + 12)
        end)
    end))
    Library:GiveSignal(HoverInstance.MouseLeave:Connect(function()
        if Library.TooltipOwner == HoverInstance then
            Library:HideTooltip()
        end
    end))
end

function Library:OnHighlight(HighlightInstance, GuiObject, Properties, PropertiesDefault)
    HighlightInstance.MouseEnter:Connect(function()
        local Reg = Library.RegistryMap[GuiObject]

        for Property, ColorIdx in next, Properties do
            GuiObject[Property] = Library[ColorIdx] or ColorIdx

            if Reg and Reg.Properties[Property] then
                Reg.Properties[Property] = ColorIdx
            end
        end
    end)

    HighlightInstance.MouseLeave:Connect(function()
        local Reg = Library.RegistryMap[GuiObject]

        for Property, ColorIdx in next, PropertiesDefault do
            GuiObject[Property] = Library[ColorIdx] or ColorIdx

            if Reg and Reg.Properties[Property] then
                Reg.Properties[Property] = ColorIdx
            end
        end
    end)
end

function Library:MouseIsOverOpenedFrame(region)
    local box = region and self:GetSettingsBox(region)
    for frame in pairs(self.OpenedFrames) do
        if not self:IsPopupAncestor(frame, box) then
            local position, size = frame.AbsolutePosition, frame.AbsoluteSize
            if
                Mouse.X >= position.X
                and Mouse.X <= position.X + size.X
                and Mouse.Y >= position.Y
                and Mouse.Y <= position.Y + size.Y
            then
                return true
            end
        end
    end
    return false
end

function Library:IsMouseOverFrame(Frame)
    local AbsPos, AbsSize = Frame.AbsolutePosition, Frame.AbsoluteSize

    if
        Mouse.X >= AbsPos.X
        and Mouse.X <= AbsPos.X + AbsSize.X
        and Mouse.Y >= AbsPos.Y
        and Mouse.Y <= AbsPos.Y + AbsSize.Y
    then
        return true
    end
    return false
end

function Library:UpdateDependencyBoxes()
    for _, Depbox in next, Library.DependencyBoxes do
        Depbox:Update()
    end
end

function Library:MapValue(Value, MinA, MaxA, MinB, MaxB)
    return (1 - ((Value - MinA) / (MaxA - MinA))) * MinB + ((Value - MinA) / (MaxA - MinA)) * MaxB
end

Library.TextBoundsCache = {}
Library.TextBoundsCacheCount = 0
function Library:GetTextBounds(Text, textFont, Size, Resolution)
    Text, Resolution = tostring(Text), Resolution or Vector2.new(1920, 1080)
    local Key = tostring(textFont)
        .. '/'
        .. tostring(Size)
        .. '/'
        .. tostring(Resolution.X)
        .. '/'
        .. tostring(Resolution.Y)
        .. '/'
        .. Text
    local Cached = self.TextBoundsCache[Key]
    if Cached then
        return Cached.X, Cached.Y
    end
    local OK, Bounds = pcall(TextService.GetTextSize, TextService, Text, Size, textFont, Resolution)
    if not OK or typeof(Bounds) ~= 'Vector2' then
        local Width = math.min(#Text * Size * 0.55, math.max(Resolution.X, 1))
        return Width, math.max(Size + 2, math.ceil(#Text * Size * 0.55 / math.max(Resolution.X, 1)) * (Size + 2))
    end
    if self.TextBoundsCacheCount >= 2048 then
        table.clear(self.TextBoundsCache)
        self.TextBoundsCacheCount = 0
    end
    self.TextBoundsCache[Key] = Bounds
    self.TextBoundsCacheCount += 1
    return Bounds.X, Bounds.Y
end
function Library:DeferStartupLayout(Owner)
    if self.ConfigLoading and not Owner.LayoutFlushing then
        self.PendingLayouts = self.PendingLayouts or {}
        self.PendingLayouts[Owner] = true
        return true
    end
    if self.ControlsReady ~= false or Owner.LayoutFlushing then
        return false
    end
    if not Owner.LayoutPending then
        Owner.LayoutPending = true
        task.defer(function()
            Owner.LayoutPending = false
            if self.Unloaded then
                return
            end
            Owner.LayoutFlushing = true
            Owner:Resize()
            Owner.LayoutFlushing = false
        end)
    end
    return true
end

