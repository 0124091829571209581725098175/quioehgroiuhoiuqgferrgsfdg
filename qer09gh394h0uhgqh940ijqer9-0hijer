        local weapon, skin, names, token, metadata = selected()
        state.Token, state.Dirty = token, false
        title.Text = tostring(metadata and metadata.DisplayName or skin or 'Default') .. ' ' .. tostring(weapon or ''):gsub('[%[%]]', '')
        subtitle.Text = (metadata and metadata.Rarity and tostring(metadata.Rarity)..'  /  ' or '')..'Drag to rotate  /  scroll to zoom'
        local ok, reason = load(main, weapon, skin)
