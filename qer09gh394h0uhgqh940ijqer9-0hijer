                local avatar = self:Create('ImageLabel', {Parent = row, BackgroundTransparency = 1, Position = UDim2.fromOffset(5, 5), Size = UDim2.fromOffset(42, 42), ZIndex = 7})
                self:FetchThumbnail(player.UserId, avatar)
                local display = self:PlayerDisplayName(player)
